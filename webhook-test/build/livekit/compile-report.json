{
  "target": "livekit",
  "provider": "livekit",
  "version": "1.5.2",
  "entry_agent": "Assistant",
  "agents": [
    "assistant"
  ],
  "generated_files": [
    ".dockerignore",
    ".env.example",
    "Dockerfile",
    "README.md",
    "agent.py",
    "compile-report.json",
    "compose.dev.yaml",
    "livekit.toml",
    "pyproject.toml"
  ],
  "required_env": [
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "LIVEKIT_URL",
    "LOOKUP_PLACES_TOKEN",
    "LOOKUP_PLACES_URL",
    "OPENAI_API_KEY",
    "SLNG_API_KEY"
  ],
  "bindings": [
    {
      "target": "livekit",
      "role": "listen",
      "binding": {
        "provider": "slng",
        "model": "slng/deepgram/nova:3-en",
        "placement": "api"
      }
    },
    {
      "target": "livekit",
      "role": "turn",
      "binding": {
        "provider": "livekit",
        "model": "turn-detector-mini",
        "placement": "api"
      }
    },
    {
      "target": "livekit",
      "role": "speak",
      "profile": "assistant_voice",
      "binding": {
        "provider": "slng",
        "model": "slng/deepgram/aura:2-en",
        "voice": "aura-2-thalia-en",
        "placement": "api"
      }
    },
    {
      "target": "livekit",
      "role": "reason",
      "profile": "assistant_model",
      "binding": {
        "provider": "openai",
        "model": "gpt-4.1-mini",
        "placement": "api"
      }
    }
  ],
  "sizing": [
    {
      "target": "livekit",
      "metric": "workers",
      "value": "20",
      "status": "unbenchmarked",
      "basis": "2026-07-15 conservative 1 session per worker/GPU; channels=realtime_audio"
    },
    {
      "target": "livekit",
      "metric": "gpus",
      "value": "0",
      "status": "unbenchmarked",
      "basis": "2026-07-15 conservative 1 session per worker/GPU; channels=realtime_audio"
    },
    {
      "target": "livekit",
      "metric": "provider_concurrency_quota.realtime_audio",
      "value": "10",
      "status": "unbenchmarked",
      "basis": "2026-07-15 conservative 1 session per worker/GPU; channels=realtime_audio"
    },
    {
      "target": "livekit",
      "metric": "provider_session_time_quota.realtime_audio",
      "value": "50m0s",
      "status": "unbenchmarked",
      "basis": "2026-07-15 conservative 1 session per worker/GPU; channels=realtime_audio"
    }
  ],
  "notes": [
    "listen: slng via slng.STT (livekit-plugins-slng\u003e=1.6.1, verified 2026-07-15)",
    "reason: openai via openai.LLM (livekit-agents[openai], verified 2026-07-18)",
    "speak: slng via slng.TTS (livekit-plugins-slng\u003e=1.6.1, verified 2026-07-15)",
    "turn role lowers to LiveKit Inference turn detection; its binding placement is advisory"
  ]
}
