# Names to copy into an example's own `.env`.
#
# There is no package at this repository root, so nothing reads this file. It is
# a menu: pick the block for the example you are running, copy those lines into
# `examples/<name>/.env`, and fill in the values. Each example's own
# `build/<target>/.env.example` is the exact list for that example, written by
# `unmute compile`.

# Every example: the think model and the SLNG listen/speak models.
OPENAI_API_KEY=XXXX
SLNG_API_KEY=XXXX

# Tracing, needed by examples/salon-support and by nothing else. See the
# "Teaches" column in examples/README.md.
LANGFUSE_SECRET_KEY=XXXX
LANGFUSE_PUBLIC_KEY=XXXX
LANGFUSE_BASE_URL=XXXX

# Twilio credentials, for the telephony examples.
TWILIO_ACCOUNT_SID=XXXX
TWILIO_AUTH_TOKEN=XXXX
TWILIO_PHONE_NUMBER=+1XXXXXXX

# Firecrawl MCP server, used by examples/mcp-example. The URL is public and can
# be copied as it is; the key is yours, from firecrawl.dev.
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
FIRECRAWL_API_KEY=XXXX
