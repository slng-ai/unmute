import logging
import os
{{if .NeedsHTTPX}}import httpx
{{end}}from dotenv import load_dotenv
from livekit.agents import (
    NOT_GIVEN,
    Agent,
{{- if .NeedsTasks}}
    AgentTask,
{{- end}}
    AgentServer,
    AgentSession,
    JobContext,
    JobProcess,
    NotGivenOr,
    RunContext,
    TurnHandlingOptions,
    cli,
    function_tool,
    inference,
    llm,
    metrics,
)
{{- if .NeedsTasks}}
from livekit.agents.beta.workflows import TaskGroup
{{- end}}
from livekit.agents.voice import MetricsCollectedEvent
from livekit.plugins import silero, slng

logger = logging.getLogger({{pyq .Project}})
logger.setLevel(logging.INFO)

load_dotenv(".env.local")


# --- prompts ---------------------------------------------------------------
{{range .Prompts}}
{{.Const}} = {{triple .Body}}
{{end}}
# --- agents ----------------------------------------------------------------
{{range .Agents}}
class {{.Class}}(Agent):
    def __init__(self, chat_ctx: NotGivenOr[llm.ChatContext] = NOT_GIVEN) -> None:
        super().__init__(
            instructions={{.PromptConst}},
            chat_ctx=chat_ctx,
{{- if .LLM}}
            llm=inference.LLM(model={{pyq .LLM.Model}}{{if .LLM.Params}}, extra_kwargs={ {{- range $i, $p := .LLM.Params}}{{if $i}}, {{end}}{{pyq $p.Key}}: {{$p.Value}}{{end -}} }{{end}}),
{{- end}}
{{- if .TTS}}
            tts=slng.TTS(api_key=os.environ.get({{pyq .TTS.APIKeyEnv}}), model={{pyq .TTS.Model}}, voice={{pyq .TTS.Voice}}{{range .TTS.Params}}, {{.Key}}={{.Value}}{{end}}),
{{- end}}
        )

    async def on_enter(self) -> None:
{{- if .Greeting}}
{{- if .Greeting.Say}}
        await self.session.say({{pyq .Greeting.Say}})
{{- else if .Greeting.RunLLM}}
        self.session.generate_reply(instructions="Greet the caller and offer to help.")
{{- else}}
        pass  # the caller speaks first
{{- end}}
{{- else}}
        self.session.generate_reply(
            instructions="You are now handling this. Continue in one short line; do not greet again."
        )
{{- end}}
{{range .Transfers}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext):
        {{triple .When}}
        return {{.TargetClass}}(chat_ctx=self.chat_ctx.copy(exclude_instructions=True))
{{end}}
{{- range .Delegates}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext){{if eq .Then "return"}} -> dict{{end}}:
        {{triple .When}}
        group = TaskGroup(
            chat_ctx=self.chat_ctx.copy(exclude_instructions=True),
            summarize_chat_ctx=False,
        )
{{- range .Steps}}
        group.add(
            lambda: {{.Class}}(chat_ctx=self.chat_ctx.copy(exclude_instructions=True)),
            id={{pyq .ID}},
            description={{pyq .Desc}},
        )
{{- end}}
{{- if eq .Then "return"}}
        owner_ctx = self.chat_ctx.copy()
        result = await group
        # N13: the flow's own turns must not land in the owner's context. The
        # TaskGroup merges them back on completion, so restore the pre-flow
        # context and hand the owner only the typed results (merge: results).
        await self.update_chat_ctx(owner_ctx)
        return result.task_results
{{- else if eq .Then "transfer"}}
        owner_ctx = self.chat_ctx.copy(exclude_instructions=True)
        await group
        # then: transfer — control moves on and does not return here. N13: drop
        # the flow's turns by handing the target the pre-flow context.
        return {{.ThenClass}}(chat_ctx=owner_ctx)
{{- else}}
        await group
        # then: end — the flow is the last thing on the call; this does not return.
        self.session.shutdown()
{{- end}}
{{end}}
{{end}}
{{- if .NeedsTasks}}
# --- tasks -----------------------------------------------------------------
{{range .Tasks}}
class {{.Class}}(AgentTask[dict]):
    def __init__(self, chat_ctx: NotGivenOr[llm.ChatContext] = NOT_GIVEN) -> None:
        super().__init__(instructions={{.PromptConst}}, chat_ctx=chat_ctx)

    async def on_enter(self) -> None:
        self.session.generate_reply(instructions="Begin this step.")
{{range .Tools}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext{{range .Args}}, {{.Name}}: {{.PyType}}{{end}}) -> dict:
        {{triple .Description}}
        async with httpx.AsyncClient() as client:
            resp = await client.post(
                os.environ[{{pyq .URLEnv}}],
                json={ {{- range $i, $a := .Args}}{{if $i}}, {{end}}{{pyq $a.Name}}: {{$a.Name}}{{end -}} },
            )
            resp.raise_for_status()
            return resp.json()
{{end}}
    @function_tool
    async def finish(self, ctx: RunContext{{range .Result}}, {{.Name}}: {{.PyType}}{{end}}) -> str:
        """Record the result of this step and finish."""
        self.complete({ {{- range $i, $r := .Result}}{{if $i}}, {{end}}{{pyq $r.Name}}: {{$r.Name}}{{end -}} })
        return "Done."
{{end}}
{{- end}}

# --- session ---------------------------------------------------------------
def prewarm(proc: JobProcess) -> None:
    proc.userdata["vad"] = silero.VAD.load()


server = AgentServer()
server.setup_fnc = prewarm


@server.rtc_session(agent_name={{pyq .AgentName}})
async def entrypoint(ctx: JobContext) -> None:
    session = AgentSession(
        stt=slng.STT(api_key=os.environ.get({{pyq .STT.APIKeyEnv}}), model={{pyq .STT.Model}}{{range .STT.Params}}, {{.Key}}={{.Value}}{{end}}),
        llm=inference.LLM(model={{pyq .SessionLLM.Model}}{{if .SessionLLM.Params}}, extra_kwargs={ {{- range $i, $p := .SessionLLM.Params}}{{if $i}}, {{end}}{{pyq $p.Key}}: {{$p.Value}}{{end -}} }{{end}}),
        tts=slng.TTS(api_key=os.environ.get({{pyq .SessionTTS.APIKeyEnv}}), model={{pyq .SessionTTS.Model}}, voice={{pyq .SessionTTS.Voice}}{{range .SessionTTS.Params}}, {{.Key}}={{.Value}}{{end}}),
        turn_handling=TurnHandlingOptions(turn_detection=inference.TurnDetector(version={{pyq .TurnVersion}})),
        vad=ctx.proc.userdata["vad"],
        preemptive_generation=True,
    )

    @session.on("metrics_collected")
    def _on_metrics_collected(ev: MetricsCollectedEvent) -> None:
        metrics.log_metrics(ev.metrics)

    await session.start(agent={{.EntryClass}}(), room=ctx.room)
    await ctx.connect()


if __name__ == "__main__":
    cli.run_app(server)
