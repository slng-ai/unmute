# Copy to .env and fill in real values. Names only here; never commit values.

# Model providers (same as the multi-task example).
OPENAI_API_KEY=
SLNG_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Pipecat target (carrier-websocket + Twilio) ---
# Twilio Console -> account dashboard, plus a Voice-capable number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Auth for the generated outbound trigger endpoint. Not a Twilio value:
# generate it yourself, for example `openssl rand -hex 32`.
UNMUTE_OUTBOUND_TOKEN=

# --- LiveKit target (sip + Twilio) ---
# Twilio Console -> Elastic SIP Trunking: termination URI, Credential List
# username and password, and the number attached to the trunk.
TWILIO_SIP_ADDRESS=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# TWILIO_PHONE_NUMBER is shared with the Pipecat target above.

# Supplied by `unmute dev --telephony` itself; do not set for local runs:
#   UNMUTE_PUBLIC_URL             (managed cloudflared tunnel, or --public-url)
#   REDIS_URL                     (generated Compose)
#   LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET (generated local stack)
#   LIVEKIT_SIP_INBOUND_TRUNK, LIVEKIT_SIP_OUTBOUND_TRUNK (created by dev)
