      "grade_answer": {
        "description": "Grade the learner's attempt at the exercise waiting. Code says what follows.",
        "input": {
          "properties": {
            "answer": {
              "description": "The learner's attempt at the exercise, copied from what they said.",
              "maxLength": 600,
              "minLength": 1,
              "title": "Answer",
              "type": "string"
            },
            "grade": {
              "description": "correct: does what was asked, in the target language, and can be understood; small slips are fine. partly: in the target language, but does only part of it or needs a real fix. wrong: does not do what was asked, or is mostly not in the target language. unclear: too cut off or garbled to judge. Judge meaning, never spelling or pronunciation.",
              "enum": [
                "correct",
                "partly",
                "wrong",
                "unclear"
              ],
              "title": "Grade",
              "type": "string"
            },
            "feedback": {
              "description": "Said before the next line, in the explanation language. correct: brief praise. partly or wrong: what was wrong, then the right sentence in the target language. unclear: ask them to say it again.",
