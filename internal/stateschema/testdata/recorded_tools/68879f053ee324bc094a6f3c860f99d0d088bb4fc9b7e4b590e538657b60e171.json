      "lookup_policy": {
        "description": "Find the caller's policy by its number and the policy holder's date of birth.\n\nCall it as soon as you have both. It first reads both back to the caller, so never\nread them back yourself. Call it again with the same values after their yes.",
        "input": {
          "properties": {
            "policy_number": {
              "description": "The policy number: KP and six digits, like KP482913. Never guess a digit.",
              "format": "spelled",
              "title": "Policy Number",
              "type": "string"
            },
            "birth_date": {
              "format": "birth-date",
              "title": "Birth Date",
              "type": "string"
