          },
          "required": [
            "policy_number",
            "birth_date"
          ],
          "title": "lookup_policy_arguments",
          "type": "object"
        },
        "output": {
          "$defs": {
            "Policy": {
              "description": "The policy the caller's number and date of birth found.",
              "properties": {
                "policy_number": {
                  "title": "Policy Number",
                  "type": "string"
                },
                "first_name": {
                  "title": "First Name",
                  "type": "string"
                },
                "vehicles": {
