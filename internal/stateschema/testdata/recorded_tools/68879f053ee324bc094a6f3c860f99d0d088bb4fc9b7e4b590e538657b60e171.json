                  "type": "string"
                },
                "words": {
                  "description": "How the car is said, like \"the blue Toyota Corolla\".",
                  "title": "Words",
                  "type": "string"
                }
              },
              "required": [
                "plate",
                "words"
              ],
              "title": "Vehicle",
              "type": "object"
            }
          },
          "description": "What ``lookup_policy`` returns.\n\nAttributes:\n    status: ``looked_up``, or ``not_a_number`` when the number is not KP and six\n        digits. Then nothing is looked up or read back, and the tool's reply asks again.",
          "properties": {
            "found": {
              "title": "Found",
              "type": "boolean"
            },
            "status": {
              "default": "looked_up",
              "enum": [
                "looked_up",
                "not_a_number"
              ],
              "title": "Status",
              "type": "string"
