          "properties": {
            "report": {
              "$ref": "#/$defs/Report"
            },
            "policy_number": {
              "title": "Policy Number",
              "type": "string"
            },
            "call": {
              "title": "Call",
              "type": "string"
            }
          },
          "$defs": {
            "Report": {
              "description": "The facts of the incident, each empty until the caller gives it.",
