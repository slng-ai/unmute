                "incident_day": {
                  "anyOf": [
                    {
                      "format": "date",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Incident Day"
                },
                "incident_time": {
                  "anyOf": [
                    {
                      "format": "time",
                      "type": "string"
                    },
                    {
                      "enum": [
                        "morning",
                        "afternoon",
                        "evening",
                        "night"
                      ],
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Incident Time"
                },
                "place": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Place"
                },
                "what_happened": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "What Happened"
                },
                "injuries": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Injuries"
                },
                "police_report": {
                  "anyOf": [
