# Portable voice-agent spec (SCHEMA.md v1). Edit this, then `unmute validate .`
# and `unmute compile .`. Nothing here is provider-specific — that lives in
# targets.yaml.
version: 1
language: [[ yaml .Language ]]
entry_agent: assistant

pipeline:
  listen: { placement: api }
  turn:   { placement: local }
  speak:  { placement: api }

models:
  assistant_model:
    description: default reasoning model
    placement: api

voices:
  assistant_voice: { description: default voice }

[[if .Variables]]variables:
[[range .Variables]]  [[.Name]]:
    type: [[.Type]]
[[if .Default]]    default: [[.Default]]
[[end]][[if .Source]]    source: [[.Source]]
[[end]][[end]]
[[end]]agents:
  assistant:
    instructions: instructions.md
    model: assistant_model
    voice: assistant_voice
[[if .Tools]]    tools:
[[range .Tools]]      - [[.Name]]
[[end]]
[[end]]
[[if .Tools]]tools:
[[range .Tools]]  - [[.Name]]
[[end]]

[[end]]conversation:
  greeting:
    speaks_first: agent
    text: [[ quote .Greeting ]]

channels:
  [[.Channel]]: { kind: realtime_audio }

capacity:
  peak_sessions: 10
  max_sessions: 20
  avg_session_duration: 5m
