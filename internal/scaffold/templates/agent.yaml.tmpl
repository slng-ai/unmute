# Portable voice-agent spec. Edit this, then run `unmute validate` and
# `unmute compile` from this directory. Nothing here names an orchestrator —
# which runtime this compiles to lives in targets.yaml, so the same agent runs
# on either one.
version: 1
[[- if .AgentName]]

# What this agent is called where it is deployed under a name instead of an id.
# The slng target writes it into the agent it pushes, and an SLNG name is unique
# in your organisation: two packages sharing one name are two packages
# overwriting one live agent. Rename it here, not by renaming this folder.
name: [[yaml .AgentName]]
[[- end]]
entry_agent: [[.EntryAgent]]

# Each agent is a prompt plus the models it thinks and speaks with. The
# instructions file is sent to the model verbatim as its system prompt, so
# everything in it is addressed to the agent and nothing in it is addressed to
# you — put your own notes here, in a comment, where the model never sees them.
#
# The starter prompt is a real one, and it is meant to be replaced. Rewrite it
# to say what your agent actually does; the greeting below is separate, and it
# is spoken word for word without going through the model at all.
#
# What an agent can do is its own lists: tools do work and come back, tasks are
# sub-conversations it runs and returns from, task groups are ordered runs of
# task steps, handoffs make the conversation somebody else's, and escalations put
# the caller through to a person. A task is written here, inside the agent that
# defines it, so one block says what the agent can do and when it does it.
agents:
[[range .AllAgents]]  [[.Name]]:
    instructions: [[.PromptPath]]
    think: [[.ModelProfile]]
    speak: [[.VoiceProfile]]
[[$tools := $.AgentTools .Name]][[if $tools]]    tools:
[[range $tools]]      - [[.]]
[[end]][[end]][[$tasks := $.AgentTasks .Name]][[if $tasks]]    tasks:
[[range $tasks]]      - name: [[.Name]]
        when: [[quote .When]]
        instructions: [[.PromptPath]]
[[if .Announce]]        announce: [[quote .Announce]]
[[end]][[if .Requires]]        requires:
[[range .Requires]]          - [[.]]
[[end]][[end]][[$taskTools := $.TaskTools .Name]][[if $taskTools]]        tools:
[[range $taskTools]]          - [[.]]
[[end]][[end]][[$taskHandoffs := $.TaskHandoffs .Name]][[if $taskHandoffs]]        handoffs:
[[range $taskHandoffs]]          - [[.]]
[[end]][[end]][[if .Model]]        think: [[.Model]]
[[end]][[if .Assign]]        assign:[[yamlBlock 10 .Assign]]
[[end]]        result:[[yamlBlock 10 .Result]]
        context:
          history: [[.History]]
[[if .MaxMessages]]          max_messages: [[.MaxMessages]]
[[end]][[if .Summarizer]]          summarizer: [[.Summarizer]]
[[end]][[if .IncludeToolCalls]]          include_tool_calls: [[boolValue .IncludeToolCalls]]
[[end]][[end]][[end]][[$groups := $.AgentTaskGroups .Name]][[if $groups]]    task_groups:
[[range $groups]]      - [[.]]
[[end]][[end]][[$handoffs := $.AgentHandoffs .Name]][[if $handoffs]]    handoffs:
[[range $handoffs]]      - [[.]]
[[end]][[end]][[$escalations := $.AgentEscalations .Name]][[if $escalations]]    escalations:
[[range $escalations]]      - [[.]]
[[end]][[end]]
[[end]][[if .Handoffs]]handoffs:
[[range .Handoffs]]  [[.Name]]:
    to: [[.To]]
    when: [[quote .When]]
[[if .Announce]]    announce: [[quote .Announce]]
[[end]]
[[if .Requires]]    requires:
[[range .Requires]]      - [[.]]
[[end]][[end]]    context:
      history: [[.History]]
[[if .MaxMessages]]      max_messages: [[.MaxMessages]]
[[end]][[if .Summarizer]]      summarizer: [[.Summarizer]]
[[end]][[if .IncludeToolCalls]]      include_tool_calls: [[boolValue .IncludeToolCalls]]
[[end]][[if .AllVariables]]      variables: all
[[else]]      variables:
[[range .Variables]]        - [[.]]
[[end]][[end]]
[[end]]
[[end]][[if .HumanTransfers]]escalations:
[[range .HumanTransfers]]  [[.Name]]:
[[if .When]]    when: [[quote .When]]
[[end]]    [[.Mode]]:
      destination: [[.Destination]]
[[if .Briefing]]      briefing: [[quote .Briefing]]
[[end]][[if .RingTimeout]]      ring_timeout: [[.RingTimeout]]
[[end]][[if .OnUnavailable]]      on_unavailable: [[.OnUnavailable]]
[[end]][[end]]
[[end]][[if .TaskGroups]]task_groups:
[[range .TaskGroups]]  [[.Name]]:
    when: [[quote .When]]
[[if .Announce]]    announce: [[quote .Announce]]
[[end]]    steps:
[[range .Steps]]      - [[.]]
[[end]]    context_scope: [[.ContextScope]]
    then: [[.Then]]
[[if .ThenTarget]]    then_target: [[.ThenTarget]]
[[end]]    merge: results
[[end]]
[[end]][[if .Variables]]variables:
[[range .Variables]]  [[.Name]]:
    type: [[.Type]]
[[if .Default]]    default: [[.Default]]
[[end]][[if .Source]]    source: [[.Source]]
[[end]][[end]]
[[end]][[if .DeclaredSecrets]]# Every runtime value you supply, by environment variable name. A secret has no
# other fields, and a value never appears in a package file: put the values in
# `.env`, which is gitignored. `unmute validate` warns when this package
# references a name you have not listed here.
secrets:
[[range .DeclaredSecrets]]  - [[.]]
[[end]]
[[end]][[if .HumanTransfers]]# Who this agent escalates to. A value is the UPPER_SNAKE name of an environment
# variable holding the number, read at call time: agent.yaml is the portable
# half of a package, so a phone number does not belong in it.
destinations:
[[range .Destinations]]  [[.Destination]]: [[.Value]]
[[end]]
[[end]][[if .Knowledge]]# Folders of documents the agents can search. Each one is read, split and
# embedded once when the agent starts, and held in memory, so content is fixed
# until the next compile. A tool with a `knowledge:` block points at one by name.
knowledge:
[[range .Knowledge]]  [[.Name]]:
    documents: [[.Documents]]
[[if .Embed]]    embed: [[.Embed]]
[[end]][[end]]
[[end]]# Every model is defined here once, in the central map grouped by kind (N15):
# think (LLM), speak (TTS), listen (STT), turn (VAD). Agents reference think
# and speak entries by name; the sole listen/turn entries select themselves.
# Add alternates alongside and swap with a top-level `listen: <name>` pointer.
models:
  think:
[[range .AllAgents]]    [[.ModelProfile]]:
      description: [[.ModelDescription]]
[[if .Reason.Provider]]      provider: [[.Reason.Provider]]
[[end]][[if .Reason.Model]]      model: [[quote .Reason.Model]]
[[end]][[if .Reason.Params]]      # Forwarded to the provider as written. A reasoning model answering with
      # function tools on chat completions needs this exact value, or OpenAI
      # returns 400 on every turn.
      params:[[yamlBlock 8 .Reason.Params]]
[[end]][[$fallbacks := $.FallbacksFor .ModelProfile]][[if $fallbacks]]      fallback:
[[range $fallbacks]]        - [[.]]
[[end]][[end]][[end]][[range .Fallbacks]]    [[.Name]]:
      description: fallback reasoning model
[[if .Binding.Provider]]      provider: [[.Binding.Provider]]
[[end]][[if .Binding.Model]]      model: [[quote .Binding.Model]]
[[end]][[if .Binding.Params]]      params:[[yamlBlock 8 .Binding.Params]]
[[end]][[end]]  speak:
[[range .AllAgents]]    [[.VoiceProfile]]:
      description: [[.VoiceDescription]]
[[if .Speak.Provider]]      provider: [[.Speak.Provider]]
[[end]][[if .Speak.Model]]      model: [[quote .Speak.Model]]
[[end]]      voice: [[quote .Speak.Voice]]
[[if .Speak.Language]]      language: [[yaml .Speak.Language]]
[[end]][[if .Speak.Params]]      params:[[yamlBlock 8 .Speak.Params]]
[[end]][[end]][[if .Listen.Provider]]  listen:
    transcriber:
      provider: [[.Listen.Provider]]
      model: [[quote .Listen.Model]]
[[if .Listen.Language]]      language: [[yaml .Listen.Language]]
[[end]][[if .Listen.Params]]      params:[[yamlBlock 8 .Listen.Params]]
[[end]][[end]][[if eq .Target "pipecat"]]  turn:
    vad:
      provider: local
      model: silero
[[else if eq .Target "livekit"]]  turn:
    detector:
      provider: livekit
      model: turn-detector-mini
[[end]]
[[if .Tools]]tools:
[[range .Tools]]  - [[.Name]]
[[end]]
[[end]]conversation:
  greeting:
    speaks_first: [[.SpeaksFirst]]
[[if .Greeting]]    text: [[ quote .Greeting ]]
[[end]][[if .Interruption]]  interruption:
    enabled: [[boolValue .Interruption]]
[[if .MinimumWords]]    minimum_words: [[.MinimumWords]]
[[end]][[if .IgnorePhrases]]    ignore_phrases:
[[range .IgnorePhrases]]      - [[quote .]]
[[end]][[end]][[end]][[if or .NudgeAfter .EndAfter]]  inactivity:
[[if .NudgeAfter]]    nudge_after: [[.NudgeAfter]]
[[end]][[if .EndAfter]]    end_after: [[.EndAfter]]
[[end]][[end]][[if .MaxDuration]]  max_duration: [[.MaxDuration]]
[[end]][[if .ThinkingAudio]]  thinking_audio: [[.ThinkingAudio]]
[[end]]
channels:
[[range .AllChannels]][[if eq .Kind "realtime_audio"]]  [[.Name]]:
    kind: realtime_audio
[[else]]  [[.Name]]:
    kind: telephony
    inbound: [[.Inbound]]
    outbound: [[.Outbound]]
[[if .RequiredControls]]    required_controls:
[[range .RequiredControls]]      - [[.]]
[[end]][[end]][[if .OnVoicemail]]    on_voicemail: [[.OnVoicemail]]
[[end]][[end]][[end]]
[[with .EffectiveCapacity]]capacity:
  peak_sessions: [[.PeakSessions]]
  max_sessions: [[.MaxSessions]]
[[if .PeakStartsPerSecond]]  peak_starts_per_second: [[.PeakStartsPerSecond]]
[[end]]  avg_session_duration: [[.AvgSessionDuration]]
[[end -]]
