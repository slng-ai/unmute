# One selected target. Add more instances later if this package needs them.
# Model names, voice ids, and params are forwarded to the provider as-is and
# never validated. Secrets and URLs are env var names only.
targets:
[[if eq .Target "pipecat"]]  pipecat-dev:
    provider: pipecat
    version: "1.5.0"
    transport: daily-sip
    models:
      # Speech in/out via the selected catalogue integrations. Model and voice
      # identities are forwarded; the default remains SLNG + OpenAI.
      listen: { provider: [[.Listen.Provider]], model: [[quote .Listen.Model]][[if .Listen.Params]], params: [[.Listen.Params]][[end]] }
      turn:   { provider: local, model: silero }
      speak:
[[range .AllAgents]]        [[.VoiceProfile]]: { provider: [[.Speak.Provider]][[if .Speak.Model]], model: [[quote .Speak.Model]][[end]], voice: [[quote .Speak.Voice]][[if .Speak.Params]], params: [[.Speak.Params]][[end]] }
[[end]]      reason:
[[range .AllAgents]]        [[.ModelProfile]]: {[[if .Reason.Provider]] provider: [[.Reason.Provider]],[[end]] model: [[quote .Reason.Model]][[if .Reason.Params]], params: [[.Reason.Params]][[end]] }
[[end]][[else if eq .Target "livekit"]]  livekit-dev:
    provider: livekit
    version: "1.5.2"
    sdk_language: python
    models:
      listen: { provider: [[.Listen.Provider]], model: [[quote .Listen.Model]][[if .Listen.Params]], params: [[.Listen.Params]][[end]] }
      turn:   { provider: livekit, model: turn-detector-mini }
      speak:
[[range .AllAgents]]        [[.VoiceProfile]]: { provider: [[.Speak.Provider]][[if .Speak.Model]], model: [[quote .Speak.Model]][[end]], voice: [[quote .Speak.Voice]][[if .Speak.Params]], params: [[.Speak.Params]][[end]] }
[[end]]      reason:
[[range .AllAgents]]        [[.ModelProfile]]: {[[if .Reason.Provider]] provider: [[.Reason.Provider]],[[end]] model: [[quote .Reason.Model]][[if .Reason.Params]], params: [[.Reason.Params]][[end]] }
[[end]][[else]]  elevenlabs-dev:
    provider: elevenlabs
    models:
      speak:
[[range .AllAgents]]        [[.VoiceProfile]]: { provider: elevenlabs, voice_id: [[quote .Speak.Voice]][[if .Speak.Params]], params: [[.Speak.Params]][[end]] }
[[end]]      reason:
[[range .AllAgents]]        [[.ModelProfile]]: { model: [[quote .Reason.Model]][[if .Reason.Params]], params: [[.Reason.Params]][[end]] }
[[end]][[end -]]
