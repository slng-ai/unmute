# One selected target, named after the provider (N15): what you test is what
# you deploy. All models, including STT and VAD, are defined in agent.yaml;
# this file carries the infrastructure plus an optional `models:` map that
# overrides an entry, by name, for a target that cannot run it as defined.
# Add more instances later if this package needs a second environment.
# Secrets and URLs are env var names only.
targets:
  [[.Target]]:
    provider: [[.Target]]
[[if .TargetVersion]]    version: [[quote .TargetVersion]]
[[end]][[if .SDKLanguage]]    sdk_language: [[.SDKLanguage]]
[[end]][[if .DeploymentRegions]]    deployment_region:[[if eq (len .DeploymentRegions) 1]] [[yaml (index .DeploymentRegions 0)]][[else]][[range .DeploymentRegions]]
      - [[yaml .]][[end]][[end]]
[[end]][[if .Pins]]    pins:[[yamlBlock 6 .Pins]]
[[end]][[if .Transport]]    transport: [[.Transport]]
[[end]][[if .Carrier]]    carrier: [[.Carrier]]
[[end]][[if .HumanTransfers]]    destinations:
[[range .Destinations]]      [[.Destination]]: [[quote .Value]]
[[end]][[end -]]
