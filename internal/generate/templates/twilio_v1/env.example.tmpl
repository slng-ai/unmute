# Environment for {{.Target}} (generated by unmute).
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# app.py reads exactly these names and no others.

# Twilio account that owns the number: https://console.twilio.com
{{.Env.AccountSID}}=
{{.Env.AuthToken}}=
# The https origin Twilio reaches this app at, with no path. Every signature is
# checked against it, so it must be exactly what Twilio calls.
{{.Env.PublicURL}}=
# The think model's key.
{{.ModelKeyEnv}}=
# Optional: the port the app listens on (default 8080).
# PORT=8080
{{- if .DeployEnv}}

# Deploy only: used to point the number at this app. app.py never reads it.
{{- range .DeployEnv}}
# {{.}}=
{{- end}}
{{- end}}
