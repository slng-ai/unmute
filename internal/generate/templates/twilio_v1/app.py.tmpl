async def _slng_log_provenance(response: Any) -> None:
    """Say where this answer came from, once per think request.

    The router states it only in response headers. httpx runs this hook before
    the body is read, so it reads headers only, and it never raises: a raising
    response hook would fail the request it only describes.

    Args:
        response: The httpx response, before its body is read.
    """
    try:
        scope = response.request.headers.get({{pyq .AgentHeader}})
        if not scope:
            return
        # Field order is the contract every router target writes.
        fields = ["scope=" + scope]
        fields.append("source=" + response.headers.get("x-slng-response-source", "unknown"))
        if response.headers.get("x-slng-cache-layer"):
            fields.append("layer=" + response.headers["x-slng-cache-layer"])
        if response.headers.get("x-slng-model"):
            fields.append("model=" + response.headers["x-slng-model"])
        fields.append("request_id=" + response.headers.get("x-slng-request-id", "unknown"))
        log.info("slng router: " + " ".join(fields))
    except Exception:  # noqa: BLE001 - a log line must never end a call
        log.debug("could not read the router's provenance headers", exc_info=True)


