class Brain:
    """Native generateContent history for one call.

    https://ai.google.dev/api/generate-content

    Every part the model returns is kept as it came, thought signatures
    included, because Gemini 3 refuses a tool follow-up whose function call
    lost its signature. Only unsigned text parts are ever edited.
    """

    def __init__(self, client: Any) -> None:
        """Start an empty history.

        Args:
            client: The model client.
        """
        self.client = client
        self.history: list[Any] = []
        declarations = [
            types.FunctionDeclaration(
                name=tool.declaration["name"],
                description=tool.declaration["description"],
                parameters_json_schema=tool.declaration["parameters"],
            )
            for tool in TOOLS.values()
        ]
        self.config = types.GenerateContentConfig(
            system_instruction=INSTRUCTIONS,
            tools=[types.Tool(function_declarations=declarations)] if declarations else None,
            automatic_function_calling=types.AutomaticFunctionCallingConfig(disable=True),
            **MODEL_PARAMS,
        )

    def user(self, text: str) -> None:
        """Add something the caller said.

        Args:
            text: The caller's words.
        """
        self.history.append(types.Content(role="user", parts=[types.Part(text=text)]))

    def assistant_text(self, text: str) -> Any:
        """Add something the agent said.

        Args:
            text: The agent's words.

        Returns:
            The history entry, so a later interrupt can edit it.
        """
        entry = types.Content(role="model", parts=[types.Part(text=text)])
        self.history.append(entry)
        return entry

    async def stream(self, call: "Call", cycle: Cycle) -> Reply:
        """Stream one model response, speaking its text as it arrives.

        Args:
            call: The call to speak on.
            cycle: The speech cycle this response fills.

        Returns:
            The tool calls, the text and the raw parts the model produced.
        """
        parts: list[Any] = []
        generated: list[str] = []
        stream = await self.client.aio.models.generate_content_stream(
            model=MODEL, contents=self.history, config=self.config
        )
        async for chunk in stream:
            content = chunk.candidates[0].content if chunk.candidates else None
            for part in (content.parts if content and content.parts else []):
                parts.append(part)
                if part.text and not part.thought:
                    generated.append(part.text)
                    await call.speak(cycle, part.text)
        calls = [
            ToolCall(p.function_call.id or "", p.function_call.name or "", p.function_call.args or {})
            for p in parts
            if p.function_call
        ]
        return Reply(calls=calls, generated="".join(generated), raw=merge_text_parts(parts))

    def commit(self, cycle: Cycle, reply: Reply, results: list[tuple[ToolCall, Any]]) -> Any:
        """Record the model turn and its tool results.

        Args:
            cycle: The cycle that was spoken.
            reply: What the model produced.
            results: Each tool call with its result.

        Returns:
            The model entry, or None when there was nothing to keep.
        """
        if not reply.raw and not cycle.text:
            return None
        seen: set[str] = set()
        parts = []
        for part in reply.raw or [types.Part(text=cycle.text)]:
            call_id = part.function_call.id if part.function_call else None
            if call_id:
                if call_id in seen:
                    continue  # a duplicated call id runs, and is kept, once
                seen.add(call_id)
            parts.append(part)
        entry = types.Content(role="model", parts=parts)
        self.history.append(entry)
        if cycle.text != reply.generated:
            self.set_text(entry, cycle.text)
        if results:
            self.history.append(
                types.Content(
                    role="tool",
                    parts=[
                        types.Part(
                            function_response=types.FunctionResponse(
                                # The id goes back only when the model sent one.
                                id=tool_call.id or None,
                                name=tool_call.name,
                                response=result if isinstance(result, dict) else {"result": result},
                            )
                        )
                        for tool_call, result in results
                    ],
                )
            )
        return entry

    def set_text(self, entry: Any, text: str) -> None:
        """Cut an entry's text down to what the caller heard.

            Edits unsigned text parts only; text inside a signed part stays as
            generated, because editing it could invalidate the signature.

        Args:
            entry: A history entry from assistant_text or commit.
            text: The text to keep; empty drops it.
        """
        plain = [p for p in entry.parts if p.text is not None and not p.thought and not p.thought_signature]
        if not plain:
            return
        plain[0].text = text
        for part in plain[1:]:
            entry.parts.remove(part)
        if not text:
            entry.parts.remove(plain[0])
        if not entry.parts:
            remove_entry(self.history, entry)

    def trim(self) -> None:
        """Drop the oldest turns once the history is too long."""
        trim_history(
            self.history,
            lambda e: e.role == "user" and any(p.text for p in e.parts or []),
        )


def merge_text_parts(parts: list[Any]) -> list[Any]:
    """Join neighbouring unsigned text parts; keep every other part as it came.

    Args:
        parts: The parts the model returned, in order.

    Returns:
        The parts with neighbouring plain text merged.
    """
    merged: list[Any] = []
    for part in parts:
        plain = part.text is not None and not part.thought and not part.thought_signature
        if plain and merged:
            last = merged[-1]
            if last.text is not None and not last.thought and not last.thought_signature and not last.function_call:
                merged[-1] = types.Part(text=last.text + part.text)
                continue
        merged.append(part)
    return merged
{{end}}

def remove_entry(history: list[Any], entry: Any) -> None:
    """Remove one entry by identity, since equal entries can repeat.

    Args:
        history: The history to edit in place.
        entry: The entry to remove; nothing happens if it is not there.
    """
    index = next((i for i, item in enumerate(history) if item is entry), None)
    if index is not None:
        del history[index]


def trim_history(history: list[Any], is_user_turn: Callable[[Any], bool]) -> None:
    """Drop the oldest turns, cutting only where a caller turn starts.

    A tool call is never separated from its result.

    Args:
        history: The history to edit in place.
        is_user_turn: Says whether an entry starts a caller turn.
    """
    if len(history) <= MAX_HISTORY:
        return
    start = next((i for i in range(len(history) - MAX_HISTORY, len(history)) if is_user_turn(history[i])), None)
    if start is not None:
        del history[:start]


