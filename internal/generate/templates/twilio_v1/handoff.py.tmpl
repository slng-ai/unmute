"""What a call does after its session: the TwiML answers at /connect-action.

When a session ends, Twilio asks /connect-action what the call does next. The
answer is TwiML: any Twilio verb (Dial, Enqueue, Pay, Say...), or resume(),
which connects the caller to the agent again with the conversation kept.
"""

class Resume(str):
    """TwiML that connects the caller to the agent again.

    The app keeps the call's history for it; any other answer lets the history go.
    """


@dataclass
class Handoff:
    """What next_twiml() and a built-in step read at /connect-action."""

    reason: str  # handoffData's reasonCode: end_call, busy, shutdown, or your own
    data: dict[str, Any]  # the rest of handoffData, as session.end() sent it
    call: dict[str, str]  # call_sid, from, to, direction
    status: str  # SessionStatus: completed, ended or failed
    resume: Callable[..., Resume] = field(repr=False)  # resume(note, before="", greeting="") -> TwiML

    @property
    def twilio(self) -> Any:
        """A Twilio REST client on this app's account.

        It is synchronous: call it through asyncio.to_thread.
        """
        return twilio_client()


@cache
def twilio_client() -> Any:
    """Build the Twilio REST client once.

    Returns:
        A client on this app's account and region.
    """
    from twilio.rest import Client

    return Client(
        os.environ[ENV_ACCOUNT_SID], os.environ[ENV_AUTH_TOKEN], region=TWILIO_REGION, edge=TWILIO_EDGE
    )


def parse_handoff(raw: Any) -> tuple[str, dict[str, Any]]:
    """Read handoffData, a string the app itself wrote. Anything else is none.

    Args:
        raw: The HandoffData form field.

    Returns:
        The reasonCode and the rest of the data.
    """
    try:
        data = json.loads(raw) if isinstance(raw, str) else None
    except ValueError:
        data = None
    if not isinstance(data, dict):
        return "", {}
    return str(data.pop("reasonCode", "")), data


# Built-in steps by reasonCode, each (handoff) -> TwiML. Empty today: every
# reason the app sends hangs up. A Twilio service the package declares adds
# its row here.
NEXT_STEPS: dict[str, Callable[[Handoff], str]] = {}


async def next_step(handoff: Handoff) -> str:
    """Pick the TwiML for what the call does after the session.

    The package's own logic first, then a built-in step, then hang up.

    Args:
        handoff: What the ended session handed over.

    Returns:
        The TwiML to answer /connect-action with.
    """
{{- if .Logic}}
    hook = getattr(logic, "next_twiml", None)
    if hook is not None:
        try:
            answer = hook(handoff)
            if inspect.isawaitable(answer):
                answer = await asyncio.wait_for(answer, NEXT_STEP_TIMEOUT)
            if answer is not None and not isinstance(answer, str):
                raise TypeError("next_twiml() must return TwiML as a str, or None")
            if answer:
                ET.fromstring(answer.removeprefix('<?xml version="1.0" encoding="UTF-8"?>'))
                return answer
        except Exception as error:  # noqa: BLE001 - a broken step must still end the call cleanly
            log.warning("event=next_twiml_failed error=%s", type(error).__name__)
{{- end}}
    step = NEXT_STEPS.get(handoff.reason)
    return step(handoff) if step is not None else HANGUP_TWIML


def relay_document(origin: str, host: str) -> ET.Element:
    """Load the TwiML template and point it at this app.

    Args:
        origin: The public https origin.
        host: The public host, for the wss URL.

    Returns:
        The TwiML document.

    Raises:
        SystemExit: If the template is malformed or a placeholder survives.
    """
    root = ET.parse(HERE / "conversation-relay.xml.tmpl").getroot()
    connect = root.find("Connect")
    relay = connect.find("ConversationRelay") if connect is not None else None
    if connect is None or relay is None:
        raise SystemExit("conversation-relay.xml.tmpl has no Connect/ConversationRelay element")
    connect.set("action", origin + "/connect-action")
    relay.set("url", f"wss://{host}/conversation")
    body = to_twiml(root)
    if ORIGIN_PLACEHOLDER in body or WSS_PLACEHOLDER in body:
        raise SystemExit("conversation-relay.xml.tmpl still carries a placeholder after rendering")
    return root


def to_twiml(root: ET.Element) -> str:
    """Serialize a TwiML document.

    Args:
        root: The document's root element.

    Returns:
        The TwiML text with its XML declaration.
    """
    return '<?xml version="1.0" encoding="UTF-8"?>' + ET.tostring(root, encoding="unicode")


def resume_twiml(root: ET.Element, note: str, before: str = "", greeting: str = "") -> Resume:
    """Build the same Connect, telling the new session to carry on the parked conversation.

    The model is not asked to speak here, and no turn is made up for it: a
    turn the caller never said was where it stopped following its
    instructions. The note reaches the new session as customParameters.resume.

    Args:
        root: The TwiML document from relay_document.
        note: Why the caller is coming back, for the new session.
        before: TwiML verbs Twilio runs first, for example <Say>One moment.</Say>.
        greeting: The line ConversationRelay speaks as the caller comes back;
            without one, the agent waits for the caller.

    Returns:
        The TwiML that reconnects the caller.

    Raises:
        RuntimeError: If the document has no ConversationRelay element.
    """
    root = copy.deepcopy(root)
    root[:0] = ET.fromstring(f"<Response>{before}</Response>")
    relay = root.find("Connect/ConversationRelay")
    if relay is None:  # relay_document checked it; this satisfies the type checker
        raise RuntimeError("the TwiML lost its ConversationRelay")
    relay.attrib.pop("welcomeGreeting", None)
    ET.SubElement(relay, "Parameter", name="resume", value=str(note)[:MAX_RESUME_NOTE] or "resume")
    if greeting:
        relay.set("welcomeGreeting", greeting[:MAX_RESUME_NOTE])
        ET.SubElement(relay, "Parameter", name="greeting", value=greeting[:MAX_RESUME_NOTE])
    return Resume(to_twiml(root))
