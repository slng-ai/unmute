        @transport.event_handler("on_dialin_ready")
        async def on_dialin_ready(transport: Any, sip_endpoint: str) -> None:
            """Forward the carrier call into the room once Daily says it is live."""
            # Daily says which address the room is reachable on and that it is
            # live, both in this one event. Waiting for it is the point: the
            # address exists from the moment the room does, but a call sent there
            # before the leg is up is a call that goes nowhere.
            #
            # The guard is claimed before the request goes out, not after: a
            # second ready signal arriving while the first forward is still in
            # flight must not forward the same call twice.
            nonlocal call_forwarded
            if call_forwarded:
                return
            call_forwarded = True
            try:
                await _forward_carrier_call(carrier_call["call_sid"], sip_endpoint)
            except Exception as exc:  # noqa: BLE001 - logged by name; the caller stays on hold audio
                # Named, not swallowed. The caller is still on the helper's hold
                # audio, and this line is what says why they never got further.
                logger.error("forwarding carrier call {} failed: {}", carrier_call["call_sid"], exc)
                return
            logger.info("carrier call {} forwarded into the room", carrier_call["call_sid"])
