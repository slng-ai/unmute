# Tools available inside task steps; stable module-level handlers so a
# re-registered function name always resolves to the same callable.
{{range .FlowTools}}

async def _flow_tool_{{.Name}}(args: Any, flow_manager: FlowManager{{if .NeedsState}}, state: Any = None{{end}}) -> Any:
    {{flowToolDoc 4 .Description .NeedsState}}
{{if .Needed}}    refusal = _refusal({{pyq .Name}}, state, {{.NeededLiteral}})
    if refusal:
        return {"refused": refusal}
{{end}}{{if .Announce}}    # Cover the wait, same contract as _direct_tool: TTSSpeakFrame is a
    # DataFrame, so it is queued and speech starts while the handler body runs.
    # A flows handler holds a FlowManager rather than FunctionCallParams, and
    # FlowManager.worker is the documented seam for queueing a frame from inside
    # a handler (pipecat.flows.manager, pipecat-ai 1.9.0). Queued after the
    # refusal check, so a refused call stays silent.
    await flow_manager.worker.queue_frame(TTSSpeakFrame({{.Announce}}))
{{end}}{{if .KnowledgeBase}}    return await knowledge.look_up({{pyq .KnowledgeBase}}, dict(args)["query"])
{{else if .Local}}    result = tools.{{.Name}}.{{.Name}}(**dict(args){{range .Inject}}, {{.Key}}={{.Expr}}{{end}})
    if inspect.isawaitable(result):
        result = await result
    return result
{{else if .HostedCode}}    result = tools.{{.Name}}.{{hostedEntry}}(tools.{{.Name}}.{{hostedInput}}(**dict(args){{range .Inject}}, {{.Key}}={{.Expr}}{{end}}))
    if inspect.isawaitable(result):
        result = await result
    return result.model_dump() if hasattr(result, "model_dump") else result
{{else}}    async with httpx.AsyncClient() as client:
        response = await client.post({{.URLExpr}}, {{if .Auth}}headers={{.Auth.Expr}}, {{end}}json={**dict(args){{range .Inject}}, {{pyq .Key}}: {{.Expr}}{{end}}}, timeout=WEBHOOK_TIMEOUT_SECS)
        response.raise_for_status()
        return response.json()
{{end}}{{end}}
