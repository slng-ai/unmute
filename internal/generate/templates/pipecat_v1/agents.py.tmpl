                # The owner's cache scope goes back with its prompt. A leaked
                # task scope is the same defect pointing the other way.
                extra={"extra_headers": {{$agentSlngHeaders}}}{{end}}),
        ))
        await self.flush_pipeline()
{{if eq $d.Then "transfer"}}        self.context.set_messages(messages)
        self.context.set_tools(tools)
        await self.activate_worker(
            {{pyq $d.ThenTarget}},
            args=LLMWorkerActivationArgs(
                metadata=self._dev.activation_metadata() if self._dev else None,
                messages=[{"role": "developer", "content": json.dumps(_group_status(self._{{$d.MethodName}}_results))}],
                run_llm=True,
            ),
            deactivate_self=True,
        )
{{else}}        self.context.set_messages([
            *messages,
{{if $d.CarriesTurn}}            *_carried_messages(self._{{$d.MethodName}}_carried_turn),
{{end}}            {
                "role": "developer",
                "content": json.dumps(_group_status(self._{{$d.MethodName}}_results)),
            },
        ])
        self.context.set_tools(tools)
        # Counted after the restore, so a turn a step consumed and carried back
        # is included: that turn is the one the owner is about to read, and it
        # is exactly the turn that must not be mistaken for a new request.
        self._ran_at_{{$d.MethodName}} = _caller_turns(self.context.get_messages())
{{end}}{{if and $d.HasTransfers (ne $d.Then "end")}}{{end}}        return {"status": "ok"}, None
{{end}}{{end}}{{end}}{{if eq $d.Then "end"}}
    def _{{$d.MethodName}}_end_node(self) -> NodeConfig:
        """Build the closing node that says goodbye and ends the call."""
        # Terminal node: speak a brief closing line, then end_conversation ends
        # the call once its TTS drains (Flows built-in action; V4/B2).
        return NodeConfig(
            name="end",
            task_messages=[{"role": "developer", "content": "Thank the caller and say goodbye."}],
            functions=[],
            post_actions=[{"type": "end_conversation"}],
        )
{{end}}{{end}}
{{end}}{{end}}{{if and (not .Inline) .HasFlows}}
def _flow_visit(
    worker: Any, delegate: str, handler: Callable[..., Awaitable[Any]]
) -> Callable[[Any, FlowManager], Awaitable[Any]]:
    """Wrap a step handler so it does nothing once its flow has been left.

    Args:
        worker: The worker that owns the flow.
        delegate: The delegate tool that started this flow.
        handler: The step's handler.

    Returns:
        The guarded handler.
    """
    visit = getattr(worker, "_" + delegate + "_visit", None)

    async def invoke(args: Any, flow_manager: FlowManager) -> Any:
        """Run the handler only while this visit is still the current one."""
        if getattr(worker, "_" + delegate + "_visit", None) is not visit:
            return {"status": "already handled"}, NO_RESPONSE
        return await handler(args, flow_manager)
    return invoke

{{end}}{{if .FlowTools}}
