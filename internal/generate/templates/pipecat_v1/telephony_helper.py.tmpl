"""Call-forwarding helper for {{.Project}} (generated by unmute; do not edit by hand).

You run this; the platform does not. It is the bridge between your carrier's
webhook and the deployed agent, and it exists because Daily's SIP addresses are
per room and rooms are created per call, so there is no static address your
carrier could forward to.

One inbound call, in order:

  1. the carrier posts to /call
  2. this process creates a Daily room with the SIP interconnect enabled and
     captures the room's SIP endpoint
  3. it starts the deployed agent, handing it the room and that endpoint
  4. it answers the carrier so the caller hears something while the agent boots
  5. the agent forwards the live call to the room's SIP endpoint, exactly once

Secret values are read from the environment and never written here. Nothing is
persisted: no state outlives a request.
"""

from __future__ import annotations

import os
import sys
from contextlib import asynccontextmanager

import aiohttp
from dotenv import load_dotenv
from fastapi import FastAPI, {{if .DailyCarrier.HasInbound}}Form, {{end}}Request{{if .DailyCarrier.HasInbound}}, Response{{end}}
from loguru import logger
from pipecat.runner.daily import configure

load_dotenv()

logger.remove()
logger.add(sys.stderr, level=os.getenv("UNMUTE_LOG_LEVEL", "INFO").upper())

# The agent name is compiled in, not configured: it is the same name the deploy
# manifest carries, so a helper can never be pointed at the wrong agent.
AGENT_NAME = {{pyq .Project}}
START_URL = f"https://api.pipecat.daily.co/v1/public/{AGENT_NAME}/start"

PIPECAT_CLOUD_API_KEY_ENV = "PIPECAT_CLOUD_API_KEY"

# Names only. A missing value fails at startup, by name, before the first call.
REQUIRED_ENV = [
    "DAILY_API_KEY",
    PIPECAT_CLOUD_API_KEY_ENV,
]

# Optional. Unset is a supported state, not a missing value.
HOLD_AUDIO_URL_ENV = "UNMUTE_HOLD_AUDIO_URL"
ROOM_GEO_ENV = "UNMUTE_DAILY_ROOM_GEO"

# The room dies on its own if a call never lands, so an abandoned room is not a
# room you have to clean up. Hours, as the Daily helper takes it.
ROOM_EXPIRY_HOURS = 0.25
# Dial-out is requested on the room only when this package can use it. Asking for
# it otherwise would need a Daily domain permission this package does not need.
ROOM_ENABLE_DIALOUT = {{if or .DailyCarrier.HasOutbound .HasColdTransfer}}True{{else}}False{{end}}


def require_env() -> None:
    """Refuse to serve half-configured. Names, one per line, never values."""
    missing = [name for name in REQUIRED_ENV if not os.getenv(name)]
    if not missing:
        return
    print("telephony_helper: missing required environment values:", file=sys.stderr)
    for name in missing:
        print(f"  {name}", file=sys.stderr)
    print("Fill them in .env (see .env.example) and start again.", file=sys.stderr)
    raise SystemExit(1)


@asynccontextmanager
async def lifespan(app: FastAPI):
    require_env()
    async with aiohttp.ClientSession() as session:
        app.state.session = session
        logger.info("telephony helper ready for agent {}", AGENT_NAME)
        yield


app = FastAPI(lifespan=lifespan)
{{if .DailyCarrier.HasInbound}}

def _hold_answer() -> Response:
    """What the caller hears from answer until the agent joins.

    Never silence and never a bare pause: a pause is capped too short for room
    setup, and silence reads as a dead call. With no hold audio configured the
    caller hears a spoken line, which depends on no external host and so cannot
    rot the day somebody else's asset URL moves.

    ponytail: one answer dialect, the one this route's carrier speaks. A second
    carrier replaces this function and the failure answer below with its own, and
    nothing else in this file changes.
    """
    audio = os.getenv(HOLD_AUDIO_URL_ENV)
    if audio:
        body = f'<Play loop="10">{audio}</Play>'
    else:
        body = '<Say loop="10">One moment while I connect you.</Say>'
    return Response(content=f"<Response>{body}</Response>", media_type="application/xml")


def _failure_answer() -> Response:
    """Said when no agent will join: the caller is told and the call ends, rather
    than parked on hold for something that is not coming."""
    return Response(
        content=(
            "<Response><Say>Sorry, we cannot take your call right now. "
            "Please try again shortly.</Say><Hangup/></Response>"
        ),
        media_type="application/xml",
    )
{{end}}

async def _create_room(request: Request, *, caller: str):
    """Mint one room for one incoming call, with the SIP interconnect on.

    The interconnect is requested here rather than through the platform's start
    endpoint, because that endpoint's response carries no SIP endpoint and the SIP
    endpoint is the whole point of this flow.
    """
    return await configure(
        request.app.state.session,
        room_exp_duration=ROOM_EXPIRY_HOURS,
        sip_caller_phone=caller,
        sip_provider="daily",
        enable_dialout=ROOM_ENABLE_DIALOUT,
        room_geo=os.getenv(ROOM_GEO_ENV) or None,
    )


async def _start_agent(request: Request, body: dict) -> dict:
    """Start the deployed agent on a room this process already created.

    createDailyRoom is false on purpose: the room exists, and letting the
    platform mint a second one would start the agent somewhere the caller is not.
    """
    session: aiohttp.ClientSession = request.app.state.session
    async with session.post(
        START_URL,
        headers={"Authorization": f"Bearer {os.environ[PIPECAT_CLOUD_API_KEY_ENV]}"},
        json={"createDailyRoom": False, "body": body},
    ) as response:
        if response.status >= 400:
            raise RuntimeError(f"agent start failed with {response.status}: {await response.text()}")
        return await response.json()
{{if .DailyCarrier.HasInbound}}

@app.post("/call")
async def inbound_call(
    request: Request,
    CallSid: str = Form(default=""),
    From: str = Form(default=""),
) -> Response:
    """The carrier's voice webhook: answer fast, hold audibly, start the agent."""
    if not CallSid:
        logger.error("inbound webhook carried no call identifier field: CallSid")
        return _failure_answer()
    try:
        room = await _create_room(request, caller=From or "caller")
        if not room.sip_endpoint:
            raise RuntimeError("the room was created without a SIP endpoint")
        started = await _start_agent(
            request,
            {
                "room_url": room.room_url,
                "token": room.token,
                "direction": "inbound",
                "call_sid": CallSid,
                "sip_uri": room.sip_endpoint,
            },
        )
        logger.info("inbound call {} started session {}", CallSid, started.get("sessionId"))
    except Exception as exc:
        # Named cause in the log, spoken failure to the caller.
        logger.error("inbound call {} could not be set up: {}", CallSid, exc)
        return _failure_answer()
    return _hold_answer()
{{end}}

# There is deliberately no endpoint here that places a call.
#
# This process only exists because an *incoming* call needs a room that does not
# exist yet: Daily makes one room per call and its SIP address comes with it, so
# there is nothing static for a carrier to be pointed at. Dialling out has no such
# problem, so it is started straight against the platform with one command the
# README spells out, exactly as it is on a Daily-provisioned number.
#
# That is also why this server needs no authentication. It is reachable from the
# internet, because your carrier has to reach it, and everything it can do is
# answer a call that a carrier already delivered. An endpoint here that spent money
# would have to be guarded, and the guard would be one more value for you to invent
# and keep. Not having the endpoint is better than having a well-guarded one.


@app.get("/healthz")
async def healthz() -> dict:
    """Up, nothing more. It exists so troubleshooting can tell "helper down" from
    "helper up, flow broken"."""
    return {"status": "ok"}


if __name__ == "__main__":
    import uvicorn

    uvicorn.run(app, host="0.0.0.0", port=int(os.getenv("PORT", "7860")))
