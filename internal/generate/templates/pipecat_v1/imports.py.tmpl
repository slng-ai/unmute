{{- /* The import block every emitted module draws from. Each module keeps the
statements it references and gains one for each name another module defines
(linkPython, internal/generate/pylink.go), so no module lists its own. */ -}}
{{- /* svc renders any resolved ServiceCall: flat kwargs, then the nested
Class.Settings(...) block for settings-style services (see the provider
catalogue, internal/target/catalog_pipecat.go). */ -}}
{{define "svc"}}{{.Class}}(
{{range .Args}}        {{.Key}}={{.Value}},
{{end}}{{if .SettingsArgs}}        {{.SettingsArg}}={{.SettingsClass}}(
{{range .SettingsArgs}}            {{.Key}}={{.Value}},
{{end}}        ),
{{end}}    ){{end -}}
{{- /* mcp_client renders one MCP tool source's client (N40). An absent field
emits no argument: no tools_filter means every tool the server exposes, no
headers means no authentication. A source with no transport gets the startup
chooser instead of a parameter class. */ -}}
{{define "mcp_client"}}MCPClient(
            server_params={{if .ParamsClass}}{{.ParamsClass}}(url=os.environ[{{pyq .URLEnv}}]{{if .Auth}}, headers={{.Auth.Expr}}{{end}}, timeout={{mcpTimeout}}){{else}}_mcp_params(os.environ[{{pyq .URLEnv}}]{{if .Auth}}, {{.Auth.Expr}}{{end}}){{end}},
{{if .Tools}}            tools_filter=[{{range $i, $t := .Tools}}{{if $i}}, {{end}}{{pyq $t}}{{end}}],
{{end}}        ){{end -}}
