"""Generated Twilio ingress and call control for {{.Project}}."""

from __future__ import annotations

import asyncio
import hmac
import os
import re
import secrets
from urllib.parse import parse_qsl, urlsplit, urlunsplit
from xml.etree.ElementTree import Element, SubElement, tostring

from fastapi import FastAPI, HTTPException, Request, WebSocket
from fastapi.responses import Response
from pipecat.runner.types import WebSocketRunnerArguments
from twilio.request_validator import RequestValidator
from twilio.rest import Client

import bot
from telephony_state import TelephonyState


app = FastAPI()
ACCOUNT_SID_ENV = {{pyq .Telephony.AccountSIDEnv}}
AUTH_TOKEN_ENV = {{pyq .Telephony.AuthTokenEnv}}
FROM_NUMBER_ENV = {{pyq .Telephony.FromNumberEnv}}
CONNECTION = {{pyq .Telephony.Connection}}
PENDING_TTL_SECS = 300
SESSION_TTL_SECS = {{.Telephony.SessionTTL}}
REQUIRED_ENV = [{{range $i, $name := .RequiredEnv}}{{if $i}}, {{end}}{{pyq $name}}{{end}}]
CALL_START_TYPES = {
{{range .Telephony.CallStart}}    {{pyq .Name}}: {{pyq .Type}},
{{end}}}
CALL_START_REQUIRED = {
{{range .Telephony.CallStart}}{{if .Required}}    {{pyq .Name}},
{{end}}{{end}}}
STATE = TelephonyState(os.getenv("REDIS_URL"), {{pyq .Project}}, {{.Telephony.MaxSessions}}, SESSION_TTL_SECS)


def _env(name: str) -> str:
    value = os.getenv(name)
    if not value:
        raise RuntimeError(f"Missing required environment variable: {name}")
    return value


def _public_url() -> str:
    value = _env("UNMUTE_PUBLIC_URL").rstrip("/")
    parsed = urlsplit(value)
    if parsed.scheme != "https" or not parsed.netloc or parsed.query or parsed.fragment:
        raise RuntimeError("UNMUTE_PUBLIC_URL must be an HTTPS origin with an optional path")
    return value


def _http_url(path: str) -> str:
    return _public_url() + path


def _websocket_url(path: str) -> str:
    parsed = urlsplit(_http_url(path))
    return urlunsplit(("wss", parsed.netloc, parsed.path, "", ""))


def _validator() -> RequestValidator:
    return RequestValidator(_env(AUTH_TOKEN_ENV))


async def _signed_form(request: Request) -> dict[str, str]:
    form = dict(parse_qsl((await request.body()).decode("utf-8"), keep_blank_values=True))
    signature = request.headers.get("X-Twilio-Signature", "")
    if not signature or not _validator().validate(_http_url(request.url.path), form, signature):
        raise HTTPException(status_code=403, detail="invalid carrier signature")
    return form


def _validate_websocket(websocket: WebSocket) -> bool:
    signature = websocket.headers.get("X-Twilio-Signature", "")
    return bool(signature) and _validator().validate(
        _websocket_url(websocket.url.path), {}, signature
    )


async def _remember(direction: str, from_number: str, to_number: str, call_start: dict) -> tuple[str, str]:
    session_id = secrets.token_urlsafe(24)
    token = secrets.token_urlsafe(32)
    await STATE.remember_pending(token, {
        "session_id": session_id,
        "direction": direction,
        "from_number": from_number,
        "to_number": to_number,
        "call_start": dict(call_start),
    }, PENDING_TTL_SECS)
    return token, session_id


async def _require_accepting() -> None:
    if STATE.draining or not await STATE.ping():
        raise HTTPException(status_code=503, detail="telephony control unavailable")


def _stream_twiml(token: str) -> str:
    response = Element("Response")
    connect = SubElement(response, "Connect")
    SubElement(connect, "Stream", url=_websocket_url(f"/telephony/ws/{token}"))
    return tostring(response, encoding="unicode")


def _dial_twiml(destination: str) -> str:
    response = Element("Response")
    dial = SubElement(response, "Dial")
    dial.text = destination
    return tostring(response, encoding="unicode")


def _valid_destination(value: object) -> bool:
    return isinstance(value, str) and bool(
        re.fullmatch(r"\+[1-9][0-9]{7,14}", value) or value.startswith("sip:")
    )


def _valid_call_start(name: str, value: object) -> bool:
    kind = CALL_START_TYPES[name]
    if kind == "string":
        return isinstance(value, str)
    if kind == "boolean":
        return isinstance(value, bool)
    if kind == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if kind == "number":
        return isinstance(value, (int, float)) and not isinstance(value, bool)
    return False


def configure_pipecat_env() -> None:
    """Pipecat's Twilio serializer reads canonical names; Connections may rename them."""
    os.environ["TWILIO_ACCOUNT_SID"] = _env(ACCOUNT_SID_ENV)
    os.environ["TWILIO_AUTH_TOKEN"] = _env(AUTH_TOKEN_ENV)


def normalized_context(runner_args: WebSocketRunnerArguments) -> dict:
    pending = (runner_args.body or {}).get("telephony")
    call_data = runner_args.call_data
    if not pending or call_data is None:
        raise RuntimeError("authenticated telephony context is unavailable")
    return {
        "session_id": pending["session_id"],
        "carrier": "twilio",
        "connection": CONNECTION,
        "call_id": call_data.call_id,
        "stream_id": call_data.stream_id,
        "direction": pending["direction"],
        "from_number": pending["from_number"],
        "to_number": pending["to_number"],
        "call_start": pending["call_start"],
    }


async def cold_transfer(call_id: str, destination: str) -> None:
    if not _valid_destination(destination):
        raise RuntimeError("invalid compiled transfer destination")
    if not await STATE.mark_once("transfer", call_id, SESSION_TTL_SECS):
        return
    try:
        client = Client(_env(ACCOUNT_SID_ENV), _env(AUTH_TOKEN_ENV))
        await asyncio.to_thread(client.calls(call_id).update, twiml=_dial_twiml(destination))
    except Exception:
        await STATE.forget("transfer", call_id)
        raise


@app.get("/healthz")
async def health() -> dict[str, str]:
    return {"status": "ok"}


@app.get("/readyz")
async def readiness() -> dict[str, object]:
    missing = [name for name in REQUIRED_ENV if not os.getenv(name)]
    if missing:
        raise HTTPException(status_code=503, detail={"missing_environment": missing})
    _public_url()
    await _require_accepting()
    return {"ready": True}


@app.on_event("shutdown")
async def shutdown() -> None:
    STATE.begin_drain()
    await STATE.close()


{{if .Telephony.HasInbound}}@app.post("/telephony/inbound")
async def inbound(request: Request) -> Response:
    form = await _signed_form(request)
    await _require_accepting()
    from_number = form.get("From", "")
    to_number = form.get("To", "")
    if not _valid_destination(from_number) or not _valid_destination(to_number):
        raise HTTPException(status_code=400, detail="invalid carrier call context")
    token, _ = await _remember("inbound", from_number, to_number, {})
    return Response(_stream_twiml(token), media_type="application/xml")


{{end}}{{if .Telephony.HasOutbound}}@app.post("/telephony/outbound")
async def outbound(request: Request) -> dict[str, str]:
    expected = "Bearer " + _env("UNMUTE_OUTBOUND_TOKEN")
    if not hmac.compare_digest(request.headers.get("Authorization", ""), expected):
        raise HTTPException(status_code=401, detail="invalid application authorization")
    await _require_accepting()
    body = await request.json()
    if not isinstance(body, dict) or set(body) - {"to", "call_start"}:
        raise HTTPException(status_code=422, detail="unknown outbound field")
    destination = body.get("to")
    call_start = body.get("call_start", {})
    if not _valid_destination(destination) or not isinstance(call_start, dict):
        raise HTTPException(status_code=422, detail="invalid outbound request")
    if set(call_start) - set(CALL_START_TYPES):
        raise HTTPException(status_code=422, detail="unknown call_start field")
    missing = sorted(CALL_START_REQUIRED - set(call_start))
    invalid = sorted(name for name, value in call_start.items() if not _valid_call_start(name, value))
    if missing or invalid:
        raise HTTPException(status_code=422, detail={"missing": missing, "invalid": invalid})
    token, session_id = await _remember("outbound", _env(FROM_NUMBER_ENV), destination, call_start)
    client = Client(_env(ACCOUNT_SID_ENV), _env(AUTH_TOKEN_ENV))
    call = await asyncio.to_thread(
        client.calls.create,
        to=destination,
        from_=_env(FROM_NUMBER_ENV),
        twiml=_stream_twiml(token),
        status_callback=_http_url("/telephony/status"),
        status_callback_event=["initiated", "ringing", "answered", "completed"],
    )
    return {"session_id": session_id, "call_id": call.sid, "status": "accepted"}


{{end}}@app.post("/telephony/status")
async def status(request: Request) -> dict[str, bool]:
    form = await _signed_form(request)
    event_id = ":".join(
        (form.get("CallSid", ""), form.get("CallStatus", ""), form.get("SequenceNumber", ""))
    )
    duplicate = not await STATE.mark_once("status", event_id, SESSION_TTL_SECS)
    return {"accepted": True, "duplicate": duplicate}


@app.websocket("/telephony/ws/{token}")
async def media(websocket: WebSocket, token: str) -> None:
    if STATE.draining or not _validate_websocket(websocket):
        await websocket.close(code=4003)
        return
    pending = await STATE.pending(token, consume=True)
    if pending is None:
        await websocket.close(code=4003)
        return
    if not await STATE.admit(pending["session_id"]):
        await websocket.close(code=1013)
        return
    await websocket.accept()
    try:
        runner_args = WebSocketRunnerArguments(
            websocket=websocket,
            transport_type=None,
            body={"telephony": pending},
            session_id=pending["session_id"],
        )
        await bot.bot(runner_args)
    finally:
        await STATE.release(pending["session_id"])
