# Generated local-development topology. Not a production deployment model.
# Optional containerized topology for validating the same image production
# deploys. `unmute dev` runs Pipecat on the host so browser WebRTC can reach its
# ICE candidates. No coordination store here; the web path does not use one.
services:
  application:
    build:
      context: .
    command: ["python", "bot.py", "--host", "0.0.0.0", "--port", "7860"]
{{- if .DevEnv}}
    environment:
{{- range .DevEnv}}
      - {{.}}
{{- end}}
{{- range .DevOptionalEnv}}
      # optional: passed through when set on the host; absent otherwise
      - {{.}}
{{- end}}
{{- end}}
    ports:
      - "${UNMUTE_DEV_PORT:-7860}:7860"
    healthcheck:
      test: ["CMD", "python", "-c", "import socket; socket.create_connection(('127.0.0.1', 7860), timeout=2)"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s
