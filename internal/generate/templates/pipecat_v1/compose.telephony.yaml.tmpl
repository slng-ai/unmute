# Generated local-development topology. Do not use this file as a production deployment model.
services:
  application:
    build:
      context: .
    stop_grace_period: "{{.Telephony.SessionTTL}}s"
    environment:
      - REDIS_URL=redis://redis:6379/0
{{- range .RequiredEnv}}
{{- if ne . "REDIS_URL"}}
      - {{.}}
{{- end}}
{{- end}}
{{- range .DevOptionalEnv}}
      # optional: passed through when set on the host; absent otherwise
      - {{.}}
{{- end}}
    ports:
      - "${UNMUTE_TELEPHONY_PORT:-7860}:7860"
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7860/readyz', timeout=2)"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 10s

  redis:
    # Valkey (BSD-3-Clause) is the coordination store: Redis images are
    # source-available (RSALv2/SSPLv1) since 7.4, not open source. The
    # service name and REDIS_URL keep the protocol's name.
    image: valkey/valkey:9.1.1-alpine
    command: ["valkey-server", "--appendonly", "yes"]
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 2s
      timeout: 3s
      retries: 30

volumes:
  redis_data:
