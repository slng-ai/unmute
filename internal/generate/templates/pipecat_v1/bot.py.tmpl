{{if .Inline}}{{$agent := index .Agents 0}}async def run_bot(transport: BaseTransport, runner_args: RunnerArguments, activate_on_start: bool = False) -> None:
    require_env()
    runner = WorkerRunner(handle_sigint=runner_args.handle_sigint)

    # Single agent, no handoffs: the LLM sits inline in the pipeline (no bus).
    # turn: local — on-device VAD (Silero); the turn binding is advisory.
    context = LLMContext({{if $agent.Tools}}tools=[{{range $i, $t := $agent.Tools}}{{if $i}}, {{end}}{{$t.MethodName}}{{end}}]{{end}})
    user_aggregator, assistant_aggregator = LLMContextAggregatorPair(
        context,
        user_params=LLMUserAggregatorParams(
            vad_analyzer=SileroVADAnalyzer(),
{{if .Interrupt}}{{if gt .Interrupt.MinWords 0}}            user_turn_strategies=UserTurnStrategies(
                start=[MinWordsUserTurnStartStrategy(min_words={{.Interrupt.MinWords}})],
                stop=[SpeechTimeoutUserTurnStopStrategy()],
            ),
{{end}}{{end}}{{if .Inactivity}}            user_idle_timeout={{.Inactivity.NudgeSecs}},
{{end}}        ),
    )
    pipeline = Pipeline(
        [
            transport.input(),
            build_stt(),
            user_aggregator,
            build_{{$agent.Name}}_llm(),
            build_{{$agent.Name}}_tts(),
            transport.output(),
            assistant_aggregator,
        ]
    )
    worker = PipelineWorker(
        pipeline,
        name=MAIN_NAME,
        params=PipelineParams(enable_metrics=True, enable_usage_metrics=True),
    )
{{if .Inactivity}}
    @user_aggregator.event_handler("on_user_turn_idle")
    async def on_user_turn_idle(aggregator):
        await aggregator.push_frame(
            LLMMessagesAppendFrame(
                [{"role": "developer", "content": "The caller has gone quiet. Politely check if they are still there."}],
                run_llm=True,
            )
        )
{{end}}
    async def start_session():
{{if .GreetingText}}        await worker.queue_frame(TTSSpeakFrame({{pyq .GreetingText}}))
{{end}}{{if gt .MaxDurationSecs 0}}        asyncio.create_task(_end_after(worker, {{.MaxDurationSecs}}))
{{end}}{{if and (not .GreetingText) (le .MaxDurationSecs 0)}}        pass
{{end}}
    @worker.event_handler("on_pipeline_started")
    async def on_pipeline_started(w, frame):
        # Console starts the session at pipeline start; web waits for client-ready.
        if activate_on_start:
            await start_session()

    if not activate_on_start:

        @worker.rtvi.event_handler("on_client_ready")
        async def on_client_ready(rtvi):
            await start_session()

        @transport.event_handler("on_client_disconnected")
        async def on_client_disconnected(transport, client):
            await runner.cancel()

    await runner.add_workers(worker)
    await runner.run()


{{else}}async def run_bot(transport: BaseTransport, runner_args: RunnerArguments, activate_on_start: bool = False) -> None:
    require_env()
{{if .Tracing}}
    tracing_enabled = setup_langfuse_tracing()
{{end}}
{{if .HasColdTransfer}}    global _TRANSPORT
    _TRANSPORT = transport
{{end}}{{if .HasWarmTransfer}}    # Per call, not per process: a warm transfer needs this call's own transport
    # and its own bridge, and every task of this call inherits the context var.
    caller_leg = _CallerLeg(transport, _AudioBridge(name="warm::caller"))
    _CALLER.set(caller_leg)
{{end}}    runner = WorkerRunner(handle_sigint=runner_args.handle_sigint)

    # turn: local — end-of-turn detection runs on-device (Silero VAD). No API
    # key, no network hop; the turn binding in targets.yaml is advisory.
    context = LLMContext()
    call_context = None
{{if .Telephony}}    call_context = telephony.normalized_context(runner_args)
{{end}}{{if .Variables}}    state = build_state(call_context)
{{else}}    state = None
{{end}}    agents = [{{range $i, $a := .Agents}}{{if $i}}, {{end}}{{$a.Class}}(state=state, context=context, call_context=call_context){{end}}]
    user_aggregator, assistant_aggregator = LLMContextAggregatorPair(
        context,
        user_params=LLMUserAggregatorParams(
            vad_analyzer=SileroVADAnalyzer(),
{{if .Interrupt}}{{if gt .Interrupt.MinWords 0}}            user_turn_strategies=UserTurnStrategies(
                start=[MinWordsUserTurnStartStrategy(min_words={{.Interrupt.MinWords}})],
                stop=[SpeechTimeoutUserTurnStopStrategy()],
            ),
{{end}}{{end}}{{if .Inactivity}}            user_idle_timeout={{.Inactivity.NudgeSecs}},
{{end}}        ),
    )
    bridge = BusBridgeProcessor(bus=runner.bus, worker_name=MAIN_NAME, name=f"{MAIN_NAME}::BusBridge")
    pipeline = Pipeline(
        [
            transport.input(),
{{if .HasWarmTransfer}}            caller_leg.bridge,
{{end}}            build_stt(),
            user_aggregator,
            bridge,
            transport.output(),
            assistant_aggregator,
        ]
    )
    main = PipelineWorker(
        pipeline,
        name=MAIN_NAME,
{{if .Tracing}}
        enable_tracing=tracing_enabled,
        additional_span_attributes={"langfuse.trace.name": TRACE_NAME},
{{end}}
        params=PipelineParams(enable_metrics=True, enable_usage_metrics=True),
    )
{{if .Tracing}}
    if tracing_enabled:
        enable_agent_tracing(main, agents)
{{end}}
{{if .Inactivity}}
    @user_aggregator.event_handler("on_user_turn_idle")
    async def on_user_turn_idle(aggregator):
        await aggregator.push_frame(
            LLMMessagesAppendFrame(
                [{"role": "developer", "content": "The caller has gone quiet. Politely check if they are still there."}],
                run_llm=True,
            )
        )
{{end}}{{if .HasColdTransfer}}
    @transport.event_handler("on_dialout_answered")
    async def on_dialout_answered(transport, data):
        # Cold transfer: the human answered, so the bot leaves the call.
        await main.queue_frame(EndFrame())
{{end}}
    pipeline_started = asyncio.Event()
    entry_started = False

    async def activate_entry():
        nonlocal entry_started
        if entry_started:
            return
        entry_started = True
        await main.activate_worker(
            {{pyq .EntryAgent}},
{{if .GreetingInstruction}}            args=LLMWorkerActivationArgs(
                messages=[{"role": "developer", "content": {{pyq .GreetingInstruction}}}],
                run_llm={{.GreetingRunLLM}},
            ),
{{else}}            args=LLMWorkerActivationArgs(run_llm={{.GreetingRunLLM}}),
{{end}}        )
{{if .GreetingText}}        await next(agent for agent in agents if agent.name == {{pyq .EntryAgent}}).queue_frame(
            TTSSpeakFrame({{.GreetingExpr}})
        )
{{end}}
{{if gt .MaxDurationSecs 0}}        asyncio.create_task(_end_after(main, {{.MaxDurationSecs}}))
{{end}}
    @main.event_handler("on_pipeline_started")
    async def on_pipeline_started(worker, frame):
        pipeline_started.set()
        if activate_on_start:
            # Local audio (console) has no client-connect event, so the
            # pipeline start is the session start. This fires after main's
            # StartFrame, so the B8/V14 activation gate is already satisfied.
            await activate_entry()

    if not activate_on_start:
{{if or (eq .Transport "daily-sip") (eq .Transport "carrier-websocket")}}
        @transport.event_handler("on_client_connected")
        async def on_client_connected(transport, client):
            # Telephony transports (carrier WebSocket, Daily SIP) have no RTVI
            # client-ready handshake: the carrier opens a raw media WebSocket and
            # the bot initiates once that connection is open and main's StartFrame
            # has traversed (Pipecat Twilio dial-in flow; SPEC V2).
            await pipeline_started.wait()
            await activate_entry()
{{else}}
        @main.rtvi.event_handler("on_client_ready")
        async def on_client_ready(rtvi):
            # Wait for both client media readiness and main's StartFrame before
            # activating tools or emitting the greeting (SPEC V2).
            await pipeline_started.wait()
            await activate_entry()
{{end}}

        @transport.event_handler("on_client_disconnected")
        async def on_client_disconnected(transport, client):
            await runner.cancel()

    await runner.add_workers(main, *agents)
{{if or .Tracing .HasWarmTransfer}}
    try:
        await runner.run()
    finally:
{{if .Tracing}}        if tracing_enabled:
            flush_tracing()
{{end}}{{if .HasWarmTransfer}}        caller_leg.release()
{{end}}{{else}}
    await runner.run()
{{end}}{{end}}


async def bot(runner_args: RunnerArguments) -> None:
{{if .Telephony}}    require_env()
    telephony.configure_pipecat_env()
{{end}}
    transport = await create_transport(runner_args, transport_params)
    await run_bot(transport, runner_args)


async def console_main() -> None:
    # Talk to the agent in the terminal over the local mic and speaker. The dev
    # runner has no local transport, so build one here. The import is lazy so a
    # default web run (`uv sync`) never needs pyaudio/portaudio (the `local`
    # extra installs them: `uv run --extra console bot.py console`).
    from pipecat.transports.local.audio import (
        LocalAudioTransport,
        LocalAudioTransportParams,
    )

    runner_args = RunnerArguments()
    runner_args.handle_sigint = True  # ctrl-c ends the session cleanly
    transport = LocalAudioTransport(
        LocalAudioTransportParams(audio_in_enabled=True, audio_out_enabled=True)
    )
    await run_bot(transport, runner_args, activate_on_start=True)


if __name__ == "__main__":
    import sys

    if "console" in sys.argv[1:]:
        asyncio.run(console_main())
    else:
        from pipecat.runner.run import main

        main()
