STREAM_URL = {{pyq .CloudWebsocket.StreamURL}}


def _service_host() -> str:
    """The string that names this agent to the platform.

    The same value your TwiML Bin carries: the compiled agent name plus your
    organization, which the compiler cannot know. Read here because the transfer
    below composes markup of its own, and that markup has to point the caller
    back at this agent if the transfer fails.
    """
    return "{{.Project}}." + os.environ[{{pyq .CloudWebsocket.OrganizationEnv}}]


def _transfer_twiml(destination: str, caller: str, ring_timeout: int) -> str:
    """The whole transfer, as one document your carrier will run in order.

    Announce, dial, then hand the caller back to a fresh agent. What follows the
    dial runs however the dial *ended*, not only when it failed: your carrier
    moves to the next verb when the destination hangs up exactly as it does when
    the destination was busy or never answered, and telling those apart needs a
    callback endpoint of yours, which is the cost this route exists to remove.
    So the line before the reconnect says only what is true either way and never
    claims nobody answered. Only the caller hanging up stops the document.
    """
    return (
        "<Response>"
        "<Say>Connecting you to a colleague now.</Say>"
        f'<Dial answerOnBridge="true" timeout="{ring_timeout}">{destination}</Dial>'
        "<Say>Putting you back to the assistant.</Say>"
        f'<Connect><Stream url="{STREAM_URL}">'
        f'<Parameter name="_pipecatCloudServiceHost" value="{_service_host()}"/>'
        f'<Parameter name="from_number" value="{caller}"/>'
        "</Stream></Connect>"
        "</Response>"
    )


async def _update_carrier_call(call_id: str, twiml: str) -> None:
    """Replace the live call's document at your carrier, by its own call id.

    This is the one request in the whole project made in the carrier's own words,
    and it is call control rather than provisioning: the call already exists. One
    HTTPS request, so no carrier SDK.
    """
    account_sid = os.environ[{{pyq .CloudWebsocket.AccountSIDEnv}}]
    url = f"https://api.twilio.com/2010-04-01/Accounts/{account_sid}/Calls/{call_id}.json"
    auth = aiohttp.BasicAuth(account_sid, os.environ[{{pyq .CloudWebsocket.AuthTokenEnv}}])
    async with aiohttp.ClientSession() as session:
        async with session.post(url, auth=auth, data={"Twiml": twiml}) as response:
            if response.status >= 400:
                raise RuntimeError(
                    f"carrier call update failed with {response.status}: {await response.text()}"
                )
{{end}}{{end}}{{if .DailyCarrier}}
# --- the carrier leg ---------------------------------------------------------
# The call arrives through your own carrier and joins this room over SIP. Only
# the forwarding request below speaks the carrier's own words; everything else
# here is a Daily room participant like any other.


def _carrier_sip(destination: str) -> str:
    """A destination dialled through your own trunk.

    Every outbound leg on this route leaves through your carrier, so an E.164
    number becomes a SIP URI at your trunk's termination address. Composed here,
    at call time, because a destination deferred to an environment variable has
    no value until now. A destination that is already a SIP URI is dialled as
    written.
    """
    if destination.startswith(("sip:", "sips:")):
        return destination
    return f"sip:{destination}@{os.environ[{{pyq .DailyCarrier.SIPAddressEnv}}]}"


# What a phone call adds to REQUIRED_ENV above, checked only on a phone call: a
# browser or console session on this package reads none of these and must not be
# asked for them. The check runs before the call is answered, so a missing value
# can never first show up as a failed transfer on a call somebody is paying for.
CALL_REQUIRED_ENV = [
{{range .DailyCarrier.CallEnv}}    {{pyq .}},
{{end}}]


def _carrier_session(runner_args: RunnerArguments) -> dict | None:
    """The call details the helper started this session with, validated.

    Returns None when this session is not a phone call at all: a browser or
    console session carries no call details and must behave exactly as it does
    on a package with no carrier. A body that claims to be a call but is missing
    a field fails here, by field name, rather than half-way through the call.
    """
    body = getattr(runner_args, "body", None)
    if not isinstance(body, dict) or not body.get("direction"):
        return None
    missing = [name for name in CALL_REQUIRED_ENV if not os.getenv(name)]
    if missing:
        raise RuntimeError(f"Missing environment for a phone call: {', '.join(missing)}")
    direction = body["direction"]
    if direction == "inbound":
        # The call id and nothing else. The room is the platform's, handed to this
        # session the ordinary way, and the room's SIP address arrives from Daily
        # when it goes live, so neither belongs in a body somebody else wrote.
        required = ("call_sid",)
    elif direction == "outbound":
        required = ("dialout",)
    else:
        raise RuntimeError(f"call body direction must be inbound or outbound, not {direction!r}")
    missing = [field for field in required if not body.get(field)]
    if missing:
        raise RuntimeError(f"call body is missing required fields: {', '.join(missing)}")
    return body
