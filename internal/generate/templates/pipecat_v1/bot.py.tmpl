class {{.Class}}({{if and $.Tracing $.NeedsFunctionCalls}}TracedLLMWorker{{else}}LLMWorker{{end}}):
    """Agent: {{.Name}}."""

    def __init__(self, state=None, context=None, call_context=None) -> None:
{{if $.Variables}}        self.state = state
{{end}}{{if $.HasFlows}}        self.context = context
{{end}}{{if $.Telephony}}        self.call_context = call_context
{{end}}
        llm = build_{{.Name}}_llm()
        super().__init__({{pyq .Name}}, llm=llm, pipeline=Pipeline([llm, build_{{.Name}}_tts()]), bridged=())
{{range .Transfers}}
    @tool(cancel_on_interruption=False)
    async def {{.MethodName}}(self, params: FunctionCallParams):
        """{{.When}}"""
{{if .Requires}}        missing = [name for name in [{{range $i, $r := .Requires}}{{if $i}}, {{end}}{{pyq $r}}{{end}}] if getattr(self.state, name, None) in (None, "")]
        if missing:
            await params.result_callback({"refused": f"Cannot transfer yet; still need: {', '.join(missing)}"})
            return
{{end}}        await self.activate_worker(
            {{pyq .To}},
            args=LLMWorkerActivationArgs(
                messages=[{"role": "developer", "content": {{pyq .Reason}}}],
                run_llm=True,
            ),
            deactivate_self=True,
            result_callback=params.result_callback,
        )
{{end}}{{range .Tools}}
    @tool{{if eq .Interruption "cancel"}}(cancel_on_interruption=True){{else if eq .Interruption "continue"}}(cancel_on_interruption=False){{end}}
    async def {{.MethodName}}(self, params: FunctionCallParams{{range .Args}}, {{.Name}}: str{{if not .Required}} = ""{{end}}{{end}}):
        """{{.Description}}"""
{{if .ColdDestination}}        await params.llm.push_frame(
            LLMMessagesAppendFrame(
                [{"role": "developer", "content": "Tell the caller you are connecting them now, then wait."}],
                run_llm=True,
            )
        )
{{if .CarrierTransfer}}        await telephony.cold_transfer(self.call_context["call_id"], {{pyq .ColdDestination}})
{{else}}        if _TRANSPORT is not None:
            await _TRANSPORT.sip_call_transfer({"toEndPoint": {{pyq .ColdDestination}}})
{{end}}
        await params.result_callback({"transferred": True})
{{else if .Local}}        result = tools.{{.Name}}.{{.Name}}({{range $i, $a := .Args}}{{if $i}}, {{end}}{{$a.Name}}={{$a.Name}}{{end}})
        if inspect.isawaitable(result):
            result = await result
        await params.result_callback(result)
{{else}}        async with httpx.AsyncClient() as client:
            response = await client.post(
                os.environ[{{pyq .URLEnv}}],
                json={ {{range $i, $a := .Args}}{{if $i}}, {{end}}{{pyq $a.Name}}: {{$a.Name}}{{end}} },
                timeout=30.0,
            )
            response.raise_for_status()
            await params.result_callback(response.json())
{{end}}{{if and .EndsCall (not .ColdDestination)}}        await params.llm.push_frame(EndFrame())
{{end}}{{end}}{{$agentPromptConst := .PromptConst}}{{range $d := .Delegates}}
    @tool
    async def {{$d.MethodName}}(self, params: FunctionCallParams):
        """{{$d.When}}"""
        self._{{$d.MethodName}}_results = {}
        # Snapshot the owner's context; the flow rewrites it per node and the
        # final step restores it (merge: results, N13).
        self._{{$d.MethodName}}_snapshot = ([dict(m) for m in self.context.get_messages()], self.context.tools)
        flow = FlowManager(
            llm=self.llm,
            context_aggregator=LLMContextAggregatorPair(self.context),
            worker=self,
        )
        # Resolve this tool call before the flow's first inference: Pipecat
        # ignores a @tool's return value, so an unresolved call hangs the turn
        # (V3/B1).
        await params.result_callback({"status": "running the {{if $d.Task}}{{$d.Task}} task{{else}}{{$d.Group}} flow{{end}}"})
        await flow.initialize(self._{{$d.MethodName}}_node_{{(index $d.StepTasks 0).Name}}())
{{range $t := $d.StepTasks}}
    def _{{$d.MethodName}}_node_{{$t.Name}}(self) -> NodeConfig:
        return NodeConfig(
            name={{pyq $t.Name}},
            role_message={{pyq $t.Prompt}},
            task_messages=[{"role": "developer", "content": "Begin this step."}],
            functions=[
{{range $t.Tools}}                FlowsFunctionSchema(
                    name={{pyq .Name}},
                    description={{pyq .Description}},
                    properties={{.InputProps}},
                    required={{.InputRequired}},
                    handler={{if and $.Tracing $.NeedsFunctionCalls}}self._trace_flow_tool({{pyq .Name}}, _flow_tool_{{.Name}}){{else}}_flow_tool_{{.Name}}{{end}},
                ),
{{end}}                FlowsFunctionSchema(
                    name={{pyq $t.FinishName}},
                    description="Record the result of this step and finish.",
                    properties={{$t.ResultProps}},
                    required={{$t.ResultRequired}},
                    handler={{if and $.Tracing $.NeedsFunctionCalls}}self._trace_flow_tool({{pyq $t.FinishName}}, self._{{$d.MethodName}}_finish_{{$t.Name}}){{else}}self._{{$d.MethodName}}_finish_{{$t.Name}}{{end}},
                ),
            ],
{{if $d.Isolated}}            context_strategy=ContextStrategyConfig(strategy=ContextStrategy.RESET),
{{end}}        )

    async def _{{$d.MethodName}}_finish_{{$t.Name}}(self, args, flow_manager):
        self._{{$d.MethodName}}_results[{{pyq $t.Name}}] = dict(args)
{{if $t.NextName}}        return {"status": "ok"}, self._{{$d.MethodName}}_node_{{$t.NextName}}()
{{else}}{{range $d.Assign}}        self.state.{{.Var}} = self._{{$d.MethodName}}_results[{{pyq $d.Task}}][{{pyq .Field}}]
{{end}}{{if eq $d.Then "end"}}        # then: end — hand to a terminal node whose end_conversation
        # post-action ends the call after the goodbye drains (V4/B2).
        return {"status": "ok"}, self._{{$d.MethodName}}_end_node()
{{else}}        # then: {{$d.Then}} — restore the owner's pre-flow context (messages and
        # tools); only the typed results cross back (merge: results, N13).
        messages, tools = self._{{$d.MethodName}}_snapshot
        await self.queue_frame(LLMUpdateSettingsFrame(
            delta=LLMSettings(system_instruction={{$agentPromptConst}}),
        ))
        await self.flush_pipeline()
{{if eq $d.Then "transfer"}}        self.context.set_messages(messages)
        self.context.set_tools(tools)
        await self.activate_worker(
            {{pyq $d.ThenTarget}},
            args=LLMWorkerActivationArgs(
                messages=[{"role": "developer", "content": "Task results: " + json.dumps(self._{{$d.MethodName}}_results) + " Continue with the caller in one short line."}],
                run_llm=True,
            ),
            deactivate_self=True,
        )
{{else}}        self.context.set_messages(messages + [{
            "role": "developer",
            "content": "Task results: " + json.dumps(self._{{$d.MethodName}}_results) + " Continue with the caller in one short line.",
        }])
        self.context.set_tools(tools)
{{end}}        return {"status": "ok"}, None
{{end}}{{end}}{{end}}{{if eq $d.Then "end"}}
    def _{{$d.MethodName}}_end_node(self) -> NodeConfig:
        # Terminal node: speak a brief closing line, then end_conversation ends
        # the call once its TTS drains (Flows built-in action; V4/B2).
        return NodeConfig(
            name="end",
            task_messages=[{"role": "developer", "content": "Thank the caller and say goodbye."}],
            functions=[],
            post_actions=[{"type": "end_conversation"}],
        )
{{end}}{{end}}
