def _mcp_params(url: str, headers: dict[str, str] | None = None):
    """Pick the transport for a source that did not state one.

    ponytail: this mirrors livekit-agents' own auto-detect instead of adding a
    knob, so one server URL behaves the same on both targets: a path ending in
    /mcp is streamable HTTP, anything else is SSE. Write `transport:` in the
    tool file to decide it yourself.
    """
    params_cls = StreamableHttpParameters if url.rstrip("/").endswith("/mcp") else SseServerParameters
    return params_cls(url=url, headers=headers, timeout={{mcpTimeout}})
