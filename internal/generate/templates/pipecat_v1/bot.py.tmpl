class _HandoffWorker({{if and .Tracing .NeedsFunctionCalls}}TracedLLMWorker{{else}}LLMWorker{{end}}):
    """Finish one exact source-side cue before activating the next worker."""

    async def _announce_handoff(self, announcement: str) -> None:
        self._handoff_started = False
        self._handoff_finished = asyncio.Event()
        await PipelineWorker.queue_frame(self, TTSSpeakFrame(announcement))
        try:
            await asyncio.wait_for(self._handoff_finished.wait(), timeout=30.0)
        finally:
            self._handoff_finished = None

    async def queue_frame(self, frame, *args, **kwargs) -> None:
        finished = getattr(self, "_handoff_finished", None)
        if finished:
            if isinstance(frame, BotStartedSpeakingFrame):
                self._handoff_started = True
            elif self._handoff_started and isinstance(frame, BotStoppedSpeakingFrame):
                finished.set()
        await super().queue_frame(frame, *args, **kwargs)

    async def process_deferred_tool_frames(self, frames):
        if not self.active:
            return []
        return await super().process_deferred_tool_frames(frames)
