def require_env() -> None:
    missing = [name for name in REQUIRED_ENV if not os.getenv(name)]
    if missing:
        raise RuntimeError(f"Missing required environment variables: {', '.join(missing)}")


{{if .Variables}}
@dataclass
class State:
    """Typed call variables (SCHEMA 4.4), shared across agents."""
{{range .Variables}}    {{.Name}}: {{.PyType}} = {{.Default}}
{{end}}

def build_state(call_context: dict | None = None) -> State:
    state = State()
{{if .Telephony}}    context = call_context or {}
    missing = []
{{range .Telephony.SystemSources}}    value = context.get({{pyq .Source}})
    if value in (None, ""):
        missing.append({{pyq .Source}})
    else:
        setattr(state, {{pyq .Variable}}, value)
{{end}}    call_start = context.get("call_start", {})
{{range .Telephony.CallStart}}    if {{pyq .Name}} in call_start:
        setattr(state, {{pyq .Name}}, call_start[{{pyq .Name}}])
{{if .Required}}    else:
        missing.append({{pyq .Name}})
{{end}}{{end}}    if missing:
        raise RuntimeError(f"Missing call context fields: {', '.join(missing)}")
{{end}}    return state
{{end}}{{if gt .MaxDurationSecs 0}}
async def _end_after(worker: PipelineWorker, timeout_secs: float) -> None:
    await asyncio.sleep(timeout_secs)
    await worker.queue_frame(EndFrame())
