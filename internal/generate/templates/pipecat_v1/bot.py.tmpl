def require_env() -> None:
    missing = [name for name in REQUIRED_ENV if not os.getenv(name)]
    if missing:
        raise RuntimeError(f"Missing required environment variables: {', '.join(missing)}")

{{if .DailyCarrier}}
# --- the carrier leg ---------------------------------------------------------
# The call arrives through your own carrier and joins this room over SIP. Only
# the forwarding request below speaks the carrier's own words; everything else
# here is a Daily room participant like any other.


def _carrier_sip(destination: str) -> str:
    """A destination dialled through your own trunk.

    Every outbound leg on this route leaves through your carrier, so an E.164
    number becomes a SIP URI at your trunk's termination address. Composed here,
    at call time, because a destination deferred to an environment variable has
    no value until now. A destination that is already a SIP URI is dialled as
    written.
    """
    if destination.startswith(("sip:", "sips:")):
        return destination
    return f"sip:{destination}@{os.environ[{{pyq .DailyCarrier.SIPAddressEnv}}]}"


# What a phone call adds to REQUIRED_ENV above, checked only on a phone call: a
# browser or console session on this package reads none of these and must not be
# asked for them. The check runs before the call is answered, so a missing value
# can never first show up as a failed transfer on a call somebody is paying for.
CALL_REQUIRED_ENV = [
{{range .DailyCarrier.CallEnv}}    {{pyq .}},
{{end}}]


def _carrier_session(runner_args: RunnerArguments) -> dict | None:
    """The call details the helper started this session with, validated.

    Returns None when this session is not a phone call at all: a browser or
    console session carries no call details and must behave exactly as it does
    on a package with no carrier. A body that claims to be a call but is missing
    a field fails here, by field name, rather than half-way through the call.
    """
    body = getattr(runner_args, "body", None)
    if not isinstance(body, dict) or not body.get("direction"):
        return None
    missing = [name for name in CALL_REQUIRED_ENV if not os.getenv(name)]
    if missing:
        raise RuntimeError(f"Missing environment for a phone call: {', '.join(missing)}")
    direction = body["direction"]
    if direction == "inbound":
        # room_url and token are required on an incoming call because the helper
        # created that room, not the platform, so this is the only place the room
        # to join is named.
        required = ("room_url", "token", "call_sid", "sip_uri")
    elif direction == "outbound":
        required = ("dialout",)
    else:
        raise RuntimeError(f"call body direction must be inbound or outbound, not {direction!r}")
    missing = [field for field in required if not body.get(field)]
    if missing:
        raise RuntimeError(f"call body is missing required fields: {', '.join(missing)}")
    return body
{{if .DailyCarrier.HasInbound}}
# The room's SIP leg can signal ready more than once, so the forward is claimed
# once and never repeated. Module scope is call scope here: one process serves
# one call.
_CALL_FORWARDED = False

{{if eq .DailyCarrier.Carrier "twilio"}}
async def _forward_carrier_call(call_sid: str, sip_uri: str) -> None:
    """Point the live call at this room's SIP address.

    This is the one request in the whole project made in the carrier's own words,
    and it is call control rather than provisioning: the call already exists and
    the carrier just handed it to us. One HTTPS request, so no carrier SDK.
    """
    account_sid = os.environ[{{pyq .DailyCarrier.AccountSIDEnv}}]
    url = f"https://api.twilio.com/2010-04-01/Accounts/{account_sid}/Calls/{call_sid}.json"
    twiml = f"<Response><Dial><Sip>{sip_uri}</Sip></Dial></Response>"
    auth = aiohttp.BasicAuth(account_sid, os.environ[{{pyq .DailyCarrier.AuthTokenEnv}}])
    async with aiohttp.ClientSession() as session:
        async with session.post(url, auth=auth, data={"Twiml": twiml}) as response:
            if response.status >= 400:
                raise RuntimeError(
                    f"carrier call update failed with {response.status}: {await response.text()}"
                )
{{end}}{{end}}{{end}}
