class {{.Class}}({{if and $.Tracing $.NeedsFunctionCalls}}TracedLLMWorker{{else}}LLMWorker{{end}}):
    """Agent: {{.Name}}."""

    def __init__(self, state=None, context=None, call_context=None) -> None:
{{if $.Variables}}        self.state = state
{{end}}{{if $.HasFlows}}        self.context = context
{{end}}{{if $.Telephony}}        self.call_context = call_context
{{end}}
        llm = build_{{.Name}}_llm({{if $.Variables}}state{{end}})
        super().__init__({{pyq .Name}}, llm=llm, pipeline=Pipeline([llm, build_{{.Name}}_tts()]), bridged=())
{{if .MCPSources}}        # MCP tool sources. The clients are built here and connected in
        # start_mcp() before this worker is ever activated, because the server
        # names its own tools and build_tools() has to be able to list them.
        self._mcp_clients = [
{{range .MCPSources}}            {{template "mcp_client" .}},
{{end}}        ]
        self._mcp_tools: list = []

    async def start_mcp(self) -> None:
        """Connect every source and register its tools on this agent's LLM."""
        for client in self._mcp_clients:
            await client.start()
            self._mcp_tools.extend((await client.register_tools(self.llm)).standard_tools)

    async def close_mcp(self) -> None:
        for client in self._mcp_clients:
