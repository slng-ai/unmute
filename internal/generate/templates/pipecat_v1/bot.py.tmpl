class {{.Class}}(LLMWorker):
    """Agent: {{.Name}}."""

    def __init__(self) -> None:
        llm = build_{{.Name}}_llm()
        super().__init__({{pyq .Name}}, llm=llm, pipeline=Pipeline([llm, build_{{.Name}}_tts()]), bridged=())
{{range .Transfers}}
    @tool(cancel_on_interruption=False)
    async def {{.MethodName}}(self, params: FunctionCallParams):
        """{{.When}}"""
{{if .Requires}}        missing = [name for name in [{{range $i, $r := .Requires}}{{if $i}}, {{end}}{{pyq $r}}{{end}}] if getattr(STATE, name, None) in (None, "")]
        if missing:
            await params.result_callback({"refused": f"Cannot transfer yet; still need: {', '.join(missing)}"})
            return
{{end}}        await self.activate_worker(
            {{pyq .To}},
            args=LLMWorkerActivationArgs(
                messages=[{"role": "developer", "content": {{pyq .Reason}}}],
                run_llm=True,
            ),
            deactivate_self=True,
            result_callback=params.result_callback,
        )
{{end}}{{range .Tools}}
    @tool({{if eq .Interruption "cancel"}}cancel_on_interruption=True{{else if eq .Interruption "continue"}}cancel_on_interruption=False{{end}})
    async def {{.MethodName}}(self, params: FunctionCallParams{{range .Args}}, {{.Name}}: str{{if not .Required}} = ""{{end}}{{end}}):
        """{{.Description}}"""
{{if .ColdDestination}}        await params.llm.push_frame(
            LLMMessagesAppendFrame(
                [{"role": "developer", "content": "Tell the caller you are connecting them now, then wait."}],
                run_llm=True,
            )
        )
        if _TRANSPORT is not None:
            await _TRANSPORT.sip_call_transfer({"toEndPoint": {{pyq .ColdDestination}}})
        await params.result_callback({"transferred": True})
{{else}}        async with httpx.AsyncClient() as client:
            response = await client.post(
                os.environ[{{pyq .URLEnv}}],
                json={ {{range $i, $a := .Args}}{{if $i}}, {{end}}{{pyq $a.Name}}: {{$a.Name}}{{end}} },
                timeout=30.0,
            )
            response.raise_for_status()
            await params.result_callback(response.json())
{{if .EndsCall}}        await params.llm.push_frame(EndFrame())
{{end}}{{end}}{{end}}{{range $d := .Delegates}}
    @tool()
    async def {{$d.MethodName}}(self, params: FunctionCallParams):
        """{{$d.When}}"""
        self._{{$d.MethodName}}_results = {}
        # Snapshot the owner's context; the flow rewrites it per node and the
        # final step restores it (merge: results, N13).
        self._{{$d.MethodName}}_snapshot = ([dict(m) for m in _CONTEXT.get_messages()], _CONTEXT.tools)
        flow = FlowManager(
            llm=self.llm,
            context_aggregator=LLMContextAggregatorPair(_CONTEXT),
            worker=self,
        )
        await flow.initialize(self._{{$d.MethodName}}_node_{{(index $d.StepTasks 0).Name}}())
        return {"status": "running the {{if $d.Task}}{{$d.Task}} task{{else}}{{$d.Group}} flow{{end}}"}
{{range $t := $d.StepTasks}}
    def _{{$d.MethodName}}_node_{{$t.Name}}(self) -> NodeConfig:
        return NodeConfig(
            name={{pyq $t.Name}},
            task_messages=[{"role": "system", "content": {{pyq $t.Prompt}}}],
            functions=[
{{range $t.Tools}}                FlowsFunctionSchema(
                    name={{pyq .Name}},
                    description={{pyq .Description}},
                    properties={{.InputProps}},
                    required={{.InputRequired}},
                    handler=_flow_tool_{{.Name}},
                ),
{{end}}                FlowsFunctionSchema(
                    name={{pyq $t.FinishName}},
                    description="Record the result of this step and finish.",
                    properties={{$t.ResultProps}},
                    required={{$t.ResultRequired}},
                    handler=self._{{$d.MethodName}}_finish_{{$t.Name}},
                ),
            ],
{{if $d.Isolated}}            context_strategy=ContextStrategyConfig(strategy=ContextStrategy.RESET),
{{end}}            respond_immediately=True,
        )

    async def _{{$d.MethodName}}_finish_{{$t.Name}}(self, args, flow_manager):
        self._{{$d.MethodName}}_results[{{pyq $t.Name}}] = dict(args)
{{if $t.NextName}}        return {"status": "ok"}, self._{{$d.MethodName}}_node_{{$t.NextName}}()
{{else}}{{range $d.Assign}}        STATE.{{.Var}} = self._{{$d.MethodName}}_results[{{pyq $d.Task}}][{{pyq .Field}}]
{{end}}{{if eq $d.Then "end"}}        await self.queue_frame(EndFrame())
        return {"status": "ok"}, None
{{else}}        # then: {{$d.Then}} — restore the owner's pre-flow context (messages and
        # tools); only the typed results cross back (merge: results, N13).
        messages, tools = self._{{$d.MethodName}}_snapshot
{{if eq $d.Then "transfer"}}        _CONTEXT.set_messages(messages)
        _CONTEXT.set_tools(tools)
        await self.activate_worker(
            {{pyq $d.ThenTarget}},
            args=LLMWorkerActivationArgs(
                messages=[{"role": "developer", "content": "Task results: " + json.dumps(self._{{$d.MethodName}}_results) + " Continue with the caller in one short line."}],
                run_llm=True,
            ),
            deactivate_self=True,
        )
{{else}}        _CONTEXT.set_messages(messages + [{
            "role": "developer",
            "content": "Task results: " + json.dumps(self._{{$d.MethodName}}_results) + " Continue with the caller in one short line.",
        }])
        _CONTEXT.set_tools(tools)
{{end}}        return {"status": "ok"}, None
{{end}}{{end}}{{end}}{{end}}
