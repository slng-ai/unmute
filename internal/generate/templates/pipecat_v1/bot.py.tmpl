class {{.Class}}(BaseWorker):
    """Task worker: {{.Name}} (delegate-and-return, structured result)."""

    @job(name={{pyq .Name}})
    async def run(self, message: BusJobRequestMessage):
        client = AsyncOpenAI(api_key=os.environ[{{pyq .LLM.APIKeyEnv}}]{{if .LLM.BaseURL}}, base_url=os.environ[{{pyq .LLM.BaseURL}}]{{end}})
        completion = await client.chat.completions.create(
            model={{pyq .LLM.Model}},
            messages=[
                {"role": "system", "content": {{pyq .Prompt}}},
                {"role": "user", "content": json.dumps(message.payload or {})},
            ],
            response_format={{.ResultSchema}},
        )
        result = json.loads(completion.choices[0].message.content)
        await self.send_job_response(message.job_id, result)
