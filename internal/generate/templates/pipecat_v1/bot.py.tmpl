{{if .DailyCarrier}}        if _TRANSFER_RESULT is None:
            # No transfer is under way, so this is the outbound call this session
            # exists for and the recipient has just picked up. Ending here would
            # hang up on the person we called.
            return
{{end}}        await main.queue_frame(EndFrame())
{{end}}{{if .DailyCarrier}}{{if .DailyCarrier.HasInbound}}
    if carrier_call and carrier_call["direction"] == "inbound":

        @transport.event_handler("on_dialin_ready")
        async def on_dialin_ready(transport, sip_endpoint):
            # Daily says which address the room is reachable on and that it is
            # live, both in this one event. Waiting for it is the point: the
            # address exists from the moment the room does, but a call sent there
            # before the leg is up is a call that goes nowhere.
            #
            # The guard is claimed before the request goes out, not after: a
            # second ready signal arriving while the first forward is still in
            # flight must not forward the same call twice.
            global _CALL_FORWARDED
            if _CALL_FORWARDED:
                return
            _CALL_FORWARDED = True
            try:
                await _forward_carrier_call(carrier_call["call_sid"], sip_endpoint)
            except Exception as exc:
                # Named, not swallowed. The caller is still on the helper's hold
                # audio, and this line is what says why they never got further.
                logger.error("forwarding carrier call {} failed: {}", carrier_call["call_sid"], exc)
                return
            logger.info("carrier call {} forwarded into the room", carrier_call["call_sid"])
{{end}}{{if .DailyCarrier.HasOutbound}}
    if carrier_call and carrier_call["direction"] == "outbound":

        @transport.event_handler("on_joined")
        async def on_joined(transport, data):
            # Dialled through your own trunk: a SIP URI, and the provider Daily
            # documents for a carrier interconnect leg.
            await transport.start_dialout(
                {
                    "sipUri": carrier_call["dialout"]["sip_uri"],
                    "displayName": MAIN_NAME,
                    "provider": "daily",
                }
            )

        @transport.event_handler("on_dialout_connected")
        async def on_dialout_connected(transport, data):
            logger.info("dial-out connected: {}", data)

        @transport.event_handler("on_dialout_stopped")
        async def on_dialout_stopped(transport, data):
            # A leg the carrier rejected ends here with its cause named, rather
            # than as a call that simply never rang.
            logger.warning("dial-out stopped: {}", data)
            await runner.cancel()

        @transport.event_handler("on_dialout_warning")
        async def on_dialout_warning(transport, data):
            logger.warning("dial-out warning: {}", data)
{{end}}{{end}}
    pipeline_started = asyncio.Event()
    entry_started = False

    async def activate_entry():
        nonlocal entry_started
        if entry_started:
            return
        entry_started = True
        await main.activate_worker(
            {{pyq .EntryAgent}},
{{if .GreetingInstruction}}            args=LLMWorkerActivationArgs(
                messages=[{"role": "developer", "content": {{pyq .GreetingInstruction}}}],
                run_llm={{.GreetingRunLLM}},
            ),
{{else}}            args=LLMWorkerActivationArgs(run_llm={{.GreetingRunLLM}}),
{{end}}        )
{{if .GreetingText}}        await next(agent for agent in agents if agent.name == {{pyq .EntryAgent}}).queue_frame(
            TTSSpeakFrame({{.GreetingExpr}})
        )
{{end}}
{{if gt .MaxDurationSecs 0}}        asyncio.create_task(_end_after(main, {{.MaxDurationSecs}}))
{{end}}
    @main.event_handler("on_pipeline_started")
    async def on_pipeline_started(worker, frame):
        pipeline_started.set()
        if activate_on_start:
            # Local audio (console) has no client-connect event, so the
            # pipeline start is the session start. This fires after main's
            # StartFrame, so the B8/V14 activation gate is already satisfied.
            await activate_entry()

    if not activate_on_start:
{{if or (eq .Transport "daily-sip") (eq .Transport "carrier-websocket") (eq .Transport "cloud-websocket")}}
        @transport.event_handler("on_client_connected")
        async def on_client_connected(transport, client):
            # Telephony transports (carrier WebSocket, Daily SIP) have no RTVI
            # client-ready handshake: the carrier opens a raw media WebSocket and
            # the bot initiates once that connection is open and main's StartFrame
            # has traversed (Pipecat Twilio dial-in flow; SPEC V2).
{{if .CloudWebsocket}}            #
            # This is also all an outbound call needs. Your carrier opens the stream
            # when the person answers, so the greeting below meets a human rather
            # than ringback, and there is no ringing state to handle.
{{end}}            await pipeline_started.wait()
            await activate_entry()
{{else}}
        @main.rtvi.event_handler("on_client_ready")
        async def on_client_ready(rtvi):
            # Wait for both client media readiness and main's StartFrame before
            # activating tools or emitting the greeting (SPEC V2).
            await pipeline_started.wait()
            await activate_entry()
{{end}}

        @transport.event_handler("on_client_disconnected")
        async def on_client_disconnected(transport, client):
            await runner.cancel()

    await runner.add_workers(main, *agents)
{{if or .Tracing .NeedsMCP}}
    try:
        await runner.run()
    finally:
{{if .Tracing}}        if tracing_enabled:
            flush_tracing()
{{end}}{{range $i, $a := .Agents}}{{if $a.MCPSources}}        await agents[{{$i}}].close_mcp()
{{end}}{{end}}{{else}}
    await runner.run()
{{end}}
{{end}}

async def bot(runner_args: RunnerArguments) -> None:
{{if .Telephony}}    require_env()
    telephony.configure_pipecat_env()
{{end}}
{{if and .CloudWebsocket (not .CloudWebsocket.AccountSIDEnv)}}    # A websocket session is a phone call on this route, and this package holds no
    # carrier credentials, so it builds that transport itself (see
    # _carrier_transport). Everything else, browser and console, is the framework's.
    if getattr(runner_args, "websocket", None) is not None:
        transport = await _carrier_transport(runner_args)
    else:
        transport = await create_transport(runner_args, transport_params)
{{else}}    transport = await create_transport(runner_args, transport_params)
{{end}}    await run_bot(transport, runner_args)


async def console_main() -> None:
    # Talk to the agent in the terminal over the local mic and speaker. The dev
    # runner has no local transport, so build one here. The import is lazy so a
    # default web run (`uv sync`) never needs pyaudio/portaudio (the `local`
    # extra installs them: `uv run --extra console bot.py console`).
    from pipecat.transports.local.audio import (
        LocalAudioTransport,
        LocalAudioTransportParams,
    )

    runner_args = RunnerArguments()
    runner_args.handle_sigint = True  # ctrl-c ends the session cleanly
    transport = LocalAudioTransport(
        LocalAudioTransportParams(audio_in_enabled=True, audio_out_enabled=True)
    )
    await run_bot(transport, runner_args, activate_on_start=True)


if __name__ == "__main__":
    import sys

    if "console" in sys.argv[1:]:
        asyncio.run(console_main())
    else:
        from pipecat.runner.run import main

        main()
