async def _close_mcp(awaitables, *, suppress: bool = False) -> None:
    failures = []
    for awaitable in awaitables:
        try:
            await awaitable
        except BaseException as failure:
            failures.append(failure)
    if suppress:
        for failure in failures:
            logger.error(
                "MCP cleanup failed while preserving the primary error ({})",
                type(failure).__name__,
            )
        return
    for failure in failures[1:]:
        logger.error(
            "Additional MCP cleanup failure ({})",
            type(failure).__name__,
        )
    if failures:
        raise failures[0]


async def _register_mcp_tools(clients, llm, reserved_names{{if .Tracing}}, trace_handler{{end}}):
    discovered = []
    names = set(reserved_names)
    for client in clients:
        await client.start()
        tools = await client.get_tools_schema()
        for schema in tools.standard_tools:
            if schema.name in names:
                raise RuntimeError(
                    f"MCP tool name collision for {schema.name!r}; names must be unique "
                    "across generated tools and MCP sources on one agent"
                )
            names.add(schema.name)
        discovered.append((client, tools))

    registered = []
    for client, tools in discovered:
        await client.register_tools_schema(tools, llm)
{{if .Tracing}}        for schema in tools.standard_tools:
            # ponytail: Pipecat 1.7.0 exposes no public MCP handler hook.
            # Remove this private seam when MCPClient adds one.
            llm.register_function(
                schema.name,
                trace_handler(client._tool_wrapper),
            )
{{end}}        registered.extend(tools.standard_tools)
    return registered
