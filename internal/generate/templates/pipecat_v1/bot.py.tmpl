async def _flow_tool_{{.Name}}(args, flow_manager{{if .NeedsState}}, state=None{{end}}):
    """{{.Description}}"""
{{if .Needed}}    refusal = _refusal({{pyq .Name}}, state, {{.NeededLiteral}})
    if refusal:
        return {"refused": refusal}
{{end}}{{if .Local}}    result = tools.{{.Name}}.{{.Name}}(**dict(args){{range .Inject}}, {{.Key}}={{.Expr}}{{end}})
    if inspect.isawaitable(result):
        result = await result
    return result
{{else}}    async with httpx.AsyncClient() as client:
        response = await client.post({{.URLExpr}}, {{if .Auth}}headers={{.Auth.Expr}}, {{end}}json={**dict(args){{range .Inject}}, {{pyq .Key}}: {{.Expr}}{{end}}}, timeout=30.0)
        response.raise_for_status()
        return response.json()
{{end}}{{end}}
