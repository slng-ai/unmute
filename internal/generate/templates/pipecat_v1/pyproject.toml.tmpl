[project]
name = {{pyq .Project}}
version = "0.1.0"
description = "Generated Pipecat voice agent (compiled by unmute)."
requires-python = ">=3.11"
dependencies = [
    "pipecat-ai[{{join .Extras ","}}]=={{.Version}}",
{{range .Deps}}    "{{.}}",
{{end}}    "python-dotenv>=1.0",
{{if .Tracing}}
    "opentelemetry-exporter-otlp-proto-http>=1.33,<2",
{{end}}
{{if .NeedsHTTPX}}    "httpx>=0.27",
{{end}}{{if .Telephony}}    "redis>=5,<6",
{{end}}]

[dependency-groups]
dev = ["ty"]

# Console mode (`unmute dev --console`) talks over the local mic/speaker via
# pipecat's LocalAudioTransport, which needs pyaudio (portaudio at build time —
# `brew install portaudio` on macOS). Kept out of the default deps so a plain
# web run never depends on a system audio library.
[project.optional-dependencies]
console = ["pipecat-ai[local]=={{.Version}}"]

[tool.uv]
package = false
