"""Generated LiveKit room webhook for {{.Project}}.

This route hosts its own trunk: the carrier's call terminates at a LiveKit SIP
service you run, which puts the caller in a room of its own. Nothing dispatches
this agent into that room. A dispatch rule can only dispatch a LiveKit *agent
worker*, and this is a Pipecat bot, so the server announces the room here
instead and this starts a session for it.

That announcement is not a convenience, it is the whole inbound path. An
incoming call is answered only once something in the room publishes audio the
SIP service can subscribe to: livekit/sip pkg/sip/inbound.go joins the room at
status "ringing", publishes the caller's track, then waits in waitSubscribe
while it keeps sending 180 Ringing. Joining the room is therefore what answers
the call, and the budget for doing it is the ring timeout: three minutes by
default (pkg/sip/participant.go), less if your carrier's trunk says so. Measured
2026-08-21 with nothing joining: the call rang for exactly three minutes and was
then cut off.

Two endpoints and no more. There is no carrier webhook of ours to answer and no
media socket of ours to serve, because the audio goes over WebRTC between the
SIP service and this agent and never passes through this process.

Generated by unmute. Do not edit by hand: change the spec and recompile.
"""

from __future__ import annotations

import asyncio
import os
from contextlib import asynccontextmanager

from fastapi import FastAPI, HTTPException, Request, Response
from livekit.api import TokenVerifier, WebhookReceiver
from loguru import logger
from pipecat.runner.types import RunnerArguments

import bot

# The room-name prefix the inbound dispatch rule gives every call. A room with
# this prefix exists only because a trunk accepted a call and that rule matched
# it, which is what tells a call apart from any other room on the same server:
# a browser session or somebody else's agent also announces itself here.
CALL_ROOM_PREFIX = {{pyq .SIP.RoomPrefix}}

# What this process itself cannot work without: the platform it verifies
# announcements from and joins rooms on. Deliberately not the route's whole
# required set. The trunk's own values are read on the dial-out path and the
# model keys are read by the session, so failing readiness on them would report
# this webhook as broken over values it never touches.
REQUIRED_ENV = [
    {{pyq .SIP.ServerURLEnv}},
    {{pyq .SIP.APIKeyEnv}},
    {{pyq .SIP.APISecretEnv}},
]

# One session per room and no more. Webhook delivery is at-least-once by design
# and the server retries, so the same room_started arrives more than once on a
# slow start; a second session would join the same call and both would talk.
#
# ponytail: a dict in this process, which is the truth for one container. Run
# more than one replica behind the same server and this has to become a claim in
# the coordination store, because each replica would otherwise answer every call.
_SESSIONS: dict[str, asyncio.Task] = {}


@asynccontextmanager
async def lifespan(_: FastAPI):
    """End the sessions on the way out, rather than abandoning them."""
    yield
    # A session outlives the request that started it, so the server's own
    # shutdown neither waits for one nor ends it, and the process exits
    # complaining about a task destroyed while pending.
    #
    # Cancelled, not waited for. Waiting was tried first and it is the wrong
    # trade: measured 2026-08-21, a session whose caller had already hung up held
    # the shutdown open for five and a half minutes, so what should have been a
    # clean ctrl-c became a hang. A restart therefore ends calls in progress.
    #
    # ponytail: if a restart must not cut a call off, the thing to build is a
    # replica that stops taking new calls and is retired when its last one ends,
    # not a longer wait here.
    running = tuple(_SESSIONS.values())
    for task in running:
        task.cancel()
    if running:
        logger.info("ending {} call(s) in progress", len(running))
        await asyncio.gather(*running, return_exceptions=True)


app = FastAPI(lifespan=lifespan)


@app.get("/healthz")
async def health() -> dict[str, str]:
    """Alive."""
    return {"status": "ok"}


@app.get("/readyz")
async def readiness() -> dict[str, object]:
    """Able to take a call, and which value is missing when it is not."""
    missing = [name for name in REQUIRED_ENV if not os.getenv(name)]
    if missing:
        raise HTTPException(status_code=503, detail={"missing_environment": missing})
    return {"ready": True}


@app.post({{pyq .SIP.WebhookPath}})
async def room_event(request: Request) -> Response:
    """One room announcement from the LiveKit Server this agent joins rooms on."""
    # The raw bytes, never parsed JSON. The token carries a sha256 of exactly
    # these bytes, so anything re-serialised verifies against nothing. The server
    # sends content-type application/webhook+json for that reason: the signature
    # is meant to be checked before the payload is parsed at all.
    body = await request.body()
    # The bare token, with no "Bearer " in front of it: the server sets
    # Authorization to the JWT itself (livekit/protocol webhook/url_notifier.go).
    token = request.headers.get("Authorization", "")
    verifier = TokenVerifier(os.environ[{{pyq .SIP.APIKeyEnv}}], os.environ[{{pyq .SIP.APISecretEnv}}])
    try:
        event = WebhookReceiver(verifier).receive(body.decode(), token)
    except Exception as exc:
        # Named but not quoted. An unverified body is not something to write into
        # a log, because anything at all could have sent it.
        logger.warning("rejected an unverified room announcement: {}", exc)
        raise HTTPException(status_code=401, detail="unverified room announcement") from exc

    # room_started, not participant_joined: it is the earliest point at which the
    # room has a name, and the name is the whole of what a session needs. The
    # caller's own identity lives on the participant and this route reads none of
    # it (see bot.py, which takes the caller from the room it joins).
    if event.event != "room_started":
        return Response(status_code=204)
    room = event.room.name
    if not room.startswith(CALL_ROOM_PREFIX):
        return Response(status_code=204)
    if room in _SESSIONS:
        logger.debug("room {} already has a session; this is a redelivery", room)
        return Response(status_code=204)
    logger.info("call arrived in room {}", room)
    _SESSIONS[room] = asyncio.create_task(_session(room))
    return Response(status_code=204)


async def _session(room: str) -> None:
    """Run one call.

    The room name is all that is handed over, because the caller is already in
    that room and joining it is what answers their call.
    """
    try:
        await bot.bot(RunnerArguments(body={"room": room}, session_id=room))
    except asyncio.CancelledError:
        # Not an error, and not the same thing as one: the session was ended
        # from outside, either by a shutdown or by the run itself. Said out
        # loud because a cancellation and a crash look identical from the
        # caller's end, and they are two different things to go looking for.
        logger.info("the session in room {} was cancelled", room)
        raise
    except Exception:
        # A session that dies has to say so here. Nothing else is watching this
        # task, and the symptom otherwise is a call that connects and stays
        # silent.
        logger.exception("the session in room {} ended badly", room)
    finally:
        _SESSIONS.pop(room, None)
