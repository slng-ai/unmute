COVAL_TRACES_ENDPOINT = "https://api.coval.dev/v1/traces"

# Set by Coval on the OTLP request, not on the call. Different name on purpose.
SIMULATION_EXPORT_HEADER = "X-Simulation-Id"

# The other way a trace can be correlated. A call no simulation placed is
# submitted as a Coval conversation once it ends, and its spans go out against
# the conversation ID that submit returns. Coval accepts exactly one of the two
# headers, never both.
COVAL_CONVERSATIONS_ENDPOINT = "https://api.coval.dev/v1/conversations:submit"
CONVERSATION_EXPORT_HEADER = "X-Conversation-Id"

# A call nobody ever claims must not grow the process without limit.
MAX_PREACTIVATION_SPANS = 1024

# Coval's ingest is append-only and does not de-duplicate, so a retry has to
# resend only the batch that failed. The docs require this exact timeout.
EXPORT_TIMEOUT_SECONDS = 30

# Registering the call is the last thing that happens, inside the host's
# shutdown window, and LiveKit force-kills a job process ten seconds after
# shutdown begins. So this is deliberately not EXPORT_TIMEOUT_SECONDS: sharing
# that budget would let a merely slow Coval cost the whole trace instead of a
# few seconds, and being cut short is logged rather than silent.
SUBMIT_TIMEOUT_SECONDS = 5

# Which call a span belongs to. Pipecat Cloud reuses one process for many calls,
# so this is what stops a span that ended late riding out under the next call's
# Coval ID. A span without it was never stamped, which is every span on LiveKit,
# where a job owns its process.
CALL_TOKEN_ATTR = "coval.internal.call_token"

# How the caller reached the agent. Values are fixed: `browser`, `phone`,
# `websocket`. A route that cannot be determined records nothing.
CALL_ORIGIN_ATTR = "coval.call.origin"


class CovalExporter(SpanExporter):
    """Hold spans until the call's Coval ID is known, then export them.

    One exporter for the life of the provider. Its correlation state, though,
    belongs to one call: Pipecat Cloud runs many sessions through one warm
    container, and an exporter that kept the first call's ID would file every
    later call under it. ``begin_call`` clears that state and takes a new
    token, and ``export`` never sends a span stamped with an older one.
    """

    def __init__(self, api_key: str) -> None:
        """Start with no call, no exporter and an empty span buffer."""
        self._api_key = api_key
        self._lock = threading.RLock()
        self._buffer: deque[ReadableSpan] = deque(maxlen=MAX_PREACTIVATION_SPANS)
        self._dropped = 0
        self._exporter: OTLPSpanExporter | None = None
        self.simulation_id: str | None = None
        self.call_token = 0

    @property
    def active(self) -> bool:
        """Whether this call has a correlation ID and is exporting."""
        return self._exporter is not None

    def begin_call(self) -> int:
        """Start a new call, keeping nothing at all from the last one."""
        with self._lock:
            exporter = self._exporter
            self._exporter = None
            self.simulation_id = None
            self._buffer.clear()
            self._dropped = 0
            self.call_token += 1
            token = self.call_token
        if exporter is not None:
            # Only the OTLP exporter the last call bound, never the provider's
            # own processor: a processor that has been shut down drops every
            # later span in silence, and the next call still needs it.
            exporter.shutdown()
        return token

    def held(self) -> list[ReadableSpan]:
        """The spans waiting for a correlation ID, oldest first."""
        with self._lock:
            return list(self._buffer)

    def activate(self, correlation_id: str, header: str = SIMULATION_EXPORT_HEADER) -> None:
        """Bind this call to a correlation ID and flush the spans held so far."""
        with self._lock:
            if self.simulation_id == correlation_id:
                return
            self.simulation_id = correlation_id
            self._exporter = OTLPSpanExporter(
                endpoint=COVAL_TRACES_ENDPOINT,
                headers={"x-api-key": self._api_key, header: correlation_id},
                timeout=EXPORT_TIMEOUT_SECONDS,
            )
            held = list(self._buffer)
            self._buffer.clear()
            dropped, self._dropped = self._dropped, 0
            exporter = self._exporter
        if dropped:
            logger.warning("Dropped %d span(s) before the correlation ID arrived", dropped)
        if held:
            logger.info("Flushing %d held span(s) to Coval", len(held))
            exporter.export(held)

    def _belongs(self, span: ReadableSpan) -> bool:
        """Whether a span is the live call's, or was never stamped with a call."""
        token = (span.attributes or {}).get(CALL_TOKEN_ATTR)
        return token is None or token == self.call_token

    def export(self, spans: Sequence[ReadableSpan]) -> SpanExportResult:
        """Export this call's spans, or hold them until the call has an ID."""
        with self._lock:
            mine = [span for span in spans if self._belongs(span)]
            stale = len(spans) - len(mine)
            exporter = self._exporter
            if exporter is None:
                # The deque drops its oldest span past the limit, so count those.
                self._dropped += max(0, len(self._buffer) + len(mine) - MAX_PREACTIVATION_SPANS)
                self._buffer.extend(mine)
        if stale:
            logger.warning(
                "Discarded %d span(s) from a finished call rather than filing them "
                "under the live one",
                stale,
            )
        if exporter is None or not mine:
            return SpanExportResult.SUCCESS
        # ponytail: every span of *this* call goes out, not only the ones
        # stamped with a simulation ID. A batching processor can still be holding
        # a span created before the ID arrived when activate() drains the buffer,
        # and filtering on the simulation would silently drop it. The call token
        # is the only filter worth having: a span from a finished call must never
        # ride out under the live call's correlation ID.
        return exporter.export(mine)

    def force_flush(self, timeout_millis: int = FLUSH_TIMEOUT_MS) -> bool:
        """Flush the bound exporter, if there is one."""
        with self._lock:
            exporter = self._exporter
        return exporter.force_flush(timeout_millis) if exporter else True

    def shutdown(self) -> None:
        """Drop held spans and shut the bound exporter down."""
        with self._lock:
            exporter = self._exporter
            self._exporter = None
            self._buffer.clear()
        if exporter:
            exporter.shutdown()


def _timed_out(error: BaseException) -> bool:
    """A read or connect timeout, however urllib wrapped it."""
    return isinstance(error, TimeoutError) or isinstance(
        getattr(error, "reason", None), TimeoutError
    )


class Coval(Backend):
    """Coval's OTLP ingest, correlated to a simulation or a conversation.

    Unlike Langfuse and Logfire, a missing key is not fatal here. A Coval key
    only matters while a simulation is running, and a live call must not fail
    because an evaluation credential is absent.
    """

    __slots__ = ("api_key", "router")

    def __init__(self, api_key: str) -> None:
        """Hold the key and the one exporter this call's spans are routed through."""
        self.api_key = api_key
        self.router = CovalExporter(api_key)

    @classmethod
    def from_env(cls) -> Self:
        """Read the key, and say plainly when it is missing."""
        api_key = os.getenv("COVAL_API_KEY", "")
        logger.info(
            "Coval tracing on: agent %s, traces to %s, COVAL_API_KEY %s",
            TRACE_NAME,
            COVAL_TRACES_ENDPOINT,
            "present" if api_key else "MISSING",
        )
        if not api_key:
            logger.warning("COVAL_API_KEY is not set, so no trace will reach Coval")
        return cls(api_key)

    def exporter(self) -> SpanExporter:
        """The router, which holds spans until the call has a Coval ID."""
        return self.router
{{if eq .Target "livekit"}}
    def processor(self) -> SpanProcessor:
        """Unbatched, on purpose.

        The router flushes its held spans the moment the simulation ID arrives,
        and a batching processor could still be holding a span at that moment,
        which would then export it under no simulation at all.
        """
        return SimpleSpanProcessor(self.router)
{{end}}
    def tool_span(
        self, name: str, arguments: str, call_id: str | None
    ) -> tuple[str, dict[str, AttributeValue]]:
        """Coval's canonical tool span."""
        attributes: dict[str, AttributeValue] = {"function.name": name, "function.arguments": arguments}
        if call_id:
            attributes["tool_call_id"] = call_id
        return "llm_tool_call", attributes

    def tool_result(self, result: str) -> dict[str, AttributeValue]:
        """What the tool returned, under Coval's name."""
        return {"tool.result": result}

    def tool_outcome(self, status: str) -> dict[str, AttributeValue]:
        """Coval records only a call that did not complete."""
        return {} if status == "completed" else {"tool.error": status}

    def submit_conversation(
        self, transcript: list[dict[str, str]], session_id: str, origin: str = ""
    ) -> str | None:
        """Register this call with Coval as a conversation, and return its ID.

        This is the route for a call no simulation placed: a local `unmute dev`
        run, or production traffic. Coval needs the call to exist before spans
        can be attached to it, so the transcript is submitted first and the ID
        it returns is what the spans are exported against.
        """
        if not self.api_key:
            logger.warning("COVAL_API_KEY is not set, so this call is not filed with Coval")
            return None
        if not transcript:
            return None
        metadata = {"agent": TRACE_NAME, "source": "unmute", "session_id": session_id}
        if origin:
            metadata["origin"] = origin
        payload = {
            "transcript": transcript,
            "metadata": metadata,
            "tags": [TRACE_NAME],
        }
        if session_id:
            payload["external_conversation_id"] = session_id
        request = urllib.request.Request(
            COVAL_CONVERSATIONS_ENDPOINT,
            data=json.dumps(payload).encode(),
            headers={"x-api-key": self.api_key, "content-type": "application/json"},
            method="POST",
        )
        try:
            # Not EXPORT_TIMEOUT_SECONDS: this runs in the host's shutdown
            # window, which is shorter than Coval's required export timeout.
            with urllib.request.urlopen(request, timeout=SUBMIT_TIMEOUT_SECONDS) as response:
                body = json.load(response)
        except (urllib.error.URLError, OSError, ValueError) as error:
            # A trace is not worth failing a call over, on this path least of
            # all: the call is already over by the time this runs.
            if _timed_out(error):
                logger.warning(
                    "Registering this call with Coval took longer than its %ss budget, "
                    "so this call is not filed",
                    SUBMIT_TIMEOUT_SECONDS,
                )
            else:
                logger.warning("Could not register this call with Coval: %s", error)
            return None
        conversation_id = str((body.get("conversation") or {}).get("conversation_id") or "")
        return conversation_id or None


