# A write token names its region: `pylf_v1_eu_<secret>`. The pattern is the one
# the Logfire SDK reads (logfire/_internal/auth.py).
LOGFIRE_TOKEN_REGION = re.compile(r"^pylf_v[0-9]+_(?P<region>[a-z]+)_")
LOGFIRE_REGIONS = ("us", "eu")


# What Logfire shows on a row: the operation, then what it ran on. Logfire's own
# integrations write `chat gpt-4o` and `execute_tool <name>` the same way.
LOGFIRE_LABELS = {
    "invoke_agent": ("agent", "gen_ai.agent.name"),
    "chat": ("chat", "gen_ai.request.model"),
    "execute_tool": ("tool", "gen_ai.tool.name"),
    "stt": ("stt", "gen_ai.request.model"),
    "tts": ("tts", "gen_ai.request.model"),
}

# The span each target opens for the whole call, and for one exchange.
LOGFIRE_CALL_SPANS = ("agent_session", "conversation")
LOGFIRE_TURN_SPAN = "turn"
LOGFIRE_LINE_CHARS = 80


def _plain(value: AttributeValue | None) -> str:
    """An attribute as text, unwrapping a JSON-encoded string."""
    text = "" if value is None else str(value)
    if text.startswith('"'):
        try:
            return str(json.loads(text))
        except ValueError:
            return text
    return text


def logfire_message(name: str, attributes: Mapping[str, AttributeValue]) -> str | None:
    """The line Logfire shows for a span, or None to keep the span's own name.

    A turn reads as what the caller said, even where it is also an agent run:
    a column of identical agent names would say nothing about the call.
    """
    if name == LOGFIRE_TURN_SPAN:
        line = _plain(attributes.get("input.value"))
        return f"turn: {line[:LOGFIRE_LINE_CHARS]}" if line else "turn"
    label = LOGFIRE_LABELS.get(str(attributes.get("gen_ai.operation.name")))
    if label is not None:
        return f"{label[0]} {_plain(attributes.get(label[1]))}".strip()
    if name in LOGFIRE_CALL_SPANS:
        session = attributes.get("session.id") or attributes.get("gen_ai.conversation.id")
        return f"call {session}" if session else "call"
    return None


def _parts(message: Mapping[str, Any]) -> list[dict[str, Any]]:
    """One OpenAI-format message as GenAI message parts."""
    content = message.get("content")
    if message.get("role") == "tool":
        return [{"type": "tool_call_response", "id": message.get("tool_call_id"), "response": content}]
    texts = (
        [content]
        if isinstance(content, str)
        else [part.get("text", "") for part in content or [] if isinstance(part, dict) and part.get("type") == "text"]
    )
    calls = [call.get("function") or {} for call in message.get("tool_calls") or []]
    return [{"type": "text", "content": text} for text in texts if text] + [
        {"type": "tool_call", "name": call.get("name"), "arguments": call.get("arguments")} for call in calls
    ]


def genai_messages(attributes: Mapping[str, AttributeValue]) -> dict[str, AttributeValue]:
    """A model call's messages under the GenAI names Logfire's LLM panel reads.

    LiveKit already writes them. Pipecat keeps its own `input` (OpenAI-format
    messages) and `output` (the reply's text, written when the stream ends), and
    a plain-string system prompt, so this maps those. Anything else is left alone.
    """
    if attributes.get("gen_ai.operation.name") != "chat" or "gen_ai.input.messages" in attributes:
        return {}
    mapped: dict[str, AttributeValue] = {}
    system = attributes.get("gen_ai.system_instructions")
    if isinstance(system, str) and not system.lstrip().startswith("["):
        mapped["gen_ai.system_instructions"] = json.dumps([{"type": "text", "content": system}])
    try:
        messages = json.loads(str(attributes.get("input") or "[]"))
    except ValueError:
        messages = []
    if isinstance(messages, list) and messages:
        # The system prompt has its own attribute, so it is not a message too.
        mapped["gen_ai.input.messages"] = json.dumps(
            [
                {"role": message.get("role", "user"), "parts": _parts(message)}
                for message in messages
                if isinstance(message, dict) and not (system and message.get("role") == "system")
            ]
        )
    output = attributes.get("output")
    if output:
        mapped["gen_ai.output.messages"] = json.dumps(
            [{"role": "assistant", "parts": [{"type": "text", "content": str(output)}]}]
        )
    return mapped


def _shaped(span: ReadableSpan) -> ReadableSpan:
    """A copy of an ended span, labelled and mapped for Logfire. Nothing else moves."""
    attributes: dict[str, AttributeValue] = dict(span.attributes or {})
    attributes.update(genai_messages(attributes))
    message = logfire_message(span.name, attributes)
    if message:
        attributes["logfire.msg"] = message
    return ReadableSpan(
        name=span.name,
        context=span.context,
        parent=span.parent,
        resource=span.resource,
        attributes=attributes,
        events=span.events,
        links=span.links,
        kind=span.kind,
        status=span.status,
        start_time=span.start_time,
        end_time=span.end_time,
        instrumentation_scope=span.instrumentation_scope,
    )


class LogfireExporter(SpanExporter):
    """The OTLP exporter, sending each span the way Logfire's own integrations shape theirs."""

    def __init__(self, inner: SpanExporter) -> None:
        """Wrap the exporter that actually sends."""
        self._inner = inner

    def export(self, spans: Sequence[ReadableSpan]) -> SpanExportResult:
        """Label and map every span, then send them."""
        return self._inner.export([_shaped(span) for span in spans])

    def force_flush(self, timeout_millis: int = FLUSH_TIMEOUT_MS) -> bool:
        """Flush the wrapped exporter."""
        return self._inner.force_flush(timeout_millis)

    def shutdown(self) -> None:
        """Shut the wrapped exporter down."""
        self._inner.shutdown()


@dataclass(frozen=True, slots=True)
class Logfire(Backend):
    """Logfire's OTLP endpoint, in the region the write token names.

    Logfire groups a call into agent runs, and counts a model call toward a run
    only when it sits directly under the run's span. So this backend marks a
    span as an agent run where a framework opens none.
    """

    token: str

    @classmethod
    def from_env(cls) -> Self:
        """Read the write token. Nothing else is needed."""
        token = os.getenv("LOGFIRE_TOKEN", "")
        if not token:
            raise ValueError("LOGFIRE_TOKEN must be set")
        return cls(token)

    @property
    def base_url(self) -> str:
        """The region's host, read off the token the way the Logfire SDK reads it.

        An older token names no region, and the SDK sends those to the US
        region, so this does too. So does a region the SDK does not know.
        """
        found = LOGFIRE_TOKEN_REGION.match(self.token)
        region = found["region"] if found and found["region"] in LOGFIRE_REGIONS else "us"
        return f"https://logfire-{region}.pydantic.dev"

    def exporter(self) -> SpanExporter:
        """Plain OTLP, shaped for Logfire. It takes the raw token, with no `Bearer`."""
        return LogfireExporter(
            OTLPSpanExporter(
                endpoint=f"{self.base_url}/v1/traces",
                headers={"Authorization": self.token},
            )
        )

    def call_attributes(self, session_id: str | None) -> dict[str, AttributeValue]:
        """The shared ones, plus the conversation ID Logfire groups agent runs by."""
        # Not super(): a slotted dataclass is rebuilt, and zero-argument super
        # would point at the class it replaced.
        attributes = Backend.call_attributes(self, session_id)
        if session_id:
            attributes["gen_ai.conversation.id"] = session_id
        return attributes

    def agent_run(self, agent_name: str) -> dict[str, AttributeValue]:
        """What Logfire's Agents view keys on."""
        return {"gen_ai.operation.name": "invoke_agent", "gen_ai.agent.name": agent_name}


BACKEND: type[Backend] = Logfire
