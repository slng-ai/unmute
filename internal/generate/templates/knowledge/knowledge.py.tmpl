"""Knowledge base search over the documents compiled into this project.

Generated by unmute. Do not edit: `unmute compile` overwrites this file.

Every index is built once, at process start, and held in memory for the life of
the process. A lookup embeds the question and searches; it never reads a file and
never re-indexes. The documents are whatever was compiled in, so **content is
fixed until the next compile**: editing a PDF in the source package changes
nothing until you compile and deploy again.

Nothing here writes outside this container.
"""

import json
import logging
import re
{{- if .AnyEmbeds}}
import os
{{- end}}
import time
from pathlib import Path


from llama_index.core import SimpleDirectoryReader{{if .AnyEmbeds}}, StorageContext, VectorStoreIndex, load_index_from_storage{{end}}
from llama_index.core.node_parser import SentenceSplitter
{{- range .KnowledgeImports}}
from {{.Module}} import {{.Class}}
{{- end}}
{{- if .AnyKeyword}}
from llama_index.retrievers.bm25 import BM25Retriever
{{- end}}

log = logging.getLogger("knowledge")

# The folder the compiler copied the documents into, beside this file.
KNOWLEDGE_ROOT = Path(__file__).resolve().parent / "knowledge"

# Where a baked index lives, when the image was built with one.
#
# Present: build_indexes() loads it, and startup sends no embedding request for the
# corpus at all. Absent: build_indexes() reads the documents and embeds them, which
# is what happened before this existed and is still correct, only slower and
# repeated in every worker process.
#
# The distinction matters most on LiveKit, where prewarm runs per job process: a
# local dev run was observed indexing in 15 separate processes, each paying the
# full cost for the same content.
INDEX_ROOT = Path(__file__).resolve().parent / "knowledge_index"

# Retrieval settings, per knowledge base, as the author declared them.
#
# chunk_size and chunk_overlap are in TOKENS, not characters: 90 tokens is roughly
# 360 characters or 65 words. top_k is how many passages a lookup returns, so
# top_k * chunk_size is roughly what reaches the model per lookup.
#
# They are per base because a price list and a prose policy want different passage
# sizes. Measured: a price list split at 90 tokens ranked an opening-hours passage
# above the price a caller asked for.
SETTINGS = {
{{- range .Knowledge}}
    {{pyq .Name}}: {"mode": {{pyq .Mode}}, "chunk_size": {{.ChunkSize}}, "chunk_overlap": {{.ChunkOverlap}}, "top_k": {{.TopK}}, "min_score": {{.MinScore}}},
{{- end}}
}

# Per knowledge base: {"vector": retriever or None, "keyword": BM25Retriever or
# None}. Populated by build_indexes() at startup.
#
# Which half exists is the mode's business. A keyword-only base has no vector
# retriever and no embedding credential, because BM25 needs neither.
_INDEXES: dict[str, dict] = {}


class KnowledgeError(RuntimeError):
    """A startup failure.

    Raised so the process exits and the deployment never reaches ready, rather
    than serving calls with an agent that knows nothing.
    """


def _read(name: str) -> list:
    """Read one knowledge base's documents, failing loudly on an empty read.

    `exclude_hidden=False` is load-bearing. With the default,
    SimpleDirectoryReader silently returns nothing for any path with a
    dot-component in it, which is a very ordinary thing for a checkout path to
    have. The result is an agent that starts healthy, answers every question
    with "I don't have that", and logs nothing at all.

    The emptiness check below is the second half of the same guard: the flag
    stops one cause of an empty read, and this stops an empty read from ever
    being quiet, whatever caused it.
    """
    folder = KNOWLEDGE_ROOT / name
    if not folder.is_dir():
        raise KnowledgeError(
            f"knowledge {name!r}: {folder} is missing from the image. "
            "The Dockerfile must copy knowledge/ into the working directory."
        )
    documents = SimpleDirectoryReader(str(folder), exclude_hidden=False).load_data()
    if not documents:
        raise KnowledgeError(
            f"knowledge {name!r}: read no documents from {folder}. "
            "SimpleDirectoryReader returns nothing for a hidden path without "
            "raising, so this is a hard failure rather than an empty index."
        )
    return documents


# A PDF read without llama-index-readers-file installed comes back as its own
# raw bytes, decoded as text, and nothing raises. Measured 2026-08-25: the
# document is non-empty, so every emptiness check passes, and the agent indexes
# PDF stream gibberish and answers from it confidently. This is the one failure
# mode that certifies itself as healthy, which is why it is checked by content.
_PDF_MAGIC = "%PDF-"

# Characters a PDF reader hands back that are layout, not language.
#
# A PDF draws a bullet as a glyph, and extraction turns the ones with no Unicode
# mapping into control characters: the salon documents produce 47 DEL bytes (0x7f),
# one per list item. Left alone they travel into the passage, into the embedding,
# and into the model's context verbatim, where the best case is wasted tokens and
# the worst is a model reading punctuation out loud. Measured 2026-08-26.
#
# Newlines and tabs are kept. They are the only whitespace that carries meaning
# here, and the splitter uses them to find sentence boundaries.
_CONTROL = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")


def _clean(text: str) -> str:
    """Document text with layout artefacts removed and spacing collapsed.

    Runs before splitting, so a passage, its embedding and what the model is shown
    are all the same cleaned text. Cleaning at lookup time instead would embed one
    string and display another.
    """
    return re.sub(r"[ \t]{2,}", " ", _CONTROL.sub("", text))


def _source_name(metadata: dict) -> str:
    """A document's file name, never its path.

    The path is the author's own folder layout and the file name is what the
    agent says out loud, so only one of the two belongs in a result.
    """
    return Path(metadata.get("file_name") or metadata.get("file_path") or "").name


def _with_text(name: str, documents: list) -> list:
    """Drop documents that yielded no text, and decide whether that is fatal.

    A scanned PDF has pages and no text layer. Extracting nothing from it is not
    an error the compiler could have caught: it needs a parser, which is why
    this is a startup check and not a compile check.

    Some documents empty and at least one not: warn by name and carry on.
    Every document empty: fail, because the agent would confidently know nothing.
    """
    kept, empty = [], []
    for document in documents:
        text = document.text or ""
        source = _source_name(document.metadata or {})
        if text.lstrip().startswith(_PDF_MAGIC):
            raise KnowledgeError(
                f"knowledge {name!r}: {source} was read as raw PDF bytes, not as text. "
                "llama-index-readers-file is missing from the environment, so "
                "SimpleDirectoryReader fell back to reading the file as plain text. "
                "Install the project's declared dependencies."
            )
        if text.strip():
            # Drop the reader's layout artefacts before anything downstream sees
            # them: this is the text that gets split, embedded and shown.
            # set_content, not `document.text =`: text is a read-only property on
            # Document in llama-index-core 0.14, and assigning raises at startup.
            document.set_content(_clean(text))
            # Keep the file name and drop everything else the reader attached.
            #
            # Not tidiness. SentenceSplitter subtracts the metadata's token count
            # from chunk_size, and SimpleDirectoryReader attaches the document's
            # absolute path, so metadata measured 343 characters here. At a
            # chunk_size of 90 tokens that is a hard ValueError at startup, and
            # whether it fires depends on how long the deployment's working
            # directory happens to be: it crashed from a checkout path and
            # survived from /app. Measured 2026-08-25.
            #
            # It also stops the author's folder layout being embedded into every
            # vector, which the tool contract already forbids showing a model.
            document.metadata = {"file_name": source}
            # Kept for citation, hidden from the embedding and from the model.
            #
            # This is what decouples chunk_size from how long a file name happens
            # to be. SentenceSplitter subtracts the metadata's token count from
            # chunk_size and raises when nothing is left, so with the file name
            # visible, `chunk_size: 16` worked for a short name and crashed at
            # startup for a long one. Excluded, the metadata length is 0 and any
            # chunk_size the compiler accepted actually runs. Measured 2026-08-26.
            document.excluded_embed_metadata_keys = ["file_name"]
            document.excluded_llm_metadata_keys = ["file_name"]
            kept.append(document)
        else:
            empty.append(source)
    for source in empty:
        log.warning("knowledge %r: skipping %s, no text layer", name, source)
    if not kept:
        listed = ", ".join(empty) or "none"
        raise KnowledgeError(
            f"knowledge {name!r}: no document yielded any text ({listed}). "
            "A PDF with no text layer needs OCR before it can be searched."
        )
    log.info(
        "knowledge %r: %d of %d documents indexed", name, len(kept), len(documents)
    )
    return kept
{{range .Knowledge}}{{if .Embeds}}

def _embed_{{.Name}}():
    """The embedding service for {{.Name}}, and the credential it needs.
{{- if .CredentialEnv}}

    The credential is checked before the first embedding call rather than after,
    so a missing one is a startup failure naming the variable instead of a stack
    trace on the first caller question.
{{- end}}

    Model verified {{.EmbedVerified}} against {{.EmbedDocs}}.
    """
{{- if .CredentialEnv}}
    if not os.environ.get({{pyq .CredentialEnv}}):
        raise KnowledgeError(
            "knowledge {{.Name}}: {{.CredentialEnv}} is not set, so documents "
            "cannot be embedded"
        )
{{- end}}
    return {{.EmbedClass}}({{.ModelKwarg}}={{pyq .EmbedModel}})
{{end}}{{end}}

def _merge(meaning: list, keyword: list, top_k: int) -> list:
    """Interleave the two halves, meaning first at each step, then truncate.

    Interleaved, NOT one-then-the-other. Measured on 15 questions built to defeat
    meaning-based search: concatenating scored 14/15 and interleaving 15/15.

    The reason concatenating adds nothing is arithmetic, not luck. Each retriever
    returns top_k results every time, so the first fills every slot before the
    second is read, and truncation then discards the second whole. Interleaving
    gives it slots it cannot be crowded out of.

    With one half absent, as in a single-mode base, this is just a truncation.
    """
    merged, seen = [], set()
    for pair in zip(meaning + [None] * top_k, keyword + [None] * top_k):
        for item in pair:
            if item is None or item[0] in seen or len(merged) >= top_k:
                continue
            seen.add(item[0])
            merged.append(item)
    return merged[:top_k]


def _nodes(name: str) -> list:
    """Read and split one knowledge base into passages."""
    settings = SETTINGS[name]
    return SentenceSplitter(
        chunk_size=settings["chunk_size"], chunk_overlap=settings["chunk_overlap"]
    ).get_nodes_from_documents(_with_text(name, _read(name)))


def _fingerprint(name: str) -> str:
    """The settings a baked index was built with, as a stable string.

    Written next to a baked index and compared when one is loaded. Chunking and
    mode decide what the passages ARE, so an index baked under different settings
    is not a faster version of this base, it is a different base. Loading one
    would answer from the wrong passages and nothing would look wrong.

    Sorted so the string does not depend on dict order.
    """
    return json.dumps(SETTINGS[name], sort_keys=True)


def _baked(name: str) -> Path | None:
    """The baked index directory for one base, or None if the image carries none."""
    folder = INDEX_ROOT / name
    return folder if (folder / "baked.json").is_file() else None
{{if .AnyEmbeds}}

def _vector_dir(folder: Path) -> Path:
    return folder / "vector"
{{end}}{{if .AnyKeyword}}

def _keyword_dir(folder: Path) -> Path:
    return folder / "keyword"
{{end}}

def _index(name: str, embed_model=None) -> dict:
    """Build one knowledge base's retrievers from its documents, per its mode.

    A keyword-only base builds no vector index and is handed no embedder, so it
    makes no network call and needs no credential.
    """
    settings = SETTINGS[name]
    mode, top_k = settings["mode"], settings["top_k"]
    nodes = _nodes(name)

    built = {"vector": None, "keyword": None}
{{- if .AnyKeyword}}
    if mode in ("keyword", "hybrid"):
        # BM25 ranks the words themselves. No embedding, no network, about 1 ms a
        # query. It replaced a hand-rolled case-insensitive regex scan, which it
        # beat on every question set measured.
        built["keyword"] = BM25Retriever.from_defaults(
            nodes=nodes, similarity_top_k=top_k
        )
{{- end}}
{{- if .AnyEmbeds}}
    if mode in ("meaning", "hybrid"):
        # Given no storage context, VectorStoreIndex uses LlamaIndex's own
        # in-memory SimpleVectorStore. The store dies with the process.
        #
        # There is no batching here and none is needed. The Chroma store this
        # replaced refused more than `get_max_batch_size()` records per insert,
        # so it needed a loop; this one holds the embeddings itself and took
        # 6000 nodes in a single call (measured 2026-08-26).
        built["vector"] = VectorStoreIndex(
            nodes=nodes, embed_model=embed_model, show_progress=False
        ).as_retriever(similarity_top_k=top_k)
{{- end}}
    log.info(
        "knowledge %r: %d passages embedded and indexed at startup "
        "(mode %s, chunk_size %d, overlap %d, top_k %d)",
        name,
        len(nodes),
        mode,
        settings["chunk_size"],
        settings["chunk_overlap"],
        top_k,
    )
    return built


def _load(name: str, folder: Path, embed_model=None) -> dict:
    """Load one knowledge base from the index baked into this image.

    Reads only. The corpus is not re-embedded, which is the entire point: on
    LiveKit prewarm runs per job process, so a corpus embedded here would be
    embedded again in every one of them.

    A caller's question is still embedded per lookup, so a mode that embeds still
    needs its credential at run time. Baking removes the corpus cost, not the
    query cost.
    """
    settings = SETTINGS[name]
    mode, top_k = settings["mode"], settings["top_k"]
    recorded = json.loads((folder / "baked.json").read_text())
    if recorded.get("settings") != _fingerprint(name):
        raise KnowledgeError(
            f"knowledge {name!r}: the baked index was built with different "
            f"settings than this module declares. Baked: {recorded.get('settings')}. "
            f"Now: {_fingerprint(name)}. Rebuild the image rather than shipping "
            "answers from passages that do not match the configuration."
        )

    built = {"vector": None, "keyword": None}
{{- if .AnyKeyword}}
    if mode in ("keyword", "hybrid"):
        built["keyword"] = BM25Retriever.from_persist_dir(str(_keyword_dir(folder)))
        # top_k survives the round trip, but it is set again rather than trusted:
        # the alternative is an index that silently returns a different number of
        # passages than the compiler said it would.
        built["keyword"].similarity_top_k = top_k
{{- end}}
{{- if .AnyEmbeds}}
    if mode in ("meaning", "hybrid"):
        built["vector"] = load_index_from_storage(
            StorageContext.from_defaults(persist_dir=str(_vector_dir(folder))),
            embed_model=embed_model,
        ).as_retriever(similarity_top_k=top_k)
{{- end}}
    log.info(
        "knowledge %r: %d passages loaded from the baked index, nothing embedded "
        "(mode %s, top_k %d)",
        name,
        recorded.get("passages", -1),
        mode,
        top_k,
    )
    return built


def bake() -> None:
    """Build every index and write it beside this module. Run at IMAGE BUILD time.

    This is the only function here that writes anything, and it is never called at
    run time: the Dockerfile runs it, and the runtime path only ever reads what it
    produced. That split is what keeps the no-write property true on a call while
    still letting the image carry a prepared index.

    Why it exists, measured 2026-08-26 on one process: a 200-page corpus is 1670
    passages, 17 embedding requests and 9.2 seconds. LiveKit's prewarm runs per job
    process and a local dev run used 15 of them, so that is 255 requests and over
    two minutes of embedding for one deployment, repeated on every scale-up. Baked,
    it is one request set at build time and a disk read per process.
    """
    INDEX_ROOT.mkdir(parents=True, exist_ok=True)
{{- range .Knowledge}}
    _bake_one({{pyq .Name}}{{if .Embeds}}, _embed_{{.Name}}(){{end}})
{{- end}}
    log.info("knowledge: baked %d base(s) into %s", len(SETTINGS), INDEX_ROOT)


def _bake_one(name: str, embed_model=None) -> None:
    """Embed and persist one base. Build time only."""
    settings = SETTINGS[name]
    mode, top_k = settings["mode"], settings["top_k"]
    folder = INDEX_ROOT / name
    folder.mkdir(parents=True, exist_ok=True)
    nodes = _nodes(name)
{{- if .AnyKeyword}}
    if mode in ("keyword", "hybrid"):
        BM25Retriever.from_defaults(nodes=nodes, similarity_top_k=top_k).persist(
            str(_keyword_dir(folder))
        )
{{- end}}
{{- if .AnyEmbeds}}
    if mode in ("meaning", "hybrid"):
        VectorStoreIndex(
            nodes=nodes, embed_model=embed_model, show_progress=False
        ).storage_context.persist(persist_dir=str(_vector_dir(folder)))
{{- end}}
    # Written last, and it is what _baked() looks for: a half-written index must
    # not read as a complete one, or a failed bake ships as a working image.
    (folder / "baked.json").write_text(
        json.dumps(
            {"settings": _fingerprint(name), "passages": len(nodes)}, sort_keys=True
        )
    )
    log.info("knowledge %r: baked %d passages (mode %s)", name, len(nodes), mode)


def build_indexes() -> None:
    """Make every knowledge base searchable. Call once, at process start.

    Loads the index baked into the image when there is one, and falls back to
    reading and embedding the documents when there is not. Both paths are correct;
    the fallback is just slower, and it is slower once per worker process.

    Runs off the call path either way: embedding a corpus takes seconds and a
    caller waiting on the first question would hear all of it.
    """
{{- range .Knowledge}}
    _INDEXES[{{pyq .Name}}] = _start({{pyq .Name}}{{if .Embeds}}, _embed_{{.Name}}(){{end}})
{{- end}}


def _start(name: str, embed_model=None) -> dict:
    """One base, from the baked index if the image has one."""
    folder = _baked(name)
    if folder is not None:
        return _load(name, folder, embed_model)
    # Said at warning level on purpose. It is not an error, but it is a cost that
    # is otherwise invisible: it is paid again in every worker process and again on
    # every scale-up, and the usual cause is an image built without the embedding
    # credential available to the bake step.
    log.warning(
        "knowledge %r: no baked index in the image, embedding the corpus at startup "
        "instead. This is correct but costs every worker process the full build; see "
        "README.md for how to bake it in.",
        name,
    )
    return _index(name, embed_model)


async def look_up(name: str, query: str) -> dict:
    """Search one knowledge base and return at most its top_k passages.

    Three shapes, and the model has to be able to tell them apart:

      {"results": [...]}                found something
      {"results": []}                   searched, found nothing: say you do not know
      {"error": "lookup unavailable"}    could not search: say you cannot check now

    The error carries no provider name, no status code and no URL. Those go to
    the process log. A model handed them can read them down the phone.

    A failure here never ends the call.
    """
    started = time.monotonic()
    entry = _INDEXES.get(name)
    if entry is None:
        # build_indexes() raises rather than skipping, so reaching here means the
        # tool was called before startup finished. Reported as unavailable, not
        # as empty: "I don't know" would be a claim about the documents.
        log.error("knowledge %r: looked up before the index was built", name)
        return {"error": "lookup unavailable"}
    settings = SETTINGS[name]
    top_k = settings["top_k"]
    try:
        meaning, keyword = [], []
        if entry["vector"] is not None:
            meaning = [
                (
                    node.node.node_id,
                    node.node.get_content(),
                    _source_name(node.node.metadata or {}),
                    node.score,
                )
                for node in await entry["vector"].aretrieve(query)
            ]
        if entry["keyword"] is not None:
            # No score on a keyword hit. BM25 scores are unbounded and on a
            # different scale from the similarities, so reporting them in the same
            # field would give the model two numbers it cannot compare.
            keyword = [
                (
                    node.node.node_id,
                    node.node.get_content(),
                    _source_name(node.node.metadata or {}),
                    None,
                )
                for node in await entry["keyword"].aretrieve(query)
            ]
    except Exception:
        # The question is deliberately absent from this line: a caller's own
        # words are call content, and a log is not where call content belongs.
        log.exception("knowledge %r: lookup failed", name)
        return {"error": "lookup unavailable"}
    results, dropped = [], 0
    cutoff = settings["min_score"]
    for _, text, source, score in _merge(meaning, keyword, top_k):
        # A cutoff of 0 filters nothing, because every score is above it.
        #
        # A keyword-only hit has no score, so there is nothing to compare and it
        # survives any cutoff. That is deliberate: it was found because the caller
        # used the words the document uses, and filtering it would delete the
        # keyword half's entire contribution.
        if cutoff and score is not None and float(score) < cutoff:
            dropped += 1
            continue
        result = {"text": text, "source": source}
        # No fabricated score. A passage found only by the keyword half has no
        # similarity, and is reported without the field: a made-up number is worse
        # than a missing one for a model being asked to weigh it.
        if score is not None:
            result["score"] = round(float(score), 3)
        results.append(result)
    if dropped:
        # Logged because the alternative is invisible. A cutoff set too high makes
        # the agent say it does not know, on every question, with nothing anywhere
        # to say why. The question stays out of the log; only the count goes in.
        log.info(
            "knowledge %r: dropped %d result(s) below min_score %s", name, dropped, cutoff
        )
    # The one line that says retrieval happened.
    #
    # Without it a working lookup is silent, and the only evidence is whether the
    # agent's answer sounds right, which is exactly the thing being tested. This is
    # what `unmute dev --verbose` shows during a call.
    #
    # The count and the duration, never the question and never a passage. A
    # caller's words are call content and a log is not where call content belongs;
    # the same rule the failure path above follows.
    log.info(
        "knowledge %r: returned %d result(s) in %d ms",
        name,
        len(results),
        int((time.monotonic() - started) * 1000),
    )
    return {"results": results}
