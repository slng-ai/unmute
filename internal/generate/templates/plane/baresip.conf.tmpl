# The plane's SIP endpoint configuration. One file for every role: what an
# endpoint plays and what it records are account parameters, written per service
# in compose.telephony.yaml, so one image serves the caller and every transfer
# destination.
#
# Every module here was checked against baresip 1.1.0-3, the Debian package,
# on 2026-08-20. Two are deliberately absent:
#
#   ausine    a tone generator, and the obvious way to give an endpoint endless
#             audio. It refuses any rate but 48 kHz, and a carrier leg is 8 kHz
#             mulaw, so it fails with "start_source failed" and the call dies
#             the moment it is answered. Measured twice, including with the
#             sample rate raised, which does not help: the source is opened at
#             the codec's rate.
#   sndfile   records too, but names its own files. aufile as a player takes the
#             path, so each leg's recording lands where the run says it will.

poll_method		epoll
sip_listen		0.0.0.0:5060

# The unattended check drives an endpoint through this: netstring-framed JSON,
# one command per request. It is how a transfer is triggered without a language
# model in the loop, which is what lets the check run with no credentials.
ctrl_tcp_listen		0.0.0.0:4444

module_path		/usr/lib/baresip/modules
module			g711.so
module			aufile.so
module			aubridge.so
module			account.so
module			menu.so
module			ctrl_tcp.so
