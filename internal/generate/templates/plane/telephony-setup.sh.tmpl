#!/usr/bin/env bash
# Telephony setup, the LiveKit side, for {{.Project}}.
#
# It creates the two records an incoming call needs:
#   the inbound trunk, which claims your phone number for this LiveKit project;
#   the dispatch rule, which sends calls on that number to the {{.AgentName}} agent.
# Both are found by your phone number, so there is no ID to copy anywhere.
# Run it again whenever you like: whatever already exists is reused.
#
# Generated by unmute. Do not edit by hand: change the spec and recompile.
set -euo pipefail

number_env="{{.FromNumberEnv}}"

fail() {
  echo "telephony-setup: $1" >&2
  exit 1
}

# Step 1, preflight. Everything that can be missing is named before anything is
# created.
command -v lk >/dev/null 2>&1 ||
  fail "the LiveKit CLI (lk) is not on PATH. Install it from https://docs.livekit.io/home/cli/, then run 'lk cloud auth'."
command -v jq >/dev/null 2>&1 ||
  fail "jq is not on PATH. Install it with your package manager, for example 'brew install jq' or 'apt install jq'."

number="$(printenv "$number_env" 2>/dev/null || true)"
if [ -z "$number" ] && [ -f ./.env ]; then
  # One assignment is read out of .env as text. This file is never sourced:
  # sourcing would read every secret in it, and a single line whose name is not
  # a shell identifier would abort this script.
  number="$(sed -n "s/^$number_env=//p" ./.env | head -1 | tr -d "\r\"'")"
fi
[ -n "$number" ] || fail "$number_env has no value. Export it, or set it in ./.env, then run this again."

# Trunk listings carry trunk credentials, so every listing goes through jq and
# only the record ID comes back out.
trunk_id_for_number() {
  lk sip inbound list --json |
    jq -r --arg number "$number" '[(.items // [])[] | select((.numbers // []) | index($number))] | .[0].sipTrunkId // ""'
}

# Steps 2 and 3, resolve the trunk by number and create it when no trunk claims
# the number yet.
trunk="$(trunk_id_for_number)"
if [ -n "$trunk" ]; then
  echo "inbound trunk $trunk already claims $number (reused)"
else
  # The JSON input holds the number as a token named after the variable, so the
  # expansion below builds that token and replaces it with the value.
  sed "s|\${$number_env}|$number|g" sip-inbound-trunk.json | lk sip inbound create -
  trunk="$(trunk_id_for_number)"
  # Step 4, the guard. A dispatch rule with an empty trunk list matches every
  # trunk in the project, other people's included, so no rule is ever created
  # without a resolved trunk ID.
  [ -n "$trunk" ] ||
    fail "no inbound trunk claims $number after creating one. If a trunk this project cannot see already claims that number, someone else owns it: check the number, or release the other claim first."
  echo "inbound trunk $trunk now claims $number (created)"
fi

# Step 5, the dispatch rule for that one trunk.
if lk sip dispatch list --json | jq -e --arg trunk "$trunk" 'any((.items // [])[]; (.trunkIds // []) | index($trunk))' >/dev/null; then
  echo "dispatch rule for that trunk already exists (reused)"
else
  sed "s|\${UNMUTE_SIP_TRUNK_ID}|$trunk|g" sip-dispatch-rule.json | lk sip dispatch create -
  echo "dispatch rule sending those calls to {{.AgentName}} (created)"
fi

echo "Telephony setup is done. Calls to $number reach {{.AgentName}}."
