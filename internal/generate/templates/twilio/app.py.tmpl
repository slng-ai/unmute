"""Twilio ConversationRelay voice agent for {{.Target}}, generated by unmute.

Do not edit this file: change the package and compile again.

Twilio ConversationRelay does the listening and the speaking. This app answers
the voice webhook with TwiML, holds the ConversationRelay WebSocket, thinks with
{{if .OpenAI}}OpenAI Chat Completions{{else}}Gemini generateContent{{end}} and runs the package's local tools.

  {{.Docs.ConversationRelay}}
  {{.Docs.Messages}}
"""

def public_origin(value: str) -> tuple[str, str]:
    """Read the public URL as an https origin.

    Everything signed is built from it, never from request headers, because
    a proxy can rewrite those.

    Args:
        value: The public URL from the environment.

    Returns:
        The origin and its host.

    Raises:
        SystemExit: If the URL is not a bare https origin.
    """
    parts = urlsplit(value.strip())
    if (
        parts.scheme != "https"
        or not parts.hostname
        or parts.username
        or parts.password
        or parts.path not in ("", "/")
        or parts.query
        or parts.fragment
    ):
        raise SystemExit(
            f"{ENV_PUBLIC_URL} must be an https origin with no path, query or credentials, "
            "for example https://relay.example.com"
        )
    return f"https://{parts.netloc}", parts.netloc


def xml_response(body: str) -> Response:
    """Wrap TwiML in an XML response.

    Args:
        body: The TwiML text.

    Returns:
        The HTTP response.
    """
    return Response(content=body, media_type="text/xml")


def raw_target(scope: Mapping[str, Any]) -> tuple[str, str]:
    """Read the path and query exactly as the client sent them.

    That is what Twilio signed. The decoded path Starlette builds URLs from
    is not.

    Args:
        scope: The ASGI scope.

    Returns:
        The raw path and the raw query string.
    """
    path = scope.get("raw_path") or scope["path"].encode()
    return path.decode("latin-1"), scope.get("query_string", b"").decode("latin-1")


def build_app(client: Any = None) -> FastAPI:
    """Build the web app: the voice webhook, the WebSocket and the health check.

    Args:
        client: A model client to use instead of make_client(), for tests.

    Returns:
        The FastAPI app, with its drain function on app.state.drain_calls.

    Raises:
        SystemExit: If the environment or the TwiML is not usable.
    """
    required = (ENV_ACCOUNT_SID, ENV_AUTH_TOKEN, ENV_PUBLIC_URL, ENV_MODEL_KEY, *UPSTREAM_ENV)
    missing = [name for name in required if not os.environ.get(name)]
    if missing:
        raise SystemExit("missing environment: " + ", ".join(missing))
    account_sid = os.environ[ENV_ACCOUNT_SID]
    validator = RequestValidator(os.environ[ENV_AUTH_TOKEN])
    origin, host = public_origin(os.environ[ENV_PUBLIC_URL])
    document = relay_document(origin, host)
    twiml = to_twiml(document)
    slots = Slots(MAX_SESSIONS)
    parked = Parked()
    calls: set[Call] = set()
    model_client = client or make_client()
    app = FastAPI(openapi_url=None, docs_url=None, redoc_url=None)

    def signed(headers: Any, urls: list[str], params: Any) -> bool:
        """Check Twilio's signature against every URL it may have signed."""
        signature = headers.get("X-Twilio-Signature", "")
        return bool(signature) and any(validator.validate(url, params, signature) for url in urls)

    def signed_url(request: Request) -> str:
        """Build the exact URL Twilio requested, query included.

        https://www.twilio.com/docs/usage/security. Built on the public origin,
        never on request headers a proxy can rewrite.
        """
        path, query = raw_target(request.scope)
        return origin + path + ("?" + query if query else "")

    @app.get("/healthz")
    async def healthz() -> JSONResponse:
        """Answer 503 while draining, or when handlers hold every slot.

        The process can take no call either way. A 200 does not promise a free
        slot: /voice may still answer <Hangup/>.
        """
        if slots.draining or slots.orphaned >= slots.limit:
            return JSONResponse({"ok": False, "artifact_id": ARTIFACT_ID}, status_code=503)
        return JSONResponse({"ok": True, "artifact_id": ARTIFACT_ID})

    @app.post("/voice")
    async def voice(request: Request) -> Response:
        """Answer the voice webhook with the ConversationRelay TwiML."""
        form = await request.form()
        if not signed(request.headers, [signed_url(request)], form):
            log.warning("event=signature_rejected route=/voice")
            return Response(status_code=403)
        if form.get("AccountSid") != account_sid:
            log.warning("event=account_rejected route=/voice")
            return Response(status_code=403)
        if not slots.has_room():
            log.info("event=call_refused reason=%s", "draining" if slots.draining else "full")
            return xml_response(HANGUP_TWIML)
        return xml_response(twiml)

    @app.post("/connect-action")
    async def connect_action(request: Request) -> Response:
        """Say what the call does once the session ends.

        https://www.twilio.com/docs/voice/twiml/connect. Twilio asks here, with
        the session's HandoffData.
        """
        form = await request.form()
        if not signed(request.headers, [signed_url(request)], form):
            log.warning("event=signature_rejected route=/connect-action")
            return Response(status_code=403)
        if form.get("AccountSid") != account_sid:
            return Response(status_code=403)
        log.info(
            "event=session_ended call=%s status=%s error=%s",
            str(form.get("CallSid", ""))[:LOG_SID_CHARS],
            str(form.get("SessionStatus", ""))[:LOG_WORD_CHARS],
            str(form.get("ErrorCode", ""))[:LOG_CODE_CHARS],
        )
        reason, data = parse_handoff(form.get("HandoffData"))
        call_sid = str(form.get("CallSid", ""))
        handoff = Handoff(
            reason=reason,
            data=data,
            call={
                "call_sid": call_sid,
                "from": str(form.get("From", "")),
                "to": str(form.get("To", "")),
                "direction": str(form.get("Direction", "")),
            },
            status=str(form.get("SessionStatus", "")),
            resume=lambda note, before="", greeting="": resume_twiml(document, note, before, greeting),
        )
        answer = await next_step(handoff)
        if not isinstance(answer, Resume):
            parked.drop(call_sid)
        return xml_response(answer)

    @app.websocket("/conversation")
    async def conversation(ws: WebSocket) -> None:
        """Hold one ConversationRelay session.

        The handshake is signed over the wss URL with no form fields. Twilio
        documents one variant: a trailing slash on the path.
        """
        path, query = raw_target(ws.scope)
        suffix = "?" + query if query else ""
        urls = [f"wss://{host}{path}{suffix}", f"wss://{host}{path}/{suffix}"]
        if not signed(ws.headers, urls, {}):
            log.warning("event=signature_rejected route=/conversation")
            # Closing before accept answers the handshake with HTTP 403.
            await ws.close(code=CLOSE_POLICY_VIOLATION)
            return
        await ws.accept()
        try:
            first = await asyncio.wait_for(receive(ws), SETUP_TIMEOUT)
            text = first.get("text") if first is not None else None
            setup = json.loads(text) if text is not None else None
        except (TimeoutError, ValueError):
            setup = None
        if (
            not isinstance(setup, dict)
            or setup.get("type") != "setup"
            or setup.get("accountSid") != account_sid
            or not CALL_SID.fullmatch(str(setup.get("callSid", "")))
            or not SESSION_ID.fullmatch(str(setup.get("sessionId", "")))
        ):
            log.warning("event=setup_rejected")
            await close_quietly(ws, CLOSE_POLICY_VIOLATION)
            return
        # Call state starts here, after the setup message proved the account.
        if not slots.take():
            log.info("event=call_refused reason=%s", "draining" if slots.draining else "full")
            try:
                await ws.send_json({"type": "end", "handoffData": json.dumps({"reasonCode": "busy"})})
            except (WebSocketDisconnect, ConnectionError, RuntimeError):
                return
            # As in Call.end: wait for Twilio to close, or the refusal fails as 64105.
            with contextlib.suppress(TimeoutError):
                await asyncio.wait_for(drain(ws), END_GRACE)
            await close_quietly(ws)
            return
        custom = setup.get("customParameters")
        note = custom.get("resume") if isinstance(custom, dict) else None
        brain = parked.take(setup["callSid"]) if note is not None else None
        call = Call(ws, setup, model_client, slots, parked, brain=brain)
        calls.add(call)
        call.event("call_started", direction=str(setup.get("direction", ""))[:LOG_WORD_CHARS])
        if note is not None and brain is None:
            # Nothing parked: it expired, or another process held the call.
            call.event("resume_missed")
        owner = asyncio.ensure_future(call.run())
        if brain is not None:
            call.resume(str(custom.get("greeting") or "") if isinstance(custom, dict) else "")
        try:
            await call.read()
        finally:
            # Synchronous first: uvicorn cancels this handler when its
            # graceful shutdown runs out, and the slot must be accounted for
            # either way.
            call.close()
            calls.discard(call)
            owner.cancel()
            call.event("call_closed")
        await asyncio.gather(owner, return_exceptions=True)

    async def drain_calls() -> None:
        """Stop taking calls, give the current ones a bounded time, then end the rest.

        Twilio closes the sockets of the calls that are ended.
        """
        slots.draining = True
        with contextlib.suppress(TimeoutError):
            await asyncio.wait_for(slots.idle.wait(), DRAIN_TIMEOUT)
        for call in list(calls):
            await call.end("shutdown")
        with contextlib.suppress(TimeoutError):
            await asyncio.wait_for(slots.idle.wait(), END_GRACE)

    app.state.drain_calls = drain_calls
    return app


class RelayServer(uvicorn.Server):
    """uvicorn, draining the calls before it closes anything.

    On SIGTERM uvicorn closes every open WebSocket with 1012 first and runs the
    app's lifespan shutdown last, which is too late to end a call cleanly. The
    listeners are still open when shutdown() starts, so draining here keeps
    /healthz answering 503 and /voice answering <Hangup/> while calls end.
    """

    def __init__(self, config: uvicorn.Config, drain: Callable[[], Awaitable[None]]) -> None:
        """Wrap a uvicorn config with the drain to run first.

        Args:
            config: The uvicorn configuration.
            drain: Ends the open calls; runs before uvicorn closes anything.
        """
        super().__init__(config)
        self.drain = drain

    async def shutdown(self, sockets: Any = None) -> None:
        """Drain the calls, then shut uvicorn down.

        Args:
            sockets: The listening sockets, as uvicorn passes them.
        """
        await self.drain()
        await super().shutdown(sockets=sockets)


def server_config(app: FastAPI, host: str, port: int) -> uvicorn.Config:
    """Build the uvicorn configuration.

    Args:
        app: The FastAPI app.
        host: The address to bind.
        port: The port to bind.

    Returns:
        The configuration.
    """
    return uvicorn.Config(
        app,
        host=host,
        port=port,
        ws_max_size=MAX_WS_MESSAGE,
        # After the drain, only sockets Twilio has not closed are left.
        timeout_graceful_shutdown=int(END_GRACE) + 1,
        # No access log: a request line carries the caller's call SID.
        access_log=False,
        log_config=None,
    )


def main() -> None:
    """Run the app until it is stopped."""
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    app = build_app()
    port = int(os.environ.get("PORT", DEFAULT_PORT))
    RelayServer(server_config(app, "0.0.0.0", port), app.state.drain_calls).run()


if __name__ == "__main__":
    main()
