<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Agora voice agent</title>
  <style>
    body { font: 18px/1.5 system-ui, sans-serif; max-width: 36rem; margin: 12vh auto; padding: 1.5rem; color: #162238; background: #f5f8fc; }
    button { font: inherit; padding: .7rem 1.2rem; border-radius: .5rem; border: 1px solid #1765bc; background: white; margin: .4rem .4rem .4rem 0; cursor: pointer; }
    #start { background: #1765bc; color: white; }
    button:disabled { opacity: .45; cursor: default; }
    #status { min-height: 3rem; }
  </style>
  <script defer src="https://cdn.jsdelivr.net/npm/agora-rtc-sdk-ng@4.24.8/AgoraRTC_N-production.js"></script>
  <script defer src="/client.js"></script>
</head>
<body>
  <h1>Agora voice agent</h1>
  <p>Allow microphone access, then speak to the agent. Headphones help keep the conversation clear.</p>
  <button id="start">Start conversation</button><button id="stop" disabled>End conversation</button>
  <p id="status" role="status" aria-live="polite">Ready when you are.</p>
</body>
</html>
