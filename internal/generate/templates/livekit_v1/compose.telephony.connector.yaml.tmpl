# Generated local-development topology for the LiveKit Twilio connector. The
# devkey/secret pair is the documented `livekit-server --dev` pair (never for
# production). No Redis and no SIP: the one application container runs both the
# agent worker and the Twilio media bridge, talking to a local LiveKit Server.
services:
  application:
    build:
      context: .
    stop_grace_period: "{{.DrainTimeoutSecs}}s"
    # Two roles in one container for local dev: the LiveKit worker plus the
    # Twilio bridge web server the carrier reaches. Split them in production.
    command: ["sh", "-c", "python agent.py start & exec python telephony_bridge.py"]
    environment:
      - LIVEKIT_URL=ws://livekit_server:7880
      - LIVEKIT_API_KEY=devkey
      - LIVEKIT_API_SECRET=secret
{{- range .RequiredEnv}}
{{- if and (ne . "LIVEKIT_URL") (ne . "LIVEKIT_API_KEY") (ne . "LIVEKIT_API_SECRET")}}
      - {{.}}
{{- end}}
{{- end}}
{{- range .DevOptionalEnv}}
      # optional: set by `unmute dev --var`; absent otherwise
      - {{.}}
{{- end}}
    ports:
      - "${UNMUTE_TELEPHONY_PORT:-7860}:7860"
    depends_on:
      livekit_server:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7860/', timeout=2)"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 15s

  livekit_server:
    image: livekit/livekit-server:v1.13.4
    # Single-node dev server, internal to the Compose network: the bridge and
    # the worker connect out to it, so it needs no published or public ports.
    command: ["--dev", "--bind", "0.0.0.0"]
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:7880/"]
      interval: 2s
      timeout: 3s
      retries: 30
