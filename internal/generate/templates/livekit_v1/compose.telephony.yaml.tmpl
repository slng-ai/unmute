# Generated local-development topology. The devkey/secret pair below is the
# documented `livekit-server --dev` pair (never for production); the dev server
# accepts no other key pair.
services:
  application:
    build:
      context: .
    stop_grace_period: "{{.DrainTimeoutSecs}}s"
    environment:
      - LIVEKIT_URL=ws://livekit_server:7880
      - LIVEKIT_API_KEY=devkey
      - LIVEKIT_API_SECRET=secret
{{- range .RequiredEnv}}
{{- if and (ne . "LIVEKIT_URL") (ne . "LIVEKIT_API_KEY") (ne . "LIVEKIT_API_SECRET") (ne . "REDIS_URL")}}
      - {{.}}
{{- end}}
{{- end}}
{{- range .DevOptionalEnv}}
      # optional: set by `unmute dev --var`; absent otherwise
      - {{.}}
{{- end}}
    ports:
      - "${UNMUTE_TELEPHONY_PORT:-8081}:8081"
    depends_on:
      livekit_server:
        condition: service_healthy
      livekit_sip:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/', timeout=2)"]
      interval: 2s
      timeout: 3s
      retries: 30
      start_period: 15s

  redis:
    # Valkey (BSD-3-Clause) is the coordination store: Redis images are
    # source-available (RSALv2/SSPLv1) since 7.4, not open source. The
    # service name and REDIS_URL keep the protocol's name.
    image: valkey/valkey:9.1.1-alpine
    command: ["valkey-server", "--appendonly", "yes"]
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 2s
      timeout: 3s
      retries: 30

  livekit_server:
    image: livekit/livekit-server:v1.13.4
    command: ["--dev", "--bind", "0.0.0.0", "--redis-host", "redis:6379"]
    ports:
      - "${UNMUTE_LIVEKIT_PORT:-7880}:7880"
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:7880/"]
      interval: 2s
      timeout: 3s
      retries: 30

  livekit_sip:
    image: livekit/sip:v1.7.0
    environment:
      SIP_CONFIG_BODY: |
        api_key: devkey
        api_secret: secret
        ws_url: ws://livekit_server:7880
        redis:
          address: redis:6379
        health_port: 8080
        sip_port: 5060
        rtp_port: ${UNMUTE_LIVEKIT_RTP_PORT_RANGE:-10000-10100}
        use_external_ip: true
        logging:
          level: debug
    ports:
      - "${UNMUTE_LIVEKIT_SIP_PORT:-5060}:5060/tcp"
      - "${UNMUTE_LIVEKIT_SIP_PORT:-5060}:5060/udp"
      - "${UNMUTE_LIVEKIT_RTP_PORT_RANGE:-10000-10100}:${UNMUTE_LIVEKIT_RTP_PORT_RANGE:-10000-10100}/udp"
    depends_on:
      redis:
        condition: service_healthy
      livekit_server:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "grep -q ':1F90 ' /proc/net/tcp"]
      interval: 2s
      timeout: 3s
      retries: 30

volumes:
  redis_data:
