[project]
name = "unmute-{{.Project}}"
version = "0.1.0"
description = "Generated LiveKit Agents project (unmute livekit driver)"
requires-python = ">=3.10"
dependencies = [
{{- range .Deps}}
    {{pyq .}},
{{- end}}
]

# The checkers are pinned, not floated. ruff 0.16 widened its default rule
# selection, so an unpinned `ruff check .` turned every ruff release into a
# failure of an unchanged generator. Bump deliberately, the way the compiler
# pins jsonschema-go.
[dependency-groups]
dev = [
    "ruff==0.15.7",
    "ty",
]
