# --- cold transfer destination -----------------------------------------------
# TransferSIPParticipant's transfer_to is a URI, not a bare number: it becomes
# the Refer-To of the outgoing SIP REFER. `tel:+E164` covers Twilio and Telnyx;
# a provider that needs its trunk host in the Refer-To (Plivo) takes the
# `sip:+E164@<trunk>` form, which a destination may already carry (SCHEMA N26).
def _refer_uri(destination: str) -> str:
    """The destination as a REFER URI, adding `tel:` only to a bare number."""
    if destination.startswith(("tel:", "sip:", "sips:")):
        return destination
    return "tel:" + destination

{{end}}
{{- if .HasWarmTransfer}}
# --- warm transfer destination -----------------------------------------------
# CreateSIPParticipant's sip_call_to takes a phone number or a SIP user and
# refuses a full URI, in those words: "SipCallTo should be a phone number or
# SIP user, not a full SIP URI". Measured on a live call 2026-08-20 against
# livekit-server v1.13.4, where a warm transfer failed with a 400 before it
# dialled anything.
#
# A destination is allowed to be the `sip:+E164@<host>` form, which Plivo
# documents as mandatory for its Refer-To, so the user part is what gets dialled
# and the host is the trunk's job: _sip_trunk() already carries it. The cold
# path takes the whole URI, because there the host belongs in the Refer-To.
def _sip_user(destination: str) -> str:
    """The destination as a number or SIP user, never a full URI."""
    if "@" in destination:
        destination = destination.rsplit("@", 1)[0]
    for scheme in ("sip:", "sips:", "tel:"):
        if destination.startswith(scheme):
            return destination[len(scheme):]
    return destination

{{end}}
{{- if and .Telephony (eq .Telephony.Transport "sip") (or .Telephony.HasOutbound .Telephony.HasWarm)}}
# --- dial-out trunk ----------------------------------------------------------
# The carrier's own trunk settings, sent inline with every dial. No stored
# LiveKit outbound trunk is used or needed: CreateSIPParticipant takes the
# configuration in its `trunk` field and WarmTransferTask takes the same object
# as `sip_connection`, so nothing has to be registered on the platform first.
# One function, every dial site, so a rotated credential cannot fix one path and
# break another. Verified against livekit-agents 1.6.9 on 2026-08-12.
def _sip_trunk() -> api.SIPOutboundConfig:
    """The carrier trunk configuration, read from the Connection's env names."""
    return api.SIPOutboundConfig(
        hostname=os.environ[{{pyq .Telephony.SIPAddressEnv}}],
        auth_username=os.environ[{{pyq .Telephony.SIPUsernameEnv}}],
        auth_password=os.environ[{{pyq .Telephony.SIPPasswordEnv}}],
    )


def _sip_number() -> str:
    """The number to call from. Required with an inline trunk, which carries no
    number list for the platform to default from."""
    return os.environ[{{pyq .Telephony.FromNumberEnv}}]

{{end}}
{{- if .HasWarmTransfer}}
# --- warm transfer briefing --------------------------------------------------
# The persona the briefing agent wears while it talks to the colleague, in place
# of the prebuilt's own. WarmTransferTask builds its instructions from a template
# with three slots: this persona, the caller transcript, and the authored extra.
# Only the persona is replaced. The platform still supplies the paragraph saying
# who is who, the transcript itself, the sentence naming the tool that joins the
# calls, and the instruction to open with a summary.
#
# Every paragraph below answers something observed on a live warm transfer on
# 2026-08-12, where the colleague answered and heard "hello, how can I help":
#   - open with the handover, because the prebuilt lets the human speak first and
#     never briefs unprompted, so the agent's first turn is a reply, and a reply
#     to "hello" is a greeting unless it is told otherwise;
#   - name the cue, because joining the calls is this agent's own tool call and
#     nothing else can trigger it, so the colleague has to be told what to say;
#   - say what to do with a thin transcript, because a model asked to summarise
#     nothing improvises a greeting;
#   - decline out loud, because nothing on the platform bounds the consultation
#     once the call is answered, and the caller is on hold for all of it.
#
# Verified against livekit-agents 1.6.9 on 2026-08-12
# (beta/workflows/warm_transfer.py: PERSONA, INSTRUCTIONS_TEMPLATE).
_BRIEFING_PERSONA = """\
# Identity

You are the assistant that took a caller's call. You are now on the phone to a colleague
you called for help with it. The caller is not on this line: they are on hold and cannot
hear any of this.

# Goal

Hand the caller over. Your first words are the handover, not a greeting. Do not say hello,
do not offer help, and never wait to be asked what the call is about. Say who is on hold,
what they want, and what was already tried or offered, then ask one question your colleague
can answer. A few sentences, no more.

Tell your colleague you will put the caller through as soon as they say they are ready.

If the conversation history below is empty, or has no words from the caller in it, say that
someone is on hold asking for a person, that you do not have their details yet, and ask
whether your colleague can take the call. Say exactly that. Never greet instead.

Your colleague may not be able to take it. If they say they cannot, if they go quiet, or if
the conversation moves on without an answer, decline the transfer and give their reason. Do
not leave the question open: the caller is holding for the whole of this conversation."""

{{end}}
