class {{.Class}}({{if $.IgnorePhrases}}IgnorePhrasesMixin, {{end}}Agent):
    def __init__(self{{if not $.SingleAgentMinimal}}, chat_ctx: NotGivenOr[llm.ChatContext] = NOT_GIVEN{{end}}{{if and .IsEntry (not $.SingleAgentMinimal)}}, initial: bool = False{{end}}) -> None:
