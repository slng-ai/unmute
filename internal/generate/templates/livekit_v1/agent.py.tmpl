    else:
        userdata.{{.Variable}} = value
{{- end}}
{{- range .Telephony.CallStart}}
    if {{pyq .Name}} in call_start:
        userdata.{{.Name}} = call_start[{{pyq .Name}}]
{{- end}}
    if missing:
        raise RuntimeError("Missing LiveKit SIP context fields: " + ", ".join(missing))


