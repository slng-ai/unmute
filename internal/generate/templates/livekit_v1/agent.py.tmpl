"""LiveKit voice agent, compiled by Unmute from this package's agent.yaml."""

load_dotenv()

# livekit-agents 1.8.8 takes HTTPS_PROXY or HTTP_PROXY for the worker's own
# connection to LIVEKIT_URL and ignores NO_PROXY (worker.py:363). A proxy that
# only tunnels HTTPS answers that request with 405, and the worker never
# registers. So a LiveKit host listed in NO_PROXY is reached directly. Anything
# else gets the value the SDK would have picked itself. proxy_bypass_environment
# is stdlib but has no typeshed stub, hence the ignore.
WORKER_PROXY = os.getenv("HTTPS_PROXY") or os.getenv("HTTP_PROXY")
if urllib.request.proxy_bypass_environment(urlparse(os.getenv("LIVEKIT_URL", "")).hostname or ""):  # ty: ignore[unresolved-attribute]
    WORKER_PROXY = None

{{- if .Telephony}}


def telephony_load(agent_server: AgentServer) -> float:
    """Report how full this worker is, so the platform stops routing to a full one.

    Args:
        agent_server: The server whose active jobs are counted.

    Returns:
        The load, from 0.0 (idle) to 1.0 (at MAX_SESSIONS).
    """
    return min(len(agent_server.active_jobs) / MAX_SESSIONS, 1.0)


server = AgentServer(
    port=int(os.getenv("UNMUTE_AGENT_HEALTH_PORT", DEFAULT_HEALTH_PORT)),
    drain_timeout={{.DrainTimeoutSecs}},
    load_threshold=1.0,
    http_proxy=WORKER_PROXY,
)
server.load_fnc = telephony_load
{{- else}}

server = AgentServer(http_proxy=WORKER_PROXY)
{{- end}}
server.setup_fnc = prewarm
if os.getenv({{pyq localRunEnv}}) == "1":
    # One browser call needs one warm spare, not one index build per CPU.
    server.update_options(num_idle_processes=1, initialize_process_timeout=LOCAL_INIT_TIMEOUT_SECS)


@server.rtc_session(agent_name={{pyq .AgentName}})
async def entrypoint(ctx: JobContext) -> None:
    """Run one call LiveKit dispatched to this worker.

    Args:
        ctx: The job LiveKit dispatched for this call.
    """
    await run_call(ctx)


# No __main__ block: this module is started through livekit-agents' supported
# CLI, `python -m livekit.agents start agent.py`, which imports it and finds the
# `server` above. The older per-script entry point goes through a CLI upstream
# has deprecated and will remove.

