{{- end}}
{{- range .Tools}}{{template "method_tool" .}}{{end}}
{{- if $.Capture}}{{template "capture_tool" $.Capture}}{{end}}
{{range .Transfers}}
    @function_tool(flags=llm.tool_context.ToolFlag.IGNORE_ON_ENTER)
