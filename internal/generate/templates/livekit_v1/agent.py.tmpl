# --- required MCP tool sources ----------------------------------------------
# LiveKit logs MCPToolset setup failures and still starts the AgentActivity.
# These sources are required by the package, so probe fresh instances before
# AgentSession.start; runtime agents/tasks get their own fresh instances below.
def _mcp_toolset(source: str) -> mcp.MCPToolset:
{{- range .MCPServers}}
    if source == {{pyq .Name}}:
        return {{template "mcp_constructor" .}}
{{- end}}
    raise ValueError(f"Unknown MCP tool source: {source}")


async def _preflight_mcp() -> None:
    async def probe(source: str):
        try:
            toolset = _mcp_toolset(source)
        except BaseException as error:
            return error, None

        setup_error = None
        try:
            await toolset.setup()
        except BaseException as error:
            setup_error = error

        close_error = None
        try:
            await toolset.aclose()
        except BaseException as error:
            close_error = error
        return setup_error, close_error

    sources = ({{range $i, $s := .MCPServers}}{{if $i}}, {{end}}{{pyq $s.Name}}{{end}},)
    results = await asyncio.gather(
        *(probe(source) for source in sources),
        return_exceptions=True,
    )
    setup_failures = []
    close_failures = []
    for source, result in zip(sources, results):
        if isinstance(result, BaseException):
            setup_failures.append((source, result))
            continue
        setup_error, close_error = result
        if setup_error is not None:
            setup_failures.append((source, setup_error))
        if close_error is not None:
            close_failures.append((source, close_error))

    failures = [
        *(("setup", source, error) for source, error in setup_failures),
        *(("cleanup", source, error) for source, error in close_failures),
    ]
    if failures:
        _, _, selected = failures[0]
        for stage, source, error in failures[1:]:
            logger.error(
                "MCP preflight %s failed for %s",
                stage,
                source,
                exc_info=(type(error), error, error.__traceback__),
            )
        raise selected


{{- end}}
