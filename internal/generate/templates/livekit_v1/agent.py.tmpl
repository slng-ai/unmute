# --- context shaping ---------------------------------------------------------
{{- if .NeedsLastN}}
def _last_n(source: llm.ChatContext, n: int, *, exclude_function_call: bool = False) -> llm.ChatContext:
    """history: last_n — the newest n items; truncate() keeps call/output pairs."""
    ctx = source.copy(exclude_instructions=True, exclude_function_call=exclude_function_call, exclude_handoff=True)
    ctx.truncate(max_items=n)
    return ctx
{{end}}
{{- if .NeedsSummarize}}
async def _summarize(source: llm.ChatContext, summarizer: llm.LLM) -> llm.ChatContext:
    """history: summary — one summarizer turn replaces the running transcript."""
    transcript = "\n".join(
        f"{m.role}: {m.text_content}" for m in source.messages() if m.text_content
    )
    prompt = llm.ChatContext()
    prompt.add_message(
        role="system",
        content="Summarize this conversation for the agent taking over. Keep names, facts, and open commitments. Reply with the summary only.",
    )
    prompt.add_message(role="user", content=transcript)
    parts: list[str] = []
    async with summarizer.chat(chat_ctx=prompt) as stream:
        async for chunk in stream:
            if chunk.delta and chunk.delta.content:
                parts.append(chunk.delta.content)
    out = llm.ChatContext()
    out.add_message(role="assistant", content="Summary of the conversation so far: " + "".join(parts))
    return out
{{end}}
