{{define "sttexpr"}}{{if .Chain}}stt.FallbackAdapter(stt=[{{template "svc" .Primary.Call}}{{range .Chain}}, {{template "svc" .Call}}{{end}}]){{else}}{{template "svc" .Primary.Call}}{{end}}{{end -}}
{{- /* webhook_tool renders one webhook tool as a @function_tool method;
agents and tasks share the shape (T15). */ -}}
{{define "webhook_tool"}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext{{range .Args}}, {{.Name}}: {{.Anno}}{{end}}) -> dict:
        {{triple .Description}}
        async with httpx.AsyncClient() as client:
            resp = await client.post(
                os.environ[{{pyq .URLEnv}}],
                json={ {{- range $i, $a := .Args}}{{if $i}}, {{end}}{{pyq $a.Name}}: {{$a.Name}}{{end -}} },
            )
            resp.raise_for_status()
{{- if .EndsConversation}}
            self.session.shutdown()  # effect: ends_conversation
{{- end}}
            return resp.json()
{{end -}}
{{- /* local_tool calls the handler copied from the source package (SCHEMA §5:
the file defines a callable named like the tool; sync or async). */ -}}
{{define "local_tool"}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext{{range .Args}}, {{.Name}}: {{.Anno}}{{end}}) -> dict:
        {{triple .Description}}
        result = tools.{{.Method}}.{{.Method}}({{range $i, $a := .Args}}{{if $i}}, {{end}}{{$a.Name}}={{$a.Name}}{{end}})
        if inspect.isawaitable(result):
            result = await result
{{- if .EndsConversation}}
        self.session.shutdown()  # effect: ends_conversation
{{- end}}
        return result
{{end -}}
{{- /* method_tool dispatches on execution. */ -}}
{{define "method_tool"}}{{if .Local}}{{template "local_tool" .}}{{else}}{{template "webhook_tool" .}}{{end}}{{end -}}
{{- /* prebuilt_list renders execution: builtin tools as SDK helper instances
spread into the tools= kwarg (docs/spec/prebuilt-tools.md). */ -}}
{{define "prebuilt_list"}}{{range $i, $p := .}}{{if $i}}, {{end}}{{if eq $p.Builtin "end_call"}}*EndCallTool(extra_description={{pyq $p.Description}}{{if $p.Instructions}}, end_instructions={{pyq $p.Instructions}}{{end}}).tools{{end}}{{end}}{{end -}}
{{- /* mcp_mounts renders an agent's/task's MCP servers (B3): one server per
url_env, allowed_tools keeping D8 visibility. */ -}}
{{define "mcp_mounts"}}mcp_servers=[{{range $i, $s := .}}{{if $i}}, {{end}}mcp.MCPServerHTTP(url=os.environ[{{pyq $s.URLEnv}}], allowed_tools=[{{range $j, $t := $s.Tools}}{{if $j}}, {{end}}{{pyq $t}}{{end}}]){{end}}]{{end -}}
