{{- range .HumanTransfers}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext) -> str:
        {{triple .When}}
        # One line per firing, so a live test can see which control the model
        # picked and when — the transfer that ran is otherwise invisible in the
        # logs until the carrier request goes out.
        logger.info("human transfer fired: {{.Method}} ({{if .Warm}}warm{{else}}cold{{end}})")
{{- if .Warm}}
        # warm: the prebuilt holds the caller with music, dials the person,
        # briefs them from the chat context, then merges the calls. Beta on
        # Python. Every unavailable case (no answer, decline, voicemail, failed
        # dial) arrives as one ToolError, with the caller already restored.
        #
        # The tool speaks its own line before the hold (V4/B4): the caller
        # hears the handoff start instead of sudden hold music.
        await ctx.session.say(
            "One moment while I bring a colleague on the line.", allow_interruptions=False
        )
        try:
            result = await WarmTransferTask(
                sip_call_to={{.ToExpr}},
                chat_ctx=self.chat_ctx,
{{- if .Briefing}}
                extra_instructions={{pyq .Briefing}},
{{- end}}
{{- if .RingTimeout}}
                ringing_timeout={{.RingTimeout}},
{{- end}}
            )
        except ToolError as error:
{{- if .Hangup}}
            # on_unavailable: hangup
            await ctx.session.generate_reply(
                instructions="Tell the caller nobody is available and say goodbye."
            )
            ctx.session.shutdown()
            return f"Nobody took the transfer ({error}); the call was ended."
{{- else}}
            # on_unavailable: return_to_caller
            return f"Nobody took the transfer ({error}). Tell the caller and keep helping them."
{{- end}}
        await ctx.session.say(
            "You are on the line with my colleague now. I will leave you to it.",
            allow_interruptions=False,
        )
        # The room outlives this session (delete_room_on_close=False), so the
        # caller and the person stay connected after the agent shuts down.
        ctx.session.shutdown()
        return "The caller is now connected to " + result.human_agent_identity + "."
{{- else}}
        # cold: SIP REFER through the job context. The caller leaves the room.
        job_ctx = get_job_context()
        # Pick the SIP caller by kind: identities are assigned at dispatch, and a
        # room can hold more than one participant.
        caller = next(
            (
                participant
                for participant in job_ctx.room.remote_participants.values()
                if participant.kind == rtc.ParticipantKind.PARTICIPANT_KIND_SIP
            ),
            None,
        )
        if caller is None:
            return "There is no phone caller to transfer."
        # The tool speaks the announcement itself (V4/B4): leaving it to the
        # prompt lets a model say "putting you through" and never call this,
        # which a caller cannot tell apart from a transfer that failed.
        await ctx.session.say(
            "Putting you through now, one moment.", allow_interruptions=False
        )
        request = api.TransferSIPParticipantRequest(
            room_name=job_ctx.room.name,
            participant_identity=caller.identity,
            transfer_to={{.ToExpr}},
            play_dialtone=True,
        )
{{- if .RingTimeout}}
        request.ringing_timeout.FromNanoseconds(int({{.RingTimeout}} * 1e9))
{{- end}}
        try:
            await job_ctx.api.sip.transfer_sip_participant(request)
        except (api.SipCallError, api.ServerError) as error:
{{- if .Hangup}}
            # on_unavailable: hangup
            await ctx.session.generate_reply(
                instructions="Tell the caller the transfer failed and say goodbye."
            )
            ctx.session.shutdown()
            return f"The transfer failed ({error}); the call was ended."
{{- else}}
            # on_unavailable: return_to_caller — the caller is still in the room.
            return f"The transfer failed ({error}). Tell the caller and keep helping them."
{{- end}}
        return "The caller was transferred."
{{- end}}
{{end}}
{{- range .Delegates}}
{{- if .Task}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext) -> dict:
        {{triple .When}}
{{- if .Task.Summary}}
        summary_ctx = await _summarize(self.chat_ctx, {{template "llmexpr" .Task.Summary}})
        result = await {{.Task.Class}}(chat_ctx=summary_ctx)
{{- else if .Task.CtxExpr}}
        result = await {{.Task.Class}}(chat_ctx={{.Task.CtxExpr}})
{{- else}}
        result = await {{.Task.Class}}()  # history: reset — the task starts fresh
{{- end}}
{{- range .Task.Assign}}
        ctx.userdata.{{.Var}} = result[{{pyq .Field}}]
{{- end}}
        # C4/N13: the task's turns are not propagated back; the typed result is
        # the only return.
        return result
{{- else if .Isolated}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext){{if eq .Then "return"}} -> dict{{end}}:
        {{triple .When}}
        # context_scope: isolated — each step is a standalone AgentTask starting
        # fresh (C3/C4); the grouped form always shares context, so it is not used.
        task_results: dict = {}
{{- range .Steps}}
        task_results[{{pyq .ID}}] = await {{.Class}}()
{{- end}}
{{- if eq .Then "return"}}
        # N13: standalone tasks never merge their turns back; hand the owner the
        # typed results only (merge: results).
        return task_results
{{- else if eq .Then "transfer"}}
        # then: transfer — control moves on and does not return here.
        return {{.ThenClass}}(chat_ctx=self.chat_ctx.copy(exclude_instructions=True, exclude_handoff=True))
{{- else}}
        # then: end — the flow is the last thing on the call; this does not return.
        self.session.shutdown()
{{- end}}
{{- else}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext){{if eq .Then "return"}} -> dict{{end}}:
        {{triple .When}}
        group = TaskGroup(
            chat_ctx=self.chat_ctx.copy(exclude_instructions=True, exclude_handoff=True),
            summarize_chat_ctx=False,
        )
{{- range .Steps}}
        group.add(
            lambda: {{.Class}}(chat_ctx=self.chat_ctx.copy(exclude_instructions=True, exclude_handoff=True)),
            id={{pyq .ID}},
            description={{pyq .Desc}},
        )
{{- end}}
{{- if eq .Then "return"}}
        owner_ctx = self.chat_ctx.copy()
        result = await group
        # N13: the flow's own turns must not land in the owner's context. The
        # TaskGroup merges them back on completion, so restore the pre-flow
        # context and hand the owner only the typed results (merge: results).
        await self.update_chat_ctx(owner_ctx)
        return result.task_results
{{- else if eq .Then "transfer"}}
        owner_ctx = self.chat_ctx.copy(exclude_instructions=True, exclude_handoff=True)
        await group
        # then: transfer — control moves on and does not return here. N13: drop
        # the flow's turns by handing the target the pre-flow context.
        return {{.ThenClass}}(chat_ctx=owner_ctx)
{{- else}}
        await group
        # then: end — the flow is the last thing on the call; this does not return.
        self.session.shutdown()
{{- end}}
{{- end}}
{{end}}
{{end}}
{{- if .NeedsTasks}}
# --- tasks -----------------------------------------------------------------
{{range .Tasks}}
class {{.Class}}({{if $.IgnorePhrases}}IgnorePhrasesMixin, {{end}}AgentTask[dict]):
    def __init__(self, chat_ctx: NotGivenOr[llm.ChatContext] = NOT_GIVEN) -> None:
        super().__init__(instructions={{.PromptConst}}, chat_ctx=chat_ctx{{if .LLM}}, llm={{template "llmexpr" .LLM}}{{end}}{{if .MCPServers}}, {{template "mcp_mounts" .MCPServers}}{{end}}{{if .Prebuilt}}, tools=[{{template "prebuilt_list" .Prebuilt}}]{{end}})

    async def on_enter(self) -> None:
{{- if .PromptExpr}}
        await self.update_instructions({{.PromptExpr}})
{{- end}}
        # The task's own instructions describe this step; let them drive the opening.
        self.session.generate_reply()
{{range .Tools}}{{template "method_tool" .}}{{end}}
{{- if $.Capture}}{{template "capture_tool" $.Capture}}{{end}}
    @function_tool
    async def finish(self, ctx: RunContext{{range .Result}}, {{.Name}}: {{.Anno}}{{end}}) -> None:
        """Record the result of this step and finish. complete() is the sole
        resolution; do not relay anything after it."""
        self.complete({ {{- range $i, $r := .Result}}{{if $i}}, {{end}}{{pyq $r.Name}}: {{$r.Name}}{{end -}} })
{{end}}
{{- end}}

# --- session ---------------------------------------------------------------
def prewarm(proc: JobProcess) -> None:
    proc.userdata["vad"] = silero.VAD.load()


{{- if .Telephony}}
MAX_SESSIONS = {{.MaxSessions}}


def telephony_load(agent_server: AgentServer) -> float:
    return min(len(agent_server.active_jobs) / MAX_SESSIONS, 1.0)


server = AgentServer(
    port=int(os.getenv("UNMUTE_AGENT_HEALTH_PORT", "8081")),
    drain_timeout={{.DrainTimeoutSecs}},
    load_threshold=1.0,
)
server.load_fnc = telephony_load
{{- else}}
server = AgentServer()
{{- end}}
server.setup_fnc = prewarm


@server.rtc_session(agent_name={{pyq .AgentName}})
async def entrypoint(ctx: JobContext) -> None:
{{- if .RequiredSecrets}}
    require_env()
{{- end}}
    session = AgentSession{{if .HasVars}}[Userdata]{{end}}(
{{- if .HasVars}}
        userdata=Userdata(),
{{- end}}
        stt={{template "sttexpr" .STT}},
        llm={{template "llmexpr" .SessionLLM}},
        tts={{template "svc" .SessionTTS.Call}},
{{- if .Interruption}}
        turn_handling=TurnHandlingOptions(
            turn_detection=inference.TurnDetector({{if .TurnVersion}}version={{pyq .TurnVersion}}{{end}}),
            interruption={"enabled": {{if .Interruption.Enabled}}True{{else}}False{{end}}{{if .Interruption.MinWords}}, "min_words": {{.Interruption.MinWords}}{{end}}},
            preemptive_generation={"enabled": True},
        ),
{{- else}}
        turn_handling=TurnHandlingOptions(
            turn_detection=inference.TurnDetector({{if .TurnVersion}}version={{pyq .TurnVersion}}{{end}}),
            preemptive_generation={"enabled": True},
        ),
{{- end}}
        vad=ctx.proc.userdata["vad"],
{{- if or .InactivityNudgeSecs .InactivityEndSecs}}
        user_away_timeout={{if .InactivityNudgeSecs}}{{.InactivityNudgeSecs}}{{else}}{{.InactivityEndSecs}}{{end}},
{{- end}}
    )

{{if .Tracing}}
    setup_langfuse(
        ctx,
        session,
        metadata={
            "langfuse.session.id": ctx.room.name,
            "langfuse.trace.name": {{pyq .EntryAgent}} + "-" + {{pyq .Project}},
        },
    )

{{end}}
    @session.on("metrics_collected")
    def _on_metrics_collected(ev: MetricsCollectedEvent) -> None:
        metrics.log_metrics(ev.metrics)

{{- if or .InactivityNudgeSecs .InactivityEndSecs}}
{{- if and .InactivityNudgeSecs .InactivityEndSecs}}

    async def _end_if_still_away() -> None:
        await asyncio.sleep({{.InactivityEndDeltaSecs}})  # inactivity.end_after
        if session.user_state == "away":
            session.shutdown()
{{- end}}

    @session.on("user_state_changed")
    def _on_user_state_changed(ev) -> None:
        if ev.new_state != "away":
            return
{{- if .InactivityNudgeSecs}}
        session.generate_reply(
            instructions="The caller went quiet. Briefly check whether they are still there."
        )
{{- if .InactivityEndSecs}}
        asyncio.create_task(_end_if_still_away())
{{- end}}
{{- else}}
        session.shutdown()  # inactivity.end_after with no nudge
{{- end}}
{{- end}}
{{if .Telephony}}
{{- if eq .Telephony.Transport "connector"}}
    await ctx.connect()
    # The Twilio bridge placed or answered the call, joined this room with the
    # caller's audio, and dispatched this job. Direction (inbound or outbound)
    # is already resolved by the bridge, so the agent just runs the session.
    # Wait for the bridge participant so the caller audio track exists first.
    await ctx.wait_for_participant()
{{- if .HasVars}}
    metadata = _livekit_job_metadata(ctx.job.metadata)
    call_context = _livekit_call_context(ctx.room.name, metadata)
    _hydrate_livekit_context(session.userdata, call_context)
{{- if .CallStartVars}}
    _hydrate_call_start(session.userdata, _dispatched_call_start(metadata))
{{- end}}
{{- end}}
    await session.start(agent={{.EntryClass}}(), room=ctx.room{{if .HasWarmTransfer}}, room_options=room_io.RoomOptions(delete_room_on_close=False){{end}})
    await _livekit_entry_greeting(session)
{{- else}}
    metadata = _livekit_job_metadata(ctx.job.metadata)
{{- if .CallStartVars}}
    call_start = _dispatched_call_start(metadata)
{{- end}}
    outbound_job = "phone_number" in metadata
{{- if .Outbound}}
    phone_number = metadata.get("phone_number")
{{- end}}
    await ctx.connect()

    if outbound_job:
{{- if .Outbound}}
        if (
            not isinstance(phone_number, str)
            or not phone_number.startswith("+")
            or not phone_number[1:].isdigit()
            or not 8 <= len(phone_number) <= 16
        ):
            raise RuntimeError("phone_number must be an E.164 number")
        await session.start(agent={{.EntryClass}}(), room=ctx.room{{if .HasWarmTransfer}}, room_options=room_io.RoomOptions(delete_room_on_close=False){{end}})
        if not session.room_io:
            raise RuntimeError("session room_io is unavailable")
        session.room_io.set_participant("phone_user")
        async with AMD(session, participant_identity="phone_user") as detector:
            await ctx.api.sip.create_sip_participant(
                api.CreateSIPParticipantRequest(
                    room_name=ctx.room.name,
                    sip_trunk_id=os.environ["LIVEKIT_SIP_OUTBOUND_TRUNK"],
                    sip_call_to=phone_number,
                    participant_identity="phone_user",
                    wait_until_answered=True,
                )
            )
            {{if .HasVars}}participant = {{end}}await ctx.wait_for_participant(identity="phone_user")
            amd_result = await detector.execute()
{{- else}}
        raise RuntimeError("this LiveKit SIP route does not accept outbound jobs")
{{- end}}
    else:
{{- if .Telephony.HasInbound}}
        {{if .HasVars}}participant = {{end}}await ctx.wait_for_participant()
{{- else}}
        raise RuntimeError("outbound LiveKit SIP job metadata requires phone_number")
{{- end}}

{{- if .HasVars}}
    _hydrate_livekit_context(session.userdata, call_context)
{{- if .CallStartVars}}
    _hydrate_call_start(session.userdata, call_start)
{{- end}}
{{- end}}
    if not outbound_job:
        await session.start(agent={{.EntryClass}}(), room=ctx.room{{if .HasWarmTransfer}}, room_options=room_io.RoomOptions(delete_room_on_close=False){{end}})
{{- if .Outbound}}
    else:
        if amd_result.category == "machine-vm":
{{- if .Outbound.LeaveMessage}}
            handle = session.generate_reply(
                instructions="You reached voicemail. Leave a brief message and say you will call back."
            )
            await handle.wait_for_playout()
            ctx.shutdown("voicemail: left a message")  # on_voicemail: leave_message
{{- else}}
            ctx.shutdown("voicemail detected")  # on_voicemail: hangup
{{- end}}
            return
        if amd_result.category == "machine-unavailable":
            ctx.shutdown("mailbox unavailable")
            return
{{- end}}
    await _livekit_entry_greeting(session)
{{- end}}
{{- else}}
{{- if .CallStartVars}}
    # Input variables land before the session starts, so the greeting and the
    # prompts already see them (I.dispatch).
    _hydrate_call_start(session.userdata, _dispatched_call_start(_livekit_job_metadata(ctx.job.metadata)))
{{- end}}
    await session.start(agent={{.EntryClass}}(), room=ctx.room{{if .HasWarmTransfer}}, room_options=room_io.RoomOptions(delete_room_on_close=False){{end}})
    await ctx.connect()
{{- if .Outbound}}

    # channels.telephony outbound: a job dispatched with {"phone_number": ...}
    # metadata dials out; AMD classifies who answered (playout stays locked
    # until the verdict, so the greeting waits for a human).
    phone_number = None
    if ctx.job.metadata:
        phone_number = json.loads(ctx.job.metadata).get("phone_number")
    if phone_number:
        if not session.room_io:
            raise RuntimeError("session room_io is unavailable")
        session.room_io.set_participant("phone_user")
        async with AMD(session, participant_identity="phone_user") as detector:
            await ctx.api.sip.create_sip_participant(
                api.CreateSIPParticipantRequest(
                    room_name=ctx.room.name,
                    sip_trunk_id=os.environ["LIVEKIT_SIP_OUTBOUND_TRUNK"],
                    sip_call_to=phone_number,
                    participant_identity="phone_user",
                    wait_until_answered=True,
                )
            )
            await ctx.wait_for_participant(identity="phone_user")
            result = await detector.execute()
        if result.category == "machine-vm":
{{- if .Outbound.LeaveMessage}}
            handle = session.generate_reply(
                instructions="You reached voicemail. Leave a brief message and say you will call back."
            )
            await handle.wait_for_playout()
            ctx.shutdown("voicemail: left a message")  # on_voicemail: leave_message
{{- else}}
            ctx.shutdown("voicemail detected")  # on_voicemail: hangup
{{- end}}
        elif result.category == "machine-unavailable":
            ctx.shutdown("mailbox unavailable")
{{- end}}
{{- end}}
{{- if .MaxDurationSecs}}

    async def _max_duration() -> None:
        await asyncio.sleep({{.MaxDurationSecs}})
        session.shutdown()  # conversation.max_duration

    asyncio.create_task(_max_duration())
{{- end}}
{{- if .ThinkingAudio}}

    background_audio = BackgroundAudioPlayer(
        thinking_sound=BuiltinAudioClip.KEYBOARD_TYPING,  # thinking_audio: subtle
    )
    await background_audio.start(room=ctx.room, agent_session=session)
{{- end}}


if __name__ == "__main__":
    cli.run_app(server)
