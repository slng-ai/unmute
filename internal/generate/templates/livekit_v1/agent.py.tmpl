{{- /* svc renders any resolved ServiceCall inline (session/agent kwargs).
Classes, kwargs, and model-route forms come from the provider catalogue
(internal/target/catalog_livekit.go). */ -}}
{{define "svc"}}{{.Class}}({{range $i, $a := .Args}}{{if $i}}, {{end}}{{$a.Key}}={{$a.Value}}{{end}}){{end -}}
import logging
import os
{{if .NeedsHTTPX}}import httpx
{{end}}from dotenv import load_dotenv
from livekit.agents import (
    NOT_GIVEN,
    Agent,
{{- if .NeedsTasks}}
    AgentTask,
{{- end}}
    AgentServer,
    AgentSession,
    JobContext,
    JobProcess,
    NotGivenOr,
    RunContext,
    TurnHandlingOptions,
    cli,
    function_tool,
    inference,
    llm,
    metrics,
)
{{- if .NeedsTasks}}
from livekit.agents.beta.workflows import TaskGroup
{{- end}}
from livekit.agents.voice import MetricsCollectedEvent
from livekit.plugins import {{join .PluginModules ", "}}

logger = logging.getLogger({{pyq .Project}})
logger.setLevel(logging.INFO)

load_dotenv(".env.local")


# --- prompts ---------------------------------------------------------------
{{range .Prompts}}
{{.Const}} = {{triple .Body}}
{{end}}
# --- agents ----------------------------------------------------------------
{{range .Agents}}
class {{.Class}}(Agent):
    def __init__(self, chat_ctx: NotGivenOr[llm.ChatContext] = NOT_GIVEN) -> None:
        super().__init__(
            instructions={{.PromptConst}},
            chat_ctx=chat_ctx,
{{- if .LLM}}
            llm={{template "svc" .LLM.Call}},
{{- end}}
{{- if .TTS}}
            tts={{template "svc" .TTS.Call}},
{{- end}}
        )

    async def on_enter(self) -> None:
{{- if .Greeting}}
{{- if .Greeting.Say}}
        await self.session.say({{pyq .Greeting.Say}})
{{- else if .Greeting.RunLLM}}
        self.session.generate_reply(instructions="Greet the caller and offer to help.")
{{- else}}
        pass  # the caller speaks first
{{- end}}
{{- else}}
        self.session.generate_reply(
            instructions="You are now handling this. Continue in one short line; do not greet again."
        )
{{- end}}
{{range .Transfers}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext):
        {{triple .When}}
        return {{.TargetClass}}(chat_ctx=self.chat_ctx.copy(exclude_instructions=True))
{{end}}
{{- range .Delegates}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext) -> str:
        {{triple .When}}
        group = TaskGroup(
            chat_ctx=self.chat_ctx.copy(exclude_instructions=True),
            summarize_chat_ctx={{if .SummarizeChatCtx}}True{{else}}False{{end}},
        )
{{- range .Steps}}
        group.add(
            lambda: {{.Class}}(chat_ctx=self.chat_ctx.copy(exclude_instructions=True)),
            id={{pyq .ID}},
            description={{pyq .Desc}},
        )
{{- end}}
        await group
        return {{pyq .Cue}}
{{end}}
{{end}}
{{- if .NeedsTasks}}
# --- tasks -----------------------------------------------------------------
{{range .Tasks}}
class {{.Class}}(AgentTask[dict]):
    def __init__(self, chat_ctx: NotGivenOr[llm.ChatContext] = NOT_GIVEN) -> None:
        super().__init__(instructions={{.PromptConst}}, chat_ctx=chat_ctx)

    async def on_enter(self) -> None:
        self.session.generate_reply(instructions="Begin this step.")
{{range .Tools}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext{{range .Args}}, {{.Name}}: {{.PyType}}{{end}}) -> dict:
        {{triple .Description}}
        async with httpx.AsyncClient() as client:
            resp = await client.post(
                os.environ[{{pyq .URLEnv}}],
                json={ {{- range $i, $a := .Args}}{{if $i}}, {{end}}{{pyq $a.Name}}: {{$a.Name}}{{end -}} },
            )
            resp.raise_for_status()
            return resp.json()
{{end}}
    @function_tool
    async def finish(self, ctx: RunContext{{range .Result}}, {{.Name}}: {{.PyType}}{{end}}) -> str:
        """Record the result of this step and finish."""
        self.complete({ {{- range $i, $r := .Result}}{{if $i}}, {{end}}{{pyq $r.Name}}: {{$r.Name}}{{end -}} })
        return "Done."
{{end}}
{{- end}}

# --- session ---------------------------------------------------------------
def prewarm(proc: JobProcess) -> None:
    proc.userdata["vad"] = silero.VAD.load()


server = AgentServer()
server.setup_fnc = prewarm


@server.rtc_session(agent_name={{pyq .AgentName}})
async def entrypoint(ctx: JobContext) -> None:
    session = AgentSession(
        stt={{template "svc" .STT.Call}},
        llm={{template "svc" .SessionLLM.Call}},
        tts={{template "svc" .SessionTTS.Call}},
        turn_handling=TurnHandlingOptions(turn_detection=inference.TurnDetector(version={{pyq .TurnVersion}})),
        vad=ctx.proc.userdata["vad"],
        preemptive_generation=True,
    )

    @session.on("metrics_collected")
    def _on_metrics_collected(ev: MetricsCollectedEvent) -> None:
        metrics.log_metrics(ev.metrics)

    await session.start(agent={{.EntryClass}}(), room=ctx.room)
    await ctx.connect()


if __name__ == "__main__":
    cli.run_app(server)
