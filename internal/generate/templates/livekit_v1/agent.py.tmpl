{{- /* svc renders any resolved ServiceCall inline (session/agent kwargs).
Classes, kwargs, and model-route forms come from the provider catalogue
(internal/target/catalog_livekit.go). */ -}}
{{define "svc"}}{{.Class}}({{range $i, $a := .Args}}{{if $i}}, {{end}}{{$a.Key}}={{$a.Value}}{{end}}){{end -}}
{{- /* llmexpr renders a reason profile: bare service, or the native
llm.FallbackAdapter around its fallback chain (V4). */ -}}
{{define "llmexpr"}}{{if .Chain}}llm.FallbackAdapter(llm=[{{template "svc" .Primary.Call}}{{range .Chain}}, {{template "svc" .Call}}{{end}}]){{else}}{{template "svc" .Primary.Call}}{{end}}{{end -}}
{{- /* webhook_tool renders one webhook tool as a @function_tool method;
agents and tasks share the shape (T15). */ -}}
{{define "webhook_tool"}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext{{range .Args}}, {{.Name}}: {{.PyType}}{{end}}) -> dict:
        {{triple .Description}}
        async with httpx.AsyncClient() as client:
            resp = await client.post(
                os.environ[{{pyq .URLEnv}}],
                json={ {{- range $i, $a := .Args}}{{if $i}}, {{end}}{{pyq $a.Name}}: {{$a.Name}}{{end -}} },
            )
            resp.raise_for_status()
{{- if .EndsConversation}}
            self.session.shutdown()  # effect: ends_conversation
{{- end}}
            return resp.json()
{{end -}}
