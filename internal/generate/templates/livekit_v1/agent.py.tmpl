{{- range .Tools}}{{template "method_tool" .}}{{end}}
{{range .Transfers}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext):
        {{triple .When}}
{{- if .Requires}}
        missing = [n for n, v in ({{range .Requires}}({{pyq .}}, ctx.userdata.{{.}}), {{end}}) if v is None]
        if missing:
            # requires guard (machine-checked): refuse and name the unmet variables.
            return "Cannot transfer yet; missing required information: " + ", ".join(missing)
{{- end}}
{{- range .ResetVars}}
        ctx.userdata.{{.Name}} = {{.Default}}  # context.variables: not carried on this transfer
{{- end}}
{{- if .Summary}}
        summary_ctx = await _summarize(self.chat_ctx, {{template "llmexpr" .Summary}})
        return {{.TargetClass}}(chat_ctx=summary_ctx)
{{- else if .CtxExpr}}
        return {{.TargetClass}}(chat_ctx={{.CtxExpr}})
{{- else}}
        # history: reset — the target starts fresh (a handoff marker still lands).
        return {{.TargetClass}}()
{{- end}}
{{end}}
{{- range .HumanTransfers}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext) -> str:
        {{triple .When}}
{{- if .Warm}}
        # mode: warm — the prebuilt consultation flow briefs the human agent
        # (briefing: summary) before connecting the caller. Beta on Python.
        result = await WarmTransferTask(sip_call_to={{pyq .To}})
        return "The caller is now connected to " + result.human_agent_identity + "."
{{- else}}
        # mode: cold — SIP REFER through the job context.
        job_ctx = get_job_context()
        identity = next(iter(job_ctx.room.remote_participants))
        await job_ctx.transfer_sip_participant(identity, {{pyq .To}}, play_dialtone=True)
        return "The caller was transferred."
{{- end}}
{{end}}
{{- range .Delegates}}
{{- if .Task}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext) -> dict:
        {{triple .When}}
{{- if .Task.Summary}}
        summary_ctx = await _summarize(self.chat_ctx, {{template "llmexpr" .Task.Summary}})
        result = await {{.Task.Class}}(chat_ctx=summary_ctx)
{{- else if .Task.CtxExpr}}
        result = await {{.Task.Class}}(chat_ctx={{.Task.CtxExpr}})
{{- else}}
        result = await {{.Task.Class}}()  # history: reset — the task starts fresh
{{- end}}
{{- range .Task.Assign}}
        ctx.userdata.{{.Var}} = result[{{pyq .Field}}]
{{- end}}
        # C4/N13: the task's turns are not propagated back; the typed result is
        # the only return.
        return result
{{- else if .Isolated}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext){{if eq .Then "return"}} -> dict{{end}}:
        {{triple .When}}
        # context_scope: isolated — each step is a standalone AgentTask starting
        # fresh (C3/C4); the grouped form always shares context, so it is not used.
        task_results: dict = {}
{{- range .Steps}}
        task_results[{{pyq .ID}}] = await {{.Class}}()
{{- end}}
{{- if eq .Then "return"}}
        # N13: standalone tasks never merge their turns back; hand the owner the
        # typed results only (merge: results).
        return task_results
{{- else if eq .Then "transfer"}}
        # then: transfer — control moves on and does not return here.
        return {{.ThenClass}}(chat_ctx=self.chat_ctx.copy(exclude_instructions=True, exclude_handoff=True))
{{- else}}
        # then: end — the flow is the last thing on the call; this does not return.
        self.session.shutdown()
{{- end}}
{{- else}}
    @function_tool
    async def {{.Method}}(self, ctx: RunContext){{if eq .Then "return"}} -> dict{{end}}:
        {{triple .When}}
        group = TaskGroup(
            chat_ctx=self.chat_ctx.copy(exclude_instructions=True, exclude_handoff=True),
            summarize_chat_ctx=False,
        )
{{- range .Steps}}
        group.add(
            lambda: {{.Class}}(chat_ctx=self.chat_ctx.copy(exclude_instructions=True, exclude_handoff=True)),
            id={{pyq .ID}},
            description={{pyq .Desc}},
        )
{{- end}}
{{- if eq .Then "return"}}
        owner_ctx = self.chat_ctx.copy()
        result = await group
        # N13: the flow's own turns must not land in the owner's context. The
        # TaskGroup merges them back on completion, so restore the pre-flow
        # context and hand the owner only the typed results (merge: results).
        await self.update_chat_ctx(owner_ctx)
        return result.task_results
{{- else if eq .Then "transfer"}}
        owner_ctx = self.chat_ctx.copy(exclude_instructions=True, exclude_handoff=True)
        await group
        # then: transfer — control moves on and does not return here. N13: drop
        # the flow's turns by handing the target the pre-flow context.
        return {{.ThenClass}}(chat_ctx=owner_ctx)
{{- else}}
        await group
        # then: end — the flow is the last thing on the call; this does not return.
        self.session.shutdown()
{{- end}}
{{- end}}
{{end}}
{{end}}
