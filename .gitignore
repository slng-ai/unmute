.env
.env.local
voice-agent-prompting/
my-test-agent/
.firecrawl/

# Compiled target projects (reproducible via `unmute compile`; goldens are the tracked form)
examples/*/build/

# Release artifacts: GoReleaser writes every build, archive, checksum and SBOM here
dist/

# Local GitHub Spec Kit work. Codex copies it into new managed worktrees via
# .worktreeinclude, but each checkout owns its copy after that.
/specs/

# Legacy single-file working spec.
/SPEC.md

# The maintainer's release runbook: a local working note, deliberately not
# committed. The facts it depends on stay in the repo either way, in
# .goreleaser.yaml, .github/workflows/release.yml and
# release configuration. Nothing tracked may link to it.
/RELEASING.md

__pycache__/
.codex/worktrees/
.firecrawl
bin/

# macOS Finder metadata
.DS_Store

# Python bytecode (emitted projects, smoke-test venvs)
*.pyc
.claude/worktrees/
